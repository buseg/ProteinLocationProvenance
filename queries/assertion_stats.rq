# Per-assertion support in SPARQL (cross-check of locx/analysis/support.py): claims and papers from the run graph,
# author groups from the support graph, years from the papers graph. %RUN_GRAPH% = the extraction run's graph.
PREFIX locx:     <http://example.org/locx/>
PREFIX prov:     <http://www.w3.org/ns/prov#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
SELECT ?a ?verdict
       (COUNT(DISTINCT ?m) AS ?n_claims)
       (COUNT(DISTINCT ?paper) AS ?n_papers)
       (COUNT(DISTINCT ?group) AS ?n_groups)
       (MIN(?year) AS ?year_first) (MAX(?year) AS ?year_last)
WHERE {
  GRAPH <%RUN_GRAPH%>             { ?m locx:asserts ?a ; locx:valid true ; prov:wasDerivedFrom ?paper . }
  GRAPH <urn:locx:graph:verdicts> { ?vd locx:about ?a ; locx:outcome ?verdict . }
  GRAPH <urn:locx:graph:support>  { ?group a locx:AuthorGroup ; locx:about ?a ; locx:includesPaper ?paper . }
  OPTIONAL { GRAPH <urn:locx:graph:papers> { ?paper dcterms:date ?date . } BIND (YEAR(?date) AS ?year) }
}
GROUP BY ?a ?verdict
