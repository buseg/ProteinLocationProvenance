# Demo / grouping toggle: the GO slim terms (goslim_agr, GO Consortium) above each given GO term (is_a / part_of,
#   any depth, the term itself included). A term can belong to several slim terms; terms with none get no row.
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo:      <http://purl.obolibrary.org/obo/>
PREFIX oboInOwl: <http://www.geneontology.org/formats/oboInOwl#>
SELECT DISTINCT ?term ?slim ?slimLabel
WHERE {
  VALUES ?term { %TERMS% }
  GRAPH <urn:locx:graph:go> {
    ?term (rdfs:subClassOf|rdfs:subClassOf/owl:someValuesFrom)* ?slim .
    ?slim oboInOwl:inSubset <http://purl.obolibrary.org/obo/go#goslim_agr> ; rdfs:label ?slimLabel .
  }
}
