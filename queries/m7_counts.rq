# M7 sanity (run by `make load`): claims, valid claims, assertions, papers in the loaded graphs.
PREFIX locx:  <http://example.org/locx/>
PREFIX fabio: <http://purl.org/spar/fabio/>
SELECT ?claims ?valid_claims ?assertions ?papers
WHERE {
  { SELECT (COUNT(?c) AS ?claims) (SUM(IF(?v, 1, 0)) AS ?valid_claims)
    WHERE { GRAPH <%RUN_GRAPH%> { ?c a locx:Claim ; locx:valid ?v } } }
  { SELECT (COUNT(?a) AS ?assertions)
    WHERE { GRAPH <urn:locx:graph:assertions> { ?a a locx:Assertion } } }
  { SELECT (COUNT(?p) AS ?papers)
    WHERE { GRAPH <urn:locx:graph:papers> { ?p a fabio:JournalArticle } } }
}
