# Demo / Conflicts: assertions whose verdict is Conflicting, with the GOA rows behind it (relation and evidence as RO
# and ECO labels, from the official releases)
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX locx:     <http://example.org/locx/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX up:       <http://purl.uniprot.org/core/>
SELECT ?a ?symbol ?label ?polarity ?nGroups ?nPapers ?context
       (GROUP_CONCAT(DISTINCT CONCAT(IF(?gpol = locx:Absent, "NOT ", ""), ?q, " ", ?glabel, " [", ?ev, "]"); separator="; ") AS ?goa)
WHERE {
  GRAPH <urn:locx:graph:verdicts>  { ?vd locx:about ?a ; locx:outcome locx:Conflicting ; locx:goaMatch ?g . }
  GRAPH <urn:locx:graph:support>   { ?sp locx:about ?a ; locx:nGroups ?nGroups ; locx:nPapers ?nPapers ; locx:contextDependent ?context . }
  GRAPH <urn:locx:graph:assertions> { ?a locx:protein ?protein ; locx:location/rdf:type ?term ; locx:polarity ?polarity . }
  { SELECT ?protein (MIN(?s) AS ?symbol) WHERE {   # gene symbol (UniProt: up:encodedBy -> skos:prefLabel)
      GRAPH <urn:locx:graph:uniprot-human> { ?protein up:encodedBy/skos:prefLabel ?s . } } GROUP BY ?protein }
  GRAPH <urn:locx:graph:go>        { ?term rdfs:label ?label . }
  GRAPH <urn:locx:graph:goa-human> { ?g locx:polarity ?gpol ; locx:relation ?rel ; locx:evidence/rdf:type ?eco ; locx:location/rdf:type ?gt . }
  GRAPH <urn:locx:graph:ro>        { ?rel rdfs:label ?q . }
  GRAPH <urn:locx:graph:eco>       { ?eco rdfs:label ?ev . }
  GRAPH <urn:locx:graph:go>        { ?gt rdfs:label ?glabel . }
}
GROUP BY ?a ?symbol ?label ?polarity ?nGroups ?nPapers ?context
ORDER BY DESC(?nGroups) DESC(?nPapers) ?symbol
