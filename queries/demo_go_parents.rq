# Demo / Graph neighborhood: direct is_a / part_of parents of a set of GO terms (%TERMS% = VALUES list of GO IRIs)
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?child ?relation ?parent ?parentLabel
WHERE {
  VALUES ?child { %TERMS% }
  GRAPH <urn:locx:graph:go-cc> {
    { ?child rdfs:subClassOf ?parent . BIND("is_a" AS ?relation) }
    UNION
    { ?child obo:BFO_0000050 ?parent . BIND("part_of" AS ?relation) }
    ?parent rdfs:label ?parentLabel .
  }
}
