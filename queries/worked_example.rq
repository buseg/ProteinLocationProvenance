# M10: one worked example — the paper side (sentence, title, year, journal) and the GOA rows behind
# the verdict (evidence code, qualifier, NOT, source). %MENTION%, %ASSERTION%, %RUN_GRAPH% are filled in.
PREFIX locx:    <http://example.org/locx/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?sentence ?title ?year ?journal ?goaLabel ?evidence ?qualifier ?negated ?source
WHERE {
  GRAPH <%RUN_GRAPH%>             { <%MENTION%> locx:sentenceText ?sentence ; prov:wasDerivedFrom ?paper . }
  GRAPH <urn:locx:graph:papers>   { ?paper dcterms:title ?title .
                                    OPTIONAL { ?paper locx:year ?year } OPTIONAL { ?paper locx:journal ?journal } }
  OPTIONAL {
    GRAPH <urn:locx:graph:verdicts>  { <%ASSERTION%> locx:goaMatch ?g . }
    GRAPH <urn:locx:graph:goa-human> { ?g locx:location ?gl ; locx:evidenceCode ?evidence ;
                                          locx:qualifier ?qualifier ; locx:negated ?negated .
                                       OPTIONAL { ?g dcterms:source ?source } }
    GRAPH <urn:locx:graph:go-cc>     { ?gl rdfs:label ?goaLabel . }
  }
}
