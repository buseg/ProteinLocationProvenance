# Demo / Errors: invalid claims per flag (a claim can have several flags); ?flag = the flag's token (used as the
# page's identifier), ?label = its label (locx ontology)
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX locx:     <http://example.org/locx/>
SELECT ?flag ?label (COUNT(DISTINCT ?m) AS ?mentions)
WHERE { GRAPH <%RUN_GRAPH%> { ?m locx:valid false ; locx:flag ?f . }
        GRAPH <urn:locx:graph:ontology> { ?f locx:token ?flag ; rdfs:label ?label } }
GROUP BY ?flag ?label
ORDER BY DESC(?mentions)
