# Demo / Protein explorer: proteins that have at least one assertion (for the picker)
PREFIX locx:    <http://example.org/locx/>
PREFIX up:      <http://purl.uniprot.org/core/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
SELECT ?protein ?symbol ?name (COUNT(?a) AS ?assertions)
WHERE {
  GRAPH <urn:locx:graph:assertions>    { ?a locx:protein ?protein . }
  { SELECT ?protein (MIN(?s) AS ?symbol) WHERE {   # gene symbol (UniProt: up:encodedBy -> skos:prefLabel)
      GRAPH <urn:locx:graph:uniprot-human> { ?protein up:encodedBy/skos:prefLabel ?s . } } GROUP BY ?protein }
  OPTIONAL { GRAPH <urn:locx:graph:uniprot-human> { ?protein up:recommendedName/up:fullName ?name } }
}
GROUP BY ?protein ?symbol ?name
ORDER BY DESC(?assertions) ?symbol
