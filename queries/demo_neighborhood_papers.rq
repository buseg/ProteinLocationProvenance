# Demo / Graph neighborhood: papers behind the valid claims of one protein (%PROTEIN% = UniProt IRI)
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX locx:     <http://example.org/locx/>
PREFIX prov:     <http://www.w3.org/ns/prov#>
PREFIX dcterms:  <http://purl.org/dc/terms/>
PREFIX c4o:      <http://purl.org/spar/c4o/>
SELECT DISTINCT ?a ?term ?paper ?title ?year ?citations
WHERE {
  GRAPH <urn:locx:graph:assertions> { ?a locx:protein <%PROTEIN%> ; locx:location/rdf:type ?term . }
  GRAPH <%RUN_GRAPH%>               { ?m locx:asserts ?a ; locx:valid true ; prov:wasDerivedFrom ?paper . }
  GRAPH <urn:locx:graph:papers>     { ?paper dcterms:title ?title . OPTIONAL { ?paper dcterms:date ?date } BIND (YEAR(?date) AS ?year) OPTIONAL { ?paper c4o:hasGlobalCitationFrequency/c4o:hasGlobalCountValue ?citations } }
}
