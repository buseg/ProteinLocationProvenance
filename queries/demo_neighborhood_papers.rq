# Demo / Graph neighborhood: papers behind the valid literature claims of one protein (%PROTEIN% = UniProt IRI)
PREFIX locx:    <http://example.org/locx/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?a ?term ?paper ?title ?year ?citations
WHERE {
  GRAPH <urn:locx:graph:assertions> { ?a locx:protein <%PROTEIN%> ; locx:location ?term . }
  GRAPH <%RUN_GRAPH%>               { ?m locx:asserts ?a ; locx:valid true ; prov:wasDerivedFrom ?paper . }
  GRAPH <urn:locx:graph:papers>     { ?paper dcterms:title ?title .
                                      OPTIONAL { ?paper locx:year ?year } OPTIONAL { ?paper locx:citedByCount ?citations } }
}
