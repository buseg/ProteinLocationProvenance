# Report: GOA cellular component terms of one protein (%PROTEIN%), ECO evidence labels, any NOT (ND skipped)
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX locx:     <http://example.org/locx/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo:      <http://purl.obolibrary.org/obo/>
SELECT ?label (GROUP_CONCAT(DISTINCT ?ev; separator=", ") AS ?evidence) (MAX(?neg) AS ?anyNot)
WHERE {
  GRAPH <urn:locx:graph:goa-human> { ?g locx:protein <%PROTEIN%> ; locx:location/rdf:type ?t ; locx:evidence/rdf:type ?eco ; locx:polarity ?pol . }
  FILTER NOT EXISTS { GRAPH <urn:locx:graph:eco> { ?eco obo:ECO_9000002 "ND" } }
  GRAPH <urn:locx:graph:eco> { ?eco rdfs:label ?ev . }
  GRAPH <urn:locx:graph:go> { ?t rdfs:label ?label . }
  BIND (?pol = locx:Absent AS ?neg)
}
GROUP BY ?label
ORDER BY ?label
