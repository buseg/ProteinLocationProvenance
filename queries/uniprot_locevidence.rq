# UniProt SPARQL endpoint (sparql.uniprot.org), run by locx/fetch/uniprot_rdf.py per batch of proteins
# (%PROTEINS% = protein IRIs). Evidence behind each location component: ECO code and source (UniProt reifies the triple;\n# a PubMed citation links to its PubMed IRI with foaf:primaryTopicOf).
# One simple pattern per query: the endpoint answers these in < 1 s, a UNION of them times out.
PREFIX up:   <http://purl.uniprot.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

CONSTRUCT { ?st a rdf:Statement ; rdf:subject ?loc ; rdf:predicate up:cellularComponent ; rdf:object ?term ; up:attribution ?att .
            ?att up:evidence ?eco ; up:source ?src . ?src foaf:primaryTopicOf ?pubmed . }
WHERE { VALUES ?p { %PROTEINS% } ?p up:annotation ?ann . ?ann a up:Subcellular_Location_Annotation ; up:locatedIn ?loc .
        ?loc up:cellularComponent ?term .
        ?st rdf:subject ?loc ; rdf:predicate up:cellularComponent ; rdf:object ?term ; up:attribution ?att .
        OPTIONAL { ?att up:evidence ?eco } OPTIONAL { ?att up:source ?src . OPTIONAL { ?src foaf:primaryTopicOf ?pubmed } } }
