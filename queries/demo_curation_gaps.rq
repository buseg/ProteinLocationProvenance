# Demo / Curation gaps: novel and refinement assertions supported by >= %MIN_GROUPS% independent author groups
PREFIX locx:    <http://example.org/locx/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
SELECT ?a ?symbol ?label ?polarity ?verdict ?nGroups ?nFinding ?nPapers ?yearFirst ?yearLast ?context
WHERE {
  GRAPH <urn:locx:graph:verdicts> {
    ?a locx:verdict ?verdict ; locx:nGroups ?nGroups ; locx:nPapersFinding ?nFinding ; locx:nPapers ?nPapers .
    FILTER (?verdict IN (locx:Novel, locx:Refinement) && ?nGroups >= %MIN_GROUPS%)
    OPTIONAL { ?a locx:yearFirst ?yearFirst ; locx:yearLast ?yearLast }
    OPTIONAL { ?a locx:contextDependent ?context }
  }
  GRAPH <urn:locx:graph:assertions>    { ?a locx:protein ?protein ; locx:location ?term ; locx:polarity ?polarity . }
  GRAPH <urn:locx:graph:uniprot-human> { ?protein locx:geneSymbol ?symbol . }
  GRAPH <urn:locx:graph:go-cc>         { ?term rdfs:label ?label . }
}
ORDER BY DESC(?nGroups) DESC(?nFinding) DESC(?nPapers) ?symbol
LIMIT 300
