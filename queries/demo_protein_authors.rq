# Demo / Network: authors of the papers behind one protein's valid claims, with their identity (?key)
PREFIX locx:     <http://example.org/locx/>
PREFIX prov:     <http://www.w3.org/ns/prov#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
SELECT ?paper ?position ?name ?person ?orcid (MIN(?k) AS ?key)
WHERE {
  GRAPH <urn:locx:graph:assertions> { ?a locx:protein <%PROTEIN%> . }
  GRAPH <%RUN_GRAPH%>               { ?m locx:asserts ?a ; locx:valid true ; prov:wasDerivedFrom ?paper . }
  GRAPH <urn:locx:graph:papers> { ?paper locx:hasAuthorship ?s . ?s locx:position ?position ; locx:authorName ?name .
                                  OPTIONAL { ?s locx:author ?person . OPTIONAL { ?person locx:orcid ?orcid } } }
  # one identity per person: the OpenAlex author, or the smallest IRI the reasoner merged it with (shared ORCID);
  # authors OpenAlex could not identify fall back to their printed name
  OPTIONAL { GRAPH <urn:locx:graph:papers> { ?s locx:author ?p1 } GRAPH <urn:locx:graph:inferred> { ?p1 owl:sameAs ?same } }
  BIND (IF(BOUND(?person), IF(BOUND(?same) && STR(?same) < STR(?person), STR(?same), STR(?person)),
           CONCAT("name:", STR(?name))) AS ?k)
}
GROUP BY ?paper ?position ?name ?person ?orcid
ORDER BY ?paper ?position
