# Demo / Overview: provenance of the extraction run (PROV-O activity and agent)
PREFIX locx:    <http://example.org/locx/>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
SELECT ?run ?label ?started ?ended ?promptVersion ?promptSha ?schema ?temperature ?model ?servedBy
WHERE {
  GRAPH <%RUN_GRAPH%> {
    ?run a prov:Activity ; rdfs:label ?label ; prov:startedAtTime ?started ;
         locx:promptVersion ?promptVersion ; locx:promptSha256 ?promptSha ;
         locx:schemaVersion ?schema ; locx:temperature ?temperature ;
         prov:wasAssociatedWith ?agent .
    OPTIONAL { ?run prov:endedAtTime ?ended }
    ?agent rdfs:label ?model ; locx:servedBy ?servedBy .
  }
}
