# Demo / abstract view: the full text the LLM read for one paper (PubTator title + abstract, a fabio:Abstract that is
#   part of the paper) and its metadata (%PAPER% = PubMed IRI). The demo highlights the claim's sentence inside it.
PREFIX frbr:    <http://purl.org/vocab/frbr/core#>
PREFIX prism:   <http://prismstandard.org/namespaces/basic/2.0/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX c4o:     <http://purl.org/spar/c4o/>
SELECT ?abstract ?title ?year ?journal ?doi
WHERE {
  GRAPH <urn:locx:graph:abstracts> { ?ab frbr:partOf <%PAPER%> ; c4o:hasContent ?abstract . }
  GRAPH <urn:locx:graph:papers>    { <%PAPER%> dcterms:title ?title .
                                     OPTIONAL { <%PAPER%> dcterms:date ?date } BIND (YEAR(?date) AS ?year)
                                     OPTIONAL { <%PAPER%> frbr:partOf/dcterms:title ?journal }
                                     OPTIONAL { <%PAPER%> prism:doi ?doi } }
}
