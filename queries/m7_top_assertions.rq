# M7 sanity: assertions supported by the most distinct papers (gene symbol and GO label shown)
PREFIX locx: <http://example.org/locx/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?symbol ?location ?polarity (COUNT(DISTINCT ?paper) AS ?papers)
WHERE {
  GRAPH <%RUN_GRAPH%>               { ?m locx:asserts ?a ; prov:wasDerivedFrom ?paper . }
  GRAPH <urn:locx:graph:assertions>  { ?a locx:protein ?prot ; locx:location ?loc ; locx:polarity ?polarity . }
  GRAPH <urn:locx:graph:uniprot-human> { ?prot locx:geneSymbol ?symbol . }
  GRAPH <urn:locx:graph:go-cc>       { ?loc rdfs:label ?location . }
}
GROUP BY ?symbol ?location ?polarity
ORDER BY DESC(?papers)
LIMIT 10
