# Demo / Protein page: map GO terms to coarse compartments (is_a / part_of ancestors). %TERMS% = GO IRIs,
# %BUCKETS% = (GO IRI, expected label) pairs; the app checks each returned label against the expected one.
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo:     <http://purl.obolibrary.org/obo/>
SELECT ?term ?bucket ?bucketLabel
WHERE {
  VALUES ?term { %TERMS% }
  VALUES ?bucket { %BUCKETS% }
  GRAPH <urn:locx:graph:go-cc> {
    ?term (rdfs:subClassOf|obo:BFO_0000050)* ?bucket .
    ?bucket rdfs:label ?bucketLabel .
  }
}
