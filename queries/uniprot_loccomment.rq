# UniProt SPARQL endpoint (sparql.uniprot.org), run by locx/fetch/uniprot_rdf.py per batch of proteins
# (%PROTEINS% = protein IRIs). Subcellular location annotation and its free-text comment.
# One simple pattern per query: the endpoint answers these in < 1 s, a UNION of them times out.
PREFIX up:   <http://purl.uniprot.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

CONSTRUCT { ?p up:annotation ?ann . ?ann a up:Subcellular_Location_Annotation ; rdfs:comment ?comment . }
WHERE { VALUES ?p { %PROTEINS% } ?p up:annotation ?ann . ?ann a up:Subcellular_Location_Annotation . OPTIONAL { ?ann rdfs:comment ?comment } }
