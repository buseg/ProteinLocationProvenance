# locx gate shapes (SPEC M7): the final papers + run + assertions graphs must conform before loading.
# Validated by locx/kg/claims_rdf.py together with the GO CC and UniProt graphs (for the class checks).

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio:   <http://purl.org/spar/fabio/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix locx:    <http://example.org/locx/> .

locx:gatePrefixes
    sh:declare [ sh:prefix "locx" ; sh:namespace "http://example.org/locx/"^^xsd:anyURI ] ,
               [ sh:prefix "obo"  ; sh:namespace "http://purl.obolibrary.org/obo/"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

# --- Mention: one paper saying something, with provenance -------------------------------------
locx:MentionShape
    a sh:NodeShape ;
    sh:targetClass locx:Mention ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fabio:JournalArticle ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class prov:Activity ] ;
    sh:property [ sh:path locx:sentenceText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path locx:sentenceId ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^S[0-9]+$" ] ;
    sh:property [ sh:path locx:polarity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( locx:Present locx:Absent ) ] ;
    sh:property [ sh:path locx:certainty ; sh:maxCount 1 ; sh:in ( locx:Stated locx:Hedged ) ] ;
    sh:property [ sh:path locx:sourceType ; sh:maxCount 1 ; sh:in ( locx:Finding locx:Background ) ] ;
    sh:property [ sh:path locx:valid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path locx:asserts ; sh:maxCount 1 ; sh:class locx:Assertion ] ;
    sh:property [ sh:path locx:protein ; sh:minCount 1 ; sh:maxCount 1 ; sh:class locx:Protein ] ;
    sh:property [ sh:path locx:location ; sh:maxCount 1 ; sh:class owl:Class ] ;
    # only valid mentions assert, and an asserting mention carries the same content as its assertion
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes locx:gatePrefixes ;
        sh:message "An invalid mention asserts, or a mention disagrees with its assertion" ;
        sh:select """
            SELECT $this WHERE {
                $this locx:asserts ?a .
                { $this locx:valid false }
                UNION { $this locx:protein ?p . FILTER NOT EXISTS { ?a locx:protein ?p } }
                UNION { $this locx:location ?l . FILTER NOT EXISTS { ?a locx:location ?l } }
                UNION { $this locx:polarity ?x . FILTER NOT EXISTS { ?a locx:polarity ?x } }
            }
        """ ;
    ] .

# --- Assertion: the content, stored once ------------------------------------------------------
locx:AssertionShape
    a sh:NodeShape ;
    sh:targetClass locx:Assertion ;
    sh:property [ sh:path locx:protein ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:pattern "^http://purl.uniprot.org/uniprot/" ; sh:class locx:Protein ] ;
    sh:property [ sh:path locx:location ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                  sh:pattern "^http://purl.obolibrary.org/obo/GO_" ; sh:class owl:Class ] ;
    sh:property [ sh:path locx:polarity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( locx:Present locx:Absent ) ] ;
    # every assertion is backed by at least one valid mention
    sh:property [ sh:path [ sh:inversePath locx:asserts ] ; sh:minCount 1 ] ;
    # V5 again, as a gate: no assertion may sit in a non-human compartment
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes locx:gatePrefixes ;
        sh:message "Assertion location {?loc} lies under a non-human compartment" ;
        sh:select """
            SELECT $this ?loc WHERE {
                $this locx:location ?loc .
                ?loc (rdfs:subClassOf|obo:BFO_0000050)* ?root .
                FILTER (?root IN (obo:GO_0009536, obo:GO_0005618, obo:GO_0009579, obo:GO_0042597))
            }
        """ ;
    ] .

# --- Paper and run ---------------------------------------------------------------------------
locx:PaperShape
    a sh:NodeShape ;
    sh:targetClass fabio:JournalArticle ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path locx:year ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path locx:tier ; sh:minCount 1 ; sh:in ( "dev" "silver" "discovery" ) ] .

locx:AuthorshipShape
    a sh:NodeShape ;
    sh:targetClass locx:Authorship ;
    sh:property [ sh:path locx:author ; sh:minCount 1 ; sh:maxCount 1 ; sh:class foaf:Person ] ;
    sh:property [ sh:path locx:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

locx:RunShape
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:class prov:SoftwareAgent ] ;
    sh:property [ sh:path prov:startedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path locx:promptSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] .
