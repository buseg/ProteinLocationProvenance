<http://example.org/locx/sentence/19556463/S5/position> a oa:TextPositionSelector ;
    oa:end 521 ;
    oa:start 375 .

<http://example.org/locx/sentence/19556463/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Under aberrant lysosomal storage conditions, TFEB translocated from the cytoplasm to the nucleus, resulting in the activation of its target genes." .

<http://example.org/locx/sentence/21617040/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/21617040/S6/position>,
        <http://example.org/locx/sentence/21617040/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/21617040> .

<http://example.org/locx/sentence/21617040/S6/position> a oa:TextPositionSelector ;
    oa:end 810 ;
    oa:start 604 .

<http://example.org/locx/sentence/21617040/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear localization and activity of TFEB were regulated by serine phosphorylation mediated by the extracellular signal-regulated kinase 2, whose activity was tuned by the levels of extracellular nutrients." .

<http://example.org/locx/sentence/22343943/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22343943/S4/position>,
        <http://example.org/locx/sentence/22343943/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22343943> .

<http://example.org/locx/sentence/22343943/S4/position> a oa:TextPositionSelector ;
    oa:end 511 ;
    oa:start 321 .

<http://example.org/locx/sentence/22343943/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we show that the Transcription Factor EB (TFEB), a master regulator of lysosomal biogenesis, colocalizes with master growth regulator mTOR complex 1 (mTORC1) on the lysosomal membrane." .

<http://example.org/locx/sentence/22343943/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22343943/S6/position>,
        <http://example.org/locx/sentence/22343943/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22343943> .

<http://example.org/locx/sentence/22343943/S6/position> a oa:TextPositionSelector ;
    oa:end 750 ;
    oa:start 598 .

<http://example.org/locx/sentence/22343943/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Conversely, pharmacological inhibition of mTORC1, as well as starvation and lysosomal disruption, activates TFEB by promoting its nuclear translocation." .

<http://example.org/locx/sentence/22343943/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22343943/S8/position>,
        <http://example.org/locx/sentence/22343943/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22343943> .

<http://example.org/locx/sentence/22343943/S8/position> a oa:TextPositionSelector ;
    oa:end 1133 ;
    oa:start 931 .

<http://example.org/locx/sentence/22343943/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Interestingly, the Rag GTPase complex, which senses lysosomal amino acids and activates mTORC1, is both necessary and sufficient to regulate starvation- and stress-induced nuclear translocation of TFEB." .

<http://example.org/locx/sentence/22576015/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22576015/S1/position>,
        <http://example.org/locx/sentence/22576015/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22576015> .

<http://example.org/locx/sentence/22576015/S1/position> a oa:TextPositionSelector ;
    oa:end 101 ;
    oa:start 0 .

<http://example.org/locx/sentence/22576015/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "MTORC1 functions as a transcriptional regulator of autophagy by preventing nuclear transport of TFEB." .

<http://example.org/locx/sentence/22576015/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22576015/S7/position>,
        <http://example.org/locx/sentence/22576015/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22576015> .

<http://example.org/locx/sentence/22576015/S7/position> a oa:TextPositionSelector ;
    oa:end 1061 ;
    oa:start 901 .

<http://example.org/locx/sentence/22576015/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This phosphorylation promotes association of TFEB with members of the YWHA (14-3-3) family of proteins and retention of the transcription factor in the cytosol." .

<http://example.org/locx/sentence/22576015/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22576015/S8/position>,
        <http://example.org/locx/sentence/22576015/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22576015> .

<http://example.org/locx/sentence/22576015/S8/position> a oa:TextPositionSelector ;
    oa:end 1296 ;
    oa:start 1062 .

<http://example.org/locx/sentence/22576015/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Pharmacological or genetic inhibition of MTORC1 causes dissociation of the TFEB/YWHA complex and rapid transport of TFEB to the nucleus where it increases transcription of multiple genes implicated in autophagy and lysosomal function." .

<http://example.org/locx/sentence/22576015/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22576015/S9/position>,
        <http://example.org/locx/sentence/22576015/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22576015> .

<http://example.org/locx/sentence/22576015/S9/position> a oa:TextPositionSelector ;
    oa:end 1421 ;
    oa:start 1297 .

<http://example.org/locx/sentence/22576015/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Active TFEB also associates with late endosomal/lysosomal membranes through interaction with the LAMTOR/RRAG/MTORC1 complex." .

<http://example.org/locx/sentence/22692423/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22692423/S5/position>,
        <http://example.org/locx/sentence/22692423/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22692423> .

<http://example.org/locx/sentence/22692423/S5/position> a oa:TextPositionSelector ;
    oa:end 763 ;
    oa:start 556 .

<http://example.org/locx/sentence/22692423/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "When lysosomal activity was adequate, mTOR-dependent phosphorylation of TFEB on Ser(211) triggered the binding of 14-3-3 proteins to TFEB, resulting in retention of the transcription factor in the cytoplasm." .

<http://example.org/locx/sentence/22692423/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/22692423/S6/position>,
        <http://example.org/locx/sentence/22692423/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/22692423> .

<http://example.org/locx/sentence/22692423/S6/position> a oa:TextPositionSelector ;
    oa:end 1031 ;
    oa:start 764 .

<http://example.org/locx/sentence/22692423/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Inhibition of lysosomal function reduced the mTOR-dependent phosphorylation of TFEB, resulting in diminished interactions between TFEB and 14-3-3 proteins and the translocation of TFEB into the nucleus, where it could stimulate genes involved in lysosomal biogenesis." .

<http://example.org/locx/sentence/23401004/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/23401004/S1/position>,
        <http://example.org/locx/sentence/23401004/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/23401004> .

<http://example.org/locx/sentence/23401004/S1/position> a oa:TextPositionSelector ;
    oa:end 83 ;
    oa:start 0 .

<http://example.org/locx/sentence/23401004/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Rag GTPases mediate amino acid-dependent recruitment of TFEB and MITF to lysosomes." .

<http://example.org/locx/sentence/23401004/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/23401004/S5/position>,
        <http://example.org/locx/sentence/23401004/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/23401004> .

<http://example.org/locx/sentence/23401004/S5/position> a oa:TextPositionSelector ;
    oa:end 669 ;
    oa:start 510 .

<http://example.org/locx/sentence/23401004/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Interaction of TFEB with active Rag heterodimers promoted recruitment of TFEB to lysosomes, leading to mTORC1-dependent phosphorylation and inhibition of TFEB." .

<http://example.org/locx/sentence/23401004/S7/position> a oa:TextPositionSelector ;
    oa:end 953 ;
    oa:start 788 .

<http://example.org/locx/sentence/23401004/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Depletion or inactivation of Rags prevented recruitment of TFEB to lysosomes, whereas expression of active Rags induced association of TFEB with lysosomal membranes." .

<http://example.org/locx/sentence/24081491/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/24081491/S3/position>,
        <http://example.org/locx/sentence/24081491/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/24081491> .

<http://example.org/locx/sentence/24081491/S3/position> a oa:TextPositionSelector ;
    oa:end 557 ;
    oa:start 382 .

<http://example.org/locx/sentence/24081491/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "In this study, we show that FLCN regulates lysosome function by promoting the mTORC1-dependent phosphorylation and cytoplasmic sequestration of transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/25066864/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25066864/S10/position>,
        <http://example.org/locx/sentence/25066864/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25066864> .

<http://example.org/locx/sentence/25066864/S10/position> a oa:TextPositionSelector ;
    oa:end 1051 ;
    oa:start 970 .

<http://example.org/locx/sentence/25066864/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "TMEM106B loss-of-function delays TFEB translocation after Torin-1-induced stress." .

<http://example.org/locx/sentence/25066864/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25066864/S9/position>,
        <http://example.org/locx/sentence/25066864/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25066864> .

<http://example.org/locx/sentence/25066864/S9/position> a oa:TextPositionSelector ;
    oa:end 969 ;
    oa:start 817 .

<http://example.org/locx/sentence/25066864/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "TMEM106B overexpression alters lysosomal stress signaling, causing a translocation of the mTOR-sensitive transcription factor, TFEB, to neuronal nuclei." .

<http://example.org/locx/sentence/25544758/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25544758/S6/position>,
        <http://example.org/locx/sentence/25544758/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25544758> .

<http://example.org/locx/sentence/25544758/S6/position> a oa:TextPositionSelector ;
    oa:end 1084 ;
    oa:start 808 .

<http://example.org/locx/sentence/25544758/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Non-cytotoxic, nanomolar concentrations, of the hydrophobic weak base chemotherapeutics doxorubicin and mitoxantrone triggered rapid lysosomal biogenesis that was associated with nuclear translocation of TFEB, the dominant transcription factor regulating lysosomal biogenesis." .

<http://example.org/locx/sentence/25561726/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25561726/S11/position>,
        <http://example.org/locx/sentence/25561726/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25561726> .

<http://example.org/locx/sentence/25561726/S11/position> a oa:TextPositionSelector ;
    oa:end 1853 ;
    oa:start 1629 .

<http://example.org/locx/sentence/25561726/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Finally, a predominant nuclear localization of TFEB is unveiled in fully fed pancreatic cancer cells, whereas a reduction in TFEB expression significantly impairs their capacity for growth in an anchorage-independent manner." .

<http://example.org/locx/sentence/25561726/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25561726/S7/position>,
        <http://example.org/locx/sentence/25561726/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25561726> .

<http://example.org/locx/sentence/25561726/S7/position> a oa:TextPositionSelector ;
    oa:end 1104 ;
    oa:start 901 .

<http://example.org/locx/sentence/25561726/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Similarly to mammalian target of rapamycin (mTOR) inhibition, GSK3 inhibitors promote TFEB nuclear localization and leads to TFEB dephosphorylation through endogenous serine/threonine phosphatase action." .

<http://example.org/locx/sentence/25561726/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25561726/S9/position>,
        <http://example.org/locx/sentence/25561726/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25561726> .

<http://example.org/locx/sentence/25561726/S9/position> a oa:TextPositionSelector ;
    oa:end 1425 ;
    oa:start 1278 .

<http://example.org/locx/sentence/25561726/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Despite their differential impact on TFEB phosphorylation, both GSK3 and mTOR inhibitors promote 14-3-3 dissociation and TFEB nuclear localization." .

<http://example.org/locx/sentence/25562596/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25562596/S12/position>,
        <http://example.org/locx/sentence/25562596/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25562596> .

<http://example.org/locx/sentence/25562596/S12/position> a oa:TextPositionSelector ;
    oa:end 1873 ;
    oa:start 1721 .

<http://example.org/locx/sentence/25562596/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "Published literature also shows that the most distinctive immunohistochemical feature of t(6;11) translocation RCC is nuclear staining for TFEB protein." .

<http://example.org/locx/sentence/25665440/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25665440/S4/position>,
        <http://example.org/locx/sentence/25665440/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25665440> .

<http://example.org/locx/sentence/25665440/S4/position> a oa:TextPositionSelector ;
    oa:end 527 ;
    oa:start 450 .

<http://example.org/locx/sentence/25665440/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB interacts with and is phosphorylated by mTORC1 at the lysosomal surface." .

<http://example.org/locx/sentence/25665440/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25665440/S5/position>,
        <http://example.org/locx/sentence/25665440/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25665440> .

<http://example.org/locx/sentence/25665440/S5/position> a oa:TextPositionSelector ;
    oa:end 654 ;
    oa:start 528 .

<http://example.org/locx/sentence/25665440/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Thus, conditions resulting in inhibition of mTOR, such as starvation and lysosomal stress, promote TFEB nuclear translocation." .

<http://example.org/locx/sentence/25720963/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25720963/S4/position>,
        <http://example.org/locx/sentence/25720963/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25720963> .

<http://example.org/locx/sentence/25720963/S4/position> a oa:TextPositionSelector ;
    oa:end 634 ;
    oa:start 479 .

<http://example.org/locx/sentence/25720963/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Lysosomal Ca2+ release through mucolipin 1 (MCOLN1) activates calcineurin, which binds and dephosphorylates TFEB, thus promoting its nuclear translocation." .

<http://example.org/locx/sentence/25720963/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25720963/S5/position>,
        <http://example.org/locx/sentence/25720963/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25720963> .

<http://example.org/locx/sentence/25720963/S5/position> a oa:TextPositionSelector ;
    oa:end 840 ;
    oa:start 635 .

<http://example.org/locx/sentence/25720963/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Genetic and pharmacological inhibition of calcineurin suppressed TFEB activity during starvation and physical exercise, while calcineurin overexpression and constitutive activation had the opposite effect." .

<http://example.org/locx/sentence/25924622/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/25924622/S9/position>,
        <http://example.org/locx/sentence/25924622/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/25924622> .

<http://example.org/locx/sentence/25924622/S9/position> a oa:TextPositionSelector ;
    oa:end 1364 ;
    oa:start 1098 .

<http://example.org/locx/sentence/25924622/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Although only variants A and B1 induced nuclear translocation of transcription factor EB (TFEB), a master regulator of lysosomal biogenesis and autophagy, exon 4-positive and -negative APOL1 variants stimulated perinuclear accumulation of unprocessed autophagosomes." .

<http://example.org/locx/sentence/25950843/S3/position> a oa:TextPositionSelector ;
    oa:end 630 ;
    oa:start 227 .

<http://example.org/locx/sentence/25950843/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "This is illustrated by the discovery of a growing number of lysosome-localized proteins that respond to changes in growth factor and nutrient availability to regulate mTORC1 signaling as well as the identification of MiT/TFE transcription factors (MITF, TFEB and TFE3) as proteins that shuttle between lysosomes and the nucleus to elicit a transcriptional response to ongoing changes in lysosome status." .

<http://example.org/locx/sentence/26115100/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26115100/S3/position>,
        <http://example.org/locx/sentence/26115100/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26115100> .

<http://example.org/locx/sentence/26115100/S3/position> a oa:TextPositionSelector ;
    oa:end 457 ;
    oa:start 202 .

<http://example.org/locx/sentence/26115100/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "We report that exposure of macrophages to infectious or non-infectious purified HIV induces toll-like receptor 8 (TLR8) and BECN1 dependent dephosphorylation and nuclear translocation of TFEB and that this correlates with an increase in autophagy markers." .

<http://example.org/locx/sentence/26115100/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26115100/S5/position>,
        <http://example.org/locx/sentence/26115100/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26115100> .

<http://example.org/locx/sentence/26115100/S5/position> a oa:TextPositionSelector ;
    oa:end 704 ;
    oa:start 544 .

<http://example.org/locx/sentence/26115100/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "However, once HIV establishes a productive infection, TFEB phosphorylation and cytoplasmic sequestration are increased resulting in decreased autophagy markers." .

<http://example.org/locx/sentence/26115100/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26115100/S7/position>,
        <http://example.org/locx/sentence/26115100/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26115100> .

<http://example.org/locx/sentence/26115100/S7/position> a oa:TextPositionSelector ;
    oa:end 990 ;
    oa:start 794 .

<http://example.org/locx/sentence/26115100/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Conversely, although Nef deleted HIV similarly induces TFEB dephosphorylation and nuclear localization, and increases autophagy, these levels remain elevated during continued productive infection." .

<http://example.org/locx/sentence/26115100/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26115100/S9/position>,
        <http://example.org/locx/sentence/26115100/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26115100> .

<http://example.org/locx/sentence/26115100/S9/position> a oa:TextPositionSelector ;
    oa:end 1346 ;
    oa:start 1157 .

<http://example.org/locx/sentence/26115100/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "During permissive infection, Nef binds BECN1 resulting in mammalian target of rapamycin (MTOR) activation, TFEB phosphorylation and cytosolic sequestration, and the inhibition of autophagy." .

<http://example.org/locx/sentence/26137861/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26137861/S9/position>,
        <http://example.org/locx/sentence/26137861/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26137861> .

<http://example.org/locx/sentence/26137861/S9/position> a oa:TextPositionSelector ;
    oa:end 1181 ;
    oa:start 1051 .

<http://example.org/locx/sentence/26137861/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "The histone deacetylase-5 (HDAC5), which was directly bound to and colocalized with TFEB, inhibited TFEB-induced MuRF1 expression." .

<http://example.org/locx/sentence/26168401/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26168401/S6/position>,
        <http://example.org/locx/sentence/26168401/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26168401> .

<http://example.org/locx/sentence/26168401/S6/position> a oa:TextPositionSelector ;
    oa:end 872 ;
    oa:start 727 .

<http://example.org/locx/sentence/26168401/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In human PDA cells, the MiT/TFE proteins--MITF, TFE3 and TFEB--are decoupled from regulatory mechanisms that control their cytoplasmic retention." .

<http://example.org/locx/sentence/26168401/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26168401/S7/position>,
        <http://example.org/locx/sentence/26168401/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26168401> .

<http://example.org/locx/sentence/26168401/S7/position> a oa:TextPositionSelector ;
    oa:end 1040 ;
    oa:start 873 .

<http://example.org/locx/sentence/26168401/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Increased nuclear import in turn drives the expression of a coherent network of genes that induce high levels of lysosomal catabolic function essential for PDA growth." .

<http://example.org/locx/sentence/26240184/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26240184/S4/position>,
        <http://example.org/locx/sentence/26240184/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26240184> .

<http://example.org/locx/sentence/26240184/S4/position> a oa:TextPositionSelector ;
    oa:end 554 ;
    oa:start 413 .

<http://example.org/locx/sentence/26240184/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "We show that during mitophagy TFEB translocates to the nucleus and displays transcriptional activity in a PINK1- and Parkin-dependent manner." .

<http://example.org/locx/sentence/26240184/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26240184/S6/position>,
        <http://example.org/locx/sentence/26240184/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26240184> .

<http://example.org/locx/sentence/26240184/S6/position> a oa:TextPositionSelector ;
    oa:end 881 ;
    oa:start 709 .

<http://example.org/locx/sentence/26240184/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Unlike TFEB translocation after starvation-induced mammalian target of rapamycin complex 1 inhibition, Parkin-mediated TFEB relocalization required Atg9A and Atg5 activity." .

<http://example.org/locx/sentence/26240184/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26240184/S7/position>,
        <http://example.org/locx/sentence/26240184/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26240184> .

<http://example.org/locx/sentence/26240184/S7/position> a oa:TextPositionSelector ;
    oa:end 1058 ;
    oa:start 882 .

<http://example.org/locx/sentence/26240184/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "However, constitutively active Rag guanosine triphosphatases prevented TFEB translocation during mitophagy, suggesting cross talk between these two MiT/TFE activation pathways." .

<http://example.org/locx/sentence/26503418/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26503418/S6/position>,
        <http://example.org/locx/sentence/26503418/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26503418> .

<http://example.org/locx/sentence/26503418/S6/position> a oa:TextPositionSelector ;
    oa:end 922 ;
    oa:start 718 .

<http://example.org/locx/sentence/26503418/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Disruption of dynamic microtubules by flubendazole results in mTOR deactivation and dissociation from lysosomes leading to TFEB (transcription factor EB) nuclear translocation and activation of autophagy." .

<http://example.org/locx/sentence/26509433/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26509433/S10/position>,
        <http://example.org/locx/sentence/26509433/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26509433> .

<http://example.org/locx/sentence/26509433/S10/position> a oa:TextPositionSelector ;
    oa:end 1304 ;
    oa:start 1108 .

<http://example.org/locx/sentence/26509433/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "We report that both Nrf2 and TFEB translocate to the nucleus following mitophagy induction and that the increase in p62 mRNA levels was significantly impaired in cells with Nrf2 or TFEB knockdown." .

<http://example.org/locx/sentence/26572924/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26572924/S10/position>,
        <http://example.org/locx/sentence/26572924/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26572924> .

<http://example.org/locx/sentence/26572924/S10/position> a oa:TextPositionSelector ;
    oa:end 1571 ;
    oa:start 1390 .

<http://example.org/locx/sentence/26572924/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "The recombinant gp82 protein, the MT-specific surface molecule that mediates invasion, induced mTOR dephosphorylation, nuclear TFEB translocation and lysosome biogenesis/scattering." .

<http://example.org/locx/sentence/26572924/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26572924/S7/position>,
        <http://example.org/locx/sentence/26572924/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26572924> .

<http://example.org/locx/sentence/26572924/S7/position> a oa:TextPositionSelector ;
    oa:end 1187 ;
    oa:start 1003 .

<http://example.org/locx/sentence/26572924/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Metacylic trypomastigotes, but not TCT, induced mTOR dephosphorylation and the nuclear translocation of transcription factor EB (TFEB), a mTOR-associated lysosome biogenesis regulator." .

<http://example.org/locx/sentence/26613410/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26613410/S4/position>,
        <http://example.org/locx/sentence/26613410/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26613410> .

<http://example.org/locx/sentence/26613410/S4/position> a oa:TextPositionSelector ;
    oa:end 644 ;
    oa:start 475 .

<http://example.org/locx/sentence/26613410/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Further, uncaging of Sph leads to the translocation of the autophagy-relevant transcription factor EB (TFEB) to the nucleus specifically after lysosomal calcium release." .

<http://example.org/locx/sentence/26727288/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26727288/S10/position>,
        <http://example.org/locx/sentence/26727288/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26727288> .

<http://example.org/locx/sentence/26727288/S10/position> a oa:TextPositionSelector ;
    oa:end 1489 ;
    oa:start 1351 .

<http://example.org/locx/sentence/26727288/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Our data suggest that lysosomal-associated functions regulated by the TFEB-V-ATPase axis might play a conserved role in shaping cell fate." .

<http://example.org/locx/sentence/26813791/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26813791/S5/position>,
        <http://example.org/locx/sentence/26813791/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26813791> .

<http://example.org/locx/sentence/26813791/S5/position> a oa:TextPositionSelector ;
    oa:end 566 ;
    oa:start 412 .

<http://example.org/locx/sentence/26813791/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Treatment with ER stressors causes translocation of TFEB and TFE3 to the nucleus in a process that is dependent on PERK and calcineurin but not on mTORC1." .

<http://example.org/locx/sentence/26994576/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/26994576/S6/position>,
        <http://example.org/locx/sentence/26994576/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/26994576> .

<http://example.org/locx/sentence/26994576/S6/position> a oa:TextPositionSelector ;
    oa:end 975 ;
    oa:start 893 .

<http://example.org/locx/sentence/26994576/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Lack of cystinosin reduced TFEB expression and induced TFEB nuclear translocation." .

<http://example.org/locx/sentence/27001890/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27001890/S6/position>,
        <http://example.org/locx/sentence/27001890/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27001890> .

<http://example.org/locx/sentence/27001890/S6/position> a oa:TextPositionSelector ;
    oa:end 890 ;
    oa:start 665 .

<http://example.org/locx/sentence/27001890/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Surprisingly, MML-1 regulates nuclear localization and activity of HLH-30/TFEB, a convergent regulator of autophagy, lysosome biogenesis and longevity, by downregulating TOR signalling via LARS-1/leucyl-transfer RNA synthase." .

<http://example.org/locx/sentence/27085974/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27085974/S6/position>,
        <http://example.org/locx/sentence/27085974/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27085974> .

<http://example.org/locx/sentence/27085974/S6/position> a oa:TextPositionSelector ;
    oa:end 1149 ;
    oa:start 912 .

<http://example.org/locx/sentence/27085974/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Muscle immunofluorescence showed that while in MADD and NLSD-M there was a co-localized expression of TFEB and p62-SQSTM1 (marker of protein aggregates) in some atrophic fibers, in CD and CPT-II deficiency the reaction was almost normal." .

<http://example.org/locx/sentence/27085974/S7/position> a oa:TextPositionSelector ;
    oa:end 1291 ;
    oa:start 1150 .

<http://example.org/locx/sentence/27085974/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In regenerating fibers, TFEB localized in the cytoplasm (inactive form), whereas in atrophic fibers it localized in the nuclei (active form)." .

<http://example.org/locx/sentence/27172265/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27172265/S7/position>,
        <http://example.org/locx/sentence/27172265/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27172265> .

<http://example.org/locx/sentence/27172265/S7/position> a oa:TextPositionSelector ;
    oa:end 1091 ;
    oa:start 961 .

<http://example.org/locx/sentence/27172265/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Compound C1 specifically binds to TFEB at the N terminus and promotes TFEB nuclear translocation without inhibiting MTOR activity." .

<http://example.org/locx/sentence/27175909/S5/position> a oa:TextPositionSelector ;
    oa:end 515 ;
    oa:start 367 .

<http://example.org/locx/sentence/27175909/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that TFEB expression was significantly elevated in human PDAC samples (n=45), and localized to the cytoplasm and nucleus in 11 of 15 cases." .

<http://example.org/locx/sentence/27175909/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27175909/S6/position>,
        <http://example.org/locx/sentence/27175909/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27175909> .

<http://example.org/locx/sentence/27175909/S6/position> a oa:TextPositionSelector ;
    oa:end 667 ;
    oa:start 516 .

<http://example.org/locx/sentence/27175909/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In primary PDAC cell lines, TFEB nuclear expression was evident even under basal conditions, and further nuclear enrichment was achieved by starvation." .

<http://example.org/locx/sentence/27195074/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27195074/S6/position>,
        <http://example.org/locx/sentence/27195074/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27195074> .

<http://example.org/locx/sentence/27195074/S6/position> a oa:TextPositionSelector ;
    oa:end 845 ;
    oa:start 762 .

<http://example.org/locx/sentence/27195074/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In addition, localization of TFEB to the nucleus was increased by oxidative stress." .

<http://example.org/locx/sentence/27252382/S4/position> a oa:TextPositionSelector ;
    oa:end 488 ;
    oa:start 336 .

<http://example.org/locx/sentence/27252382/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Phosphorylated TFEB is retained in the cytoplasm, whereas dephosphorylated TFEB translocates to the nucleus to induce the transcription of target genes." .

<http://example.org/locx/sentence/27268034/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27268034/S2/position>,
        <http://example.org/locx/sentence/27268034/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27268034> .

<http://example.org/locx/sentence/27268034/S2/position> a oa:TextPositionSelector ;
    oa:end 348 ;
    oa:start 190 .

<http://example.org/locx/sentence/27268034/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "BACKGROUND: TFEB (transcription factor EB) regulates metabolic homeostasis through its activation of lysosomal biogenesis following its nuclear translocation." .

<http://example.org/locx/sentence/27268034/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27268034/S3/position>,
        <http://example.org/locx/sentence/27268034/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27268034> .

<http://example.org/locx/sentence/27268034/S3/position> a oa:TextPositionSelector ;
    oa:end 441 ;
    oa:start 349 .

<http://example.org/locx/sentence/27268034/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB activity is inhibited by mTOR phosphorylation, which signals its cytoplasmic retention." .

<http://example.org/locx/sentence/27312848/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27312848/S9/position>,
        <http://example.org/locx/sentence/27312848/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27312848> .

<http://example.org/locx/sentence/27312848/S9/position> a oa:TextPositionSelector ;
    oa:end 1396 ;
    oa:start 1198 .

<http://example.org/locx/sentence/27312848/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Inhibition of mTOR also triggered nuclear localization of TFEB, a transcription factor that regulates lysosome biogenesis and function, but the rescue phenotype did not require the presence of TFEB." .

<http://example.org/locx/sentence/27357649/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27357649/S7/position>,
        <http://example.org/locx/sentence/27357649/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27357649> .

<http://example.org/locx/sentence/27357649/S7/position> a oa:TextPositionSelector ;
    oa:end 850 ;
    oa:start 731 .

<http://example.org/locx/sentence/27357649/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This activation triggers calcineurin-dependent TFEB-nuclear translocation, autophagy induction and lysosome biogenesis." .

<http://example.org/locx/sentence/27485905/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27485905/S5/position>,
        <http://example.org/locx/sentence/27485905/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27485905> .

<http://example.org/locx/sentence/27485905/S5/position> a oa:TextPositionSelector ;
    oa:end 800 ;
    oa:start 545 .

<http://example.org/locx/sentence/27485905/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Increasing reactive oxygen species (ROS) levels, either endogenously by mitochondrial damage or exogenously, directly activates MCOLN1 to induce lysosomal Ca2+ release, triggering PPP3/calcineurin-dependent TFEB nuclear translocation to enhance autophagy." .

<http://example.org/locx/sentence/27593892/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27593892/S3/position>,
        <http://example.org/locx/sentence/27593892/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27593892> .

<http://example.org/locx/sentence/27593892/S3/position> a oa:TextPositionSelector ;
    oa:end 487 ;
    oa:start 339 .

<http://example.org/locx/sentence/27593892/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Nucleus translocation of transcription factor EB (TFEB) plays critical roles in lysosome biogenesis following lysosome stress induced by starvation." .

<http://example.org/locx/sentence/27593892/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27593892/S7/position>,
        <http://example.org/locx/sentence/27593892/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27593892> .

<http://example.org/locx/sentence/27593892/S7/position> a oa:TextPositionSelector ;
    oa:end 1038 ;
    oa:start 950 .

<http://example.org/locx/sentence/27593892/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Subsequently, TFEB is dephosphorylated at serine 142 and translocated into cell nucleus." .

<http://example.org/locx/sentence/27593892/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27593892/S8/position>,
        <http://example.org/locx/sentence/27593892/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27593892> .

<http://example.org/locx/sentence/27593892/S8/position> a oa:TextPositionSelector ;
    oa:end 1326 ;
    oa:start 1039 .

<http://example.org/locx/sentence/27593892/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "This nucleus translocation of TFEB is observed only in vacuolated cells and it is critical for maintaining lysosome homeostasis after REO nanoparticle treatment, as knock-down of TFEB gene significantly compromises lysosome function and enhances cell death in nanoparticle-treated cells." .

<http://example.org/locx/sentence/27689333/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27689333/S11/position>,
        <http://example.org/locx/sentence/27689333/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27689333> .

<http://example.org/locx/sentence/27689333/S11/position> a oa:TextPositionSelector ;
    oa:end 1282 ;
    oa:start 1228 .

<http://example.org/locx/sentence/27689333/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "(ii) Curcumin promotes TFEB nuclear translocation; and" .

<http://example.org/locx/sentence/27689333/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27689333/S9/position>,
        <http://example.org/locx/sentence/27689333/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27689333> .

<http://example.org/locx/sentence/27689333/S9/position> a oa:TextPositionSelector ;
    oa:end 1190 ;
    oa:start 989 .

<http://example.org/locx/sentence/27689333/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Third, Curcumin treatment activates transcription factor EB (TFEB), a key nuclear transcription factor in control of autophagy and lysosome biogenesis and function, based on the following observations:" .

<http://example.org/locx/sentence/27835930/S10/position> a oa:TextPositionSelector ;
    oa:end 2342 ;
    oa:start 2188 .

<http://example.org/locx/sentence/27835930/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "INNOVATION: CS exposure impairs autophagy in COPD-emphysema by inducing perinuclear localization of master autophagy regulator, TFEB, to aggresome-bodies." .

<http://example.org/locx/sentence/27835930/S4/position> a oa:TextPositionSelector ;
    oa:end 831 ;
    oa:start 619 .

<http://example.org/locx/sentence/27835930/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "RESULTS: We first observed that TFEB accumulates in perinuclear spaces as aggresome-bodies in COPD lung tissues of tobacco smokers and severe emphysema subjects, compared with non-emphysema or nonsmoker controls." .

<http://example.org/locx/sentence/27892481/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/27892481/S7/position>,
        <http://example.org/locx/sentence/27892481/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/27892481> .

<http://example.org/locx/sentence/27892481/S7/position> a oa:TextPositionSelector ;
    oa:end 776 ;
    oa:start 607 .

<http://example.org/locx/sentence/27892481/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Glutamine deprivation, but not that of glucose, led to the activation of macropinocytosis-associated autophagy through TFEB induction and translocation into the nucleus." .

<http://example.org/locx/sentence/28002813/S3/position> a oa:TextPositionSelector ;
    oa:end 474 ;
    oa:start 246 .

<http://example.org/locx/sentence/28002813/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Exposure of cells to sub-lethal concentrations of exogenously added hydrogen peroxide resulted in cytosol to nuclear translocation of the Transcription Factor EB (TFEB), the master controller of lysosome biogenesis and function." .

<http://example.org/locx/sentence/28011087/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28011087/S5/position>,
        <http://example.org/locx/sentence/28011087/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28011087> .

<http://example.org/locx/sentence/28011087/S5/position> a oa:TextPositionSelector ;
    oa:end 787 ;
    oa:start 552 .

<http://example.org/locx/sentence/28011087/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Indeed, TFEB translocates into the myonuclei during physical activity and regulates glucose uptake and glycogen content by controlling expression of glucose transporters, glycolytic enzymes, and pathways related to glucose homeostasis." .

<http://example.org/locx/sentence/28017540/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28017540/S13/position>,
        <http://example.org/locx/sentence/28017540/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28017540> .

<http://example.org/locx/sentence/28017540/S13/position> a oa:TextPositionSelector ;
    oa:end 1791 ;
    oa:start 1699 .

<http://example.org/locx/sentence/28017540/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "In in vitro experiments, acidity triggered overexpression of TFEB and nuclear translocation." .

<http://example.org/locx/sentence/28017540/S7/position> a oa:TextPositionSelector ;
    oa:end 922 ;
    oa:start 797 .

<http://example.org/locx/sentence/28017540/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "RESULTS: Overexpression of TFEB in cancer cell cytoplasm and the perinuclear/nuclear area was noted in 23 (23%) of 100 cases." .

<http://example.org/locx/sentence/28055300/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28055300/S2/position>,
        <http://example.org/locx/sentence/28055300/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28055300> .

<http://example.org/locx/sentence/28055300/S2/position> a oa:TextPositionSelector ;
    oa:end 199 ;
    oa:start 40 .

<http://example.org/locx/sentence/28055300/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "The master regulator of lysosome biogenesis, TFEB, is regulated by MTORC1 through phosphorylation at S211, and a S211A mutation increases nuclear localization." .

<http://example.org/locx/sentence/28055300/S3/position> a oa:TextPositionSelector ;
    oa:end 315 ;
    oa:start 200 .

<http://example.org/locx/sentence/28055300/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "However, TFEBS211A localizes diffusely in both cytoplasm and nucleus and, as we show, retains regulation by MTORC1." .

<http://example.org/locx/sentence/28055300/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28055300/S5/position>,
        <http://example.org/locx/sentence/28055300/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28055300> .

<http://example.org/locx/sentence/28055300/S5/position> a oa:TextPositionSelector ;
    oa:end 653 ;
    oa:start 526 .

<http://example.org/locx/sentence/28055300/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Specifically, nuclear localization following MTORC1 inhibition is blocked by a S122D mutation (despite S211 dephosphorylation)." .

<http://example.org/locx/sentence/28056508/S7/position> a oa:TextPositionSelector ;
    oa:end 1240 ;
    oa:start 1081 .

<http://example.org/locx/sentence/28056508/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "These analyses demonstrated that the binding of FK506 with ATP6V1A induces autophagy by activating the translocation of TFEB from the cytosol into the nucleus." .

<http://example.org/locx/sentence/28134625/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28134625/S6/position>,
        <http://example.org/locx/sentence/28134625/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28134625> .

<http://example.org/locx/sentence/28134625/S6/position> a oa:TextPositionSelector ;
    oa:end 782 ;
    oa:start 608 .

<http://example.org/locx/sentence/28134625/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we have shown that URMC-099 facilitates ARV sequestration and its antiretroviral responses by promoting the nuclear translocation of the transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/28165011/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28165011/S4/position>,
        <http://example.org/locx/sentence/28165011/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28165011> .

<http://example.org/locx/sentence/28165011/S4/position> a oa:TextPositionSelector ;
    oa:end 692 ;
    oa:start 512 .

<http://example.org/locx/sentence/28165011/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "We show that Akt phosphorylates TFEB at Ser467 and represses TFEB nuclear translocation independently of mechanistic target of rapamycin complex 1 (mTORC1), a known TFEB inhibitor." .

<http://example.org/locx/sentence/28187461/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28187461/S2/position>,
        <http://example.org/locx/sentence/28187461/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28187461> .

<http://example.org/locx/sentence/28187461/S2/position> a oa:TextPositionSelector ;
    oa:end 278 ;
    oa:start 74 .

<http://example.org/locx/sentence/28187461/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "We have recently shown that hydrophobic weak base anticancer drugs are highly sequestered in acidic lysosomes, inducing TFEB-mediated lysosomal biogenesis and markedly increased lysosome numbers per cell." .

<http://example.org/locx/sentence/28240313/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28240313/S6/position>,
        <http://example.org/locx/sentence/28240313/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28240313> .

<http://example.org/locx/sentence/28240313/S6/position> a oa:TextPositionSelector ;
    oa:end 945 ;
    oa:start 738 .

<http://example.org/locx/sentence/28240313/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, Cd induces the nuclear translocation of TFEB and TFEB target-gene expression, associated with compromised lysosomal function or a compensatory effect after the impairment of the autophagic flux." .

<http://example.org/locx/sentence/28288037/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28288037/S8/position>,
        <http://example.org/locx/sentence/28288037/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28288037> .

<http://example.org/locx/sentence/28288037/S8/position> a oa:TextPositionSelector ;
    oa:end 1212 ;
    oa:start 991 .

<http://example.org/locx/sentence/28288037/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Immunohistochemically, all 4 cases demonstrated moderate to strong immunoreactivity for TFE3, Cathepsin K, CD10, Ksp-cadherin, E-cadherin, P504S, RCC marker, PAX8 and vimentin, whereas negativity for TFEB, HMB45, and CK7." .

<http://example.org/locx/sentence/28292013/S5/position> a oa:TextPositionSelector ;
    oa:end 920 ;
    oa:start 681 .

<http://example.org/locx/sentence/28292013/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We found p53 deletion or chemical inhibition of p53 using pifithrin-alpha could promote the translocation of TFEB from cytoplasm to the nucleus, thus increased the TFEB-mediated lysosomal and autophagosomal biogenesis in lung cancer cells." .

<http://example.org/locx/sentence/28301521/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28301521/S9/position>,
        <http://example.org/locx/sentence/28301521/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28301521> .

<http://example.org/locx/sentence/28301521/S9/position> a oa:TextPositionSelector ;
    oa:end 1458 ;
    oa:start 1267 .

<http://example.org/locx/sentence/28301521/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Lysosomal activation observed was likely attributed to lysosomal dysfunction, leading to compensatory responses including nuclear translocation of transcriptional factors TFEB, TFE3 and MITF." .

<http://example.org/locx/sentence/28322484/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28322484/S2/position>,
        <http://example.org/locx/sentence/28322484/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28322484> .

<http://example.org/locx/sentence/28322484/S2/position> a oa:TextPositionSelector ;
    oa:end 334 ;
    oa:start 112 .

<http://example.org/locx/sentence/28322484/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "Pediatric RCC is a rare pediatric neoplasm and is distinctly different compared to adult RCC, often demonstrating translocation morphology evidenced by unique histopathological features and TFE3 or TFEB nuclear expression." .

<http://example.org/locx/sentence/28350209/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28350209/S3/position>,
        <http://example.org/locx/sentence/28350209/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28350209> .

<http://example.org/locx/sentence/28350209/S3/position> a oa:TextPositionSelector ;
    oa:end 546 ;
    oa:start 208 .

<http://example.org/locx/sentence/28350209/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Our data robustly establish PIKFYVE as the target through which apilimod kills B-NHL cells and show that apilimod-induced death in B-NHL is mediated by broad disruption of lysosome homeostasis characterized by lysosomal swelling, TFEB nuclear translocation, impaired maturation of lysosomal enzymes and incomplete autophagosome clearance." .

<http://example.org/locx/sentence/28603284/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28603284/S4/position>,
        <http://example.org/locx/sentence/28603284/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28603284> .

<http://example.org/locx/sentence/28603284/S4/position> a oa:TextPositionSelector ;
    oa:end 668 ;
    oa:start 477 .

<http://example.org/locx/sentence/28603284/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Treatment of human colon cancer LoVo cells with doxorubicin (0.5 mumol/L) induced autophagy activation and nuclear translocation of TFEB, which resulted from inactivation of the mTOR pathway." .

<http://example.org/locx/sentence/28637240/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28637240/S10/position>,
        <http://example.org/locx/sentence/28637240/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28637240> .

<http://example.org/locx/sentence/28637240/S10/position> a oa:TextPositionSelector ;
    oa:end 1425 ;
    oa:start 1245 .

<http://example.org/locx/sentence/28637240/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Herein, we show that compounds such as everolimus, ionomycin and curcumin, which directly or indirectly stimulate TFEB nuclear translocation, restore Tsc1-deficient NSPC migration." .

<http://example.org/locx/sentence/28637240/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28637240/S9/position>,
        <http://example.org/locx/sentence/28637240/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28637240> .

<http://example.org/locx/sentence/28637240/S9/position> a oa:TextPositionSelector ;
    oa:end 1244 ;
    oa:start 1133 .

<http://example.org/locx/sentence/28637240/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, nuclear translocation, namely activation of the transcription factor EB (TFEB) was markedly impaired." .

<http://example.org/locx/sentence/28769785/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28769785/S5/position>,
        <http://example.org/locx/sentence/28769785/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28769785> .

<http://example.org/locx/sentence/28769785/S5/position> a oa:TextPositionSelector ;
    oa:end 832 ;
    oa:start 520 .

<http://example.org/locx/sentence/28769785/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We observed the effects of Abeta on the trafficking of nuclear transcriptional factor EB (TFEB), a master regulator of lysosome biogenesis, and the expression of a downstream osteoporosis-associated transmembrane protein 1 (OSTM1), a vital molecule involved in lysosome acidification in primary microglial cells." .

<http://example.org/locx/sentence/28769785/S7/position> a oa:TextPositionSelector ;
    oa:end 1195 ;
    oa:start 993 .

<http://example.org/locx/sentence/28769785/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Further, Abeta induced a dose-dependent reduction of the TFEB in the nucleus of primary microglial cells, coincident with the increase in the plasma, as revealed by Western blot and confocal microscopy." .

<http://example.org/locx/sentence/28769785/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28769785/S9/position>,
        <http://example.org/locx/sentence/28769785/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28769785> .

<http://example.org/locx/sentence/28769785/S9/position> a oa:TextPositionSelector ;
    oa:end 1533 ;
    oa:start 1401 .

<http://example.org/locx/sentence/28769785/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "These data suggest that Abeta might result in a lysosomal dysfunction via inhibiting nuclear TFEB translocation in microglial cells." .

<http://example.org/locx/sentence/28798237/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28798237/S5/position>,
        <http://example.org/locx/sentence/28798237/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28798237> .

<http://example.org/locx/sentence/28798237/S5/position> a oa:TextPositionSelector ;
    oa:end 869 ;
    oa:start 714 .

<http://example.org/locx/sentence/28798237/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We found a functional requirement of PEG3 for TFEB transcriptional induction and nuclear translocation in human umbilical vein endothelial and PAER2 cells." .

<http://example.org/locx/sentence/28798237/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28798237/S6/position>,
        <http://example.org/locx/sentence/28798237/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28798237> .

<http://example.org/locx/sentence/28798237/S6/position> a oa:TextPositionSelector ;
    oa:end 1058 ;
    oa:start 870 .

<http://example.org/locx/sentence/28798237/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, inhibiting VEGFR2 or AMP-activated protein kinase (AMPK), a major decorin-activated energy sensor kinase, prevented decorin-evoked TFEB induction and nuclear localization." .

<http://example.org/locx/sentence/28820290/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28820290/S7/position>,
        <http://example.org/locx/sentence/28820290/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28820290> .

<http://example.org/locx/sentence/28820290/S7/position> a oa:TextPositionSelector ;
    oa:end 971 ;
    oa:start 736 .

<http://example.org/locx/sentence/28820290/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In the nucleus, ACSS2 forms a complex with TFEB (transcription factor EB) and utilizes the acetate generated from histone deacetylation to locally produce acetyl-CoA for histone acetylation in the promoter regions of TFEB target genes." .

<http://example.org/locx/sentence/28933629/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28933629/S10/position>,
        <http://example.org/locx/sentence/28933629/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28933629> .

<http://example.org/locx/sentence/28933629/S10/position> a oa:TextPositionSelector ;
    oa:end 1448 ;
    oa:start 1346 .

<http://example.org/locx/sentence/28933629/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Ezetimibe induced AMPK phosphorylation and subsequent TFEB nuclear translocation, related to MAPK/ERK." .

<http://example.org/locx/sentence/28933629/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/28933629/S8/position>,
        <http://example.org/locx/sentence/28933629/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/28933629> .

<http://example.org/locx/sentence/28933629/S8/position> a oa:TextPositionSelector ;
    oa:end 1213 ;
    oa:start 1065 .

<http://example.org/locx/sentence/28933629/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Human livers with steatosis or NASH presented impaired autophagy with decreased nuclear TFEB and increased SQSTM1, MAP1LC3-II, and NLRP3 expression." .

<http://example.org/locx/sentence/29035891/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29035891/S9/position>,
        <http://example.org/locx/sentence/29035891/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29035891> .

<http://example.org/locx/sentence/29035891/S9/position> a oa:TextPositionSelector ;
    oa:end 1409 ;
    oa:start 1170 .

<http://example.org/locx/sentence/29035891/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Salidroside also induced TFEB (Ser142) dephosphorylation, subsequently to activated TFEB nuclear translocation and increase of TFEB reporter activity, which contributed to lysosomal biogenesis and the expression of autophagy-related genes." .

<http://example.org/locx/sentence/29079589/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29079589/S7/position>,
        <http://example.org/locx/sentence/29079589/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29079589> .

<http://example.org/locx/sentence/29079589/S7/position> a oa:TextPositionSelector ;
    oa:end 929 ;
    oa:start 777 .

<http://example.org/locx/sentence/29079589/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Lysosomal calcium further induces the activation of the transcription factor EB (TFEB), which translocates to the nucleus to maintain TRPML1 expression." .

<http://example.org/locx/sentence/29170033/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29170033/S6/position>,
        <http://example.org/locx/sentence/29170033/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29170033> .

<http://example.org/locx/sentence/29170033/S6/position> a oa:TextPositionSelector ;
    oa:end 1168 ;
    oa:start 920 .

<http://example.org/locx/sentence/29170033/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Transcription factor EB (TFEB), a key transcription factor controlling lysosome biogenesis, was also significantly downregulated by 6-OHDA and its nuclear translocation was inhibited as well, which could account for the impaired lysosomal function." .

<http://example.org/locx/sentence/29307831/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29307831/S7/position>,
        <http://example.org/locx/sentence/29307831/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29307831> .

<http://example.org/locx/sentence/29307831/S7/position> a oa:TextPositionSelector ;
    oa:end 1165 ;
    oa:start 877 .

<http://example.org/locx/sentence/29307831/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, ATO induced TFEB(Ser142) dephosphorylation, activated TFEB nuclear translocation and increased TFEB reporter activity, which contributed to lysosomal biogenesis and the expression of autophagy-related genes and subsequently initiated autophagic cell death in MG-63 cells." .

<http://example.org/locx/sentence/29313411/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29313411/S7/position>,
        <http://example.org/locx/sentence/29313411/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29313411> .

<http://example.org/locx/sentence/29313411/S7/position> a oa:TextPositionSelector ;
    oa:end 818 ;
    oa:start 631 .

<http://example.org/locx/sentence/29313411/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, TCF inhibition regulated autophagy through MTOR inhibition and dephosphorylation, and nuclear translocation of TFEB, a master regulator of lysosomal biogenesis and autophagy." .

<http://example.org/locx/sentence/29368982/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29368982/S11/position>,
        <http://example.org/locx/sentence/29368982/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29368982> .

<http://example.org/locx/sentence/29368982/S11/position> a oa:TextPositionSelector ;
    oa:end 1593 ;
    oa:start 1360 .

<http://example.org/locx/sentence/29368982/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, DIRAS1 and DIRAS2 induce and regulate autophagy by inhibition of the AKT1-MTOR and RAS-MAPK signaling pathways and modulating nuclear localization of the autophagy-related transcription factors FOXO3/FOXO3A and TFEB." .

<http://example.org/locx/sentence/29445085/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29445085/S8/position>,
        <http://example.org/locx/sentence/29445085/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29445085> .

<http://example.org/locx/sentence/29445085/S8/position> a oa:TextPositionSelector ;
    oa:end 1181 ;
    oa:start 1000 .

<http://example.org/locx/sentence/29445085/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "This induction of the lysosome-dependent c-FLIPL degradation was associated with nuclear translocation of transcription factor EB (TFEB), a master regulator of lysosomal biogenesis." .

<http://example.org/locx/sentence/29449811/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29449811/S4/position>,
        <http://example.org/locx/sentence/29449811/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29449811> .

<http://example.org/locx/sentence/29449811/S4/position> a oa:TextPositionSelector ;
    oa:end 548 ;
    oa:start 430 .

<http://example.org/locx/sentence/29449811/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "When TFEB localizes to the cell nucleus it promotes the expression of a number of genes involved in protein clearance." .

<http://example.org/locx/sentence/29449811/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29449811/S7/position>,
        <http://example.org/locx/sentence/29449811/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29449811> .

<http://example.org/locx/sentence/29449811/S7/position> a oa:TextPositionSelector ;
    oa:end 1270 ;
    oa:start 1091 .

<http://example.org/locx/sentence/29449811/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In cultured NRK-52E cells, HDAC6 inhibition with the small molecule inhibitor Tubastatin A acetylated TFEB, increasing TFEB localization to the nucleus and attenuating cell death." .

<http://example.org/locx/sentence/29455584/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29455584/S6/position>,
        <http://example.org/locx/sentence/29455584/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29455584> .

<http://example.org/locx/sentence/29455584/S6/position> a oa:TextPositionSelector ;
    oa:end 1003 ;
    oa:start 818 .

<http://example.org/locx/sentence/29455584/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Supplementation of HEPES to cell growth media is sufficient to decouple the MiT/TFE family members-TFEB, TFE3 and MITF-from regulatory mechanisms that control their cytosolic retention." .

<http://example.org/locx/sentence/29455584/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29455584/S7/position>,
        <http://example.org/locx/sentence/29455584/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29455584> .

<http://example.org/locx/sentence/29455584/S7/position> a oa:TextPositionSelector ;
    oa:end 1245 ;
    oa:start 1004 .

<http://example.org/locx/sentence/29455584/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Increased MiT/TFE nuclear import in turn drives the expression of a global network of lysosomal-autophagic and innate host-immune response genes, altering lysosomal dynamics, proteolytic capacity, autophagic flux, and inflammatory signaling." .

<http://example.org/locx/sentence/29457340/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29457340/S4/position>,
        <http://example.org/locx/sentence/29457340/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29457340> .

<http://example.org/locx/sentence/29457340/S4/position> a oa:TextPositionSelector ;
    oa:end 484 ;
    oa:start 282 .

<http://example.org/locx/sentence/29457340/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Ag NPs-induced nucleus translocation of TFEB through a well-established mechanism involving dephosphorylation of TFEB at serine-142 and serine-211 but independent of both the mTORC1 and ERK1/2 pathways." .

<http://example.org/locx/sentence/29467198/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29467198/S7/position>,
        <http://example.org/locx/sentence/29467198/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29467198> .

<http://example.org/locx/sentence/29467198/S7/position> a oa:TextPositionSelector ;
    oa:end 733 ;
    oa:start 618 .

<http://example.org/locx/sentence/29467198/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "METHODS AND RESULTS: In primary human endothelial cells (ECs), serum starvation induced TFEB nuclear translocation." .

<http://example.org/locx/sentence/29467198/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29467198/S8/position>,
        <http://example.org/locx/sentence/29467198/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29467198> .

<http://example.org/locx/sentence/29467198/S8/position> a oa:TextPositionSelector ;
    oa:end 834 ;
    oa:start 734 .

<http://example.org/locx/sentence/29467198/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "VEGF (vascular endothelial growth factor) increased TFEB expression level and nuclear translocation." .

<http://example.org/locx/sentence/29507340/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29507340/S5/position>,
        <http://example.org/locx/sentence/29507340/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29507340> .

<http://example.org/locx/sentence/29507340/S5/position> a oa:TextPositionSelector ;
    oa:end 875 ;
    oa:start 679 .

<http://example.org/locx/sentence/29507340/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We document that MAP4K3 physically interacts with TFEB and MAP4K3 inhibition is sufficient for TFEB nuclear localization, target gene transactivation, and autophagy, even when mTORC1 is activated." .

<http://example.org/locx/sentence/29507340/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29507340/S6/position>,
        <http://example.org/locx/sentence/29507340/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29507340> .

<http://example.org/locx/sentence/29507340/S6/position> a oa:TextPositionSelector ;
    oa:end 1033 ;
    oa:start 876 .

<http://example.org/locx/sentence/29507340/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, MAP4K3 serine 3 phosphorylation of TFEB is required for TFEB interaction with mTORC1-Rag GTPase-Ragulator complex and TFEB cytosolic sequestration." .

<http://example.org/locx/sentence/29622767/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29622767/S6/position>,
        <http://example.org/locx/sentence/29622767/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29622767> .

<http://example.org/locx/sentence/29622767/S6/position> a oa:TextPositionSelector ;
    oa:end 886 ;
    oa:start 752 .

<http://example.org/locx/sentence/29622767/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "mTORC1 activation further suppresses the nuclear localization of TFEB, as indicated by decreased mRNA levels of TFEB, LIPA, and LAMP1." .

<http://example.org/locx/sentence/29622767/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29622767/S8/position>,
        <http://example.org/locx/sentence/29622767/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29622767> .

<http://example.org/locx/sentence/29622767/S8/position> a oa:TextPositionSelector ;
    oa:end 1230 ;
    oa:start 1062 .

<http://example.org/locx/sentence/29622767/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Conversely, pharmacological inhibition of mTOR resulting from PEX5 depletion during nutrient starvation activates TFEB by promoting nuclear localization of the protein." .

<http://example.org/locx/sentence/29644770/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29644770/S6/position>,
        <http://example.org/locx/sentence/29644770/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29644770> .

<http://example.org/locx/sentence/29644770/S6/position> a oa:TextPositionSelector ;
    oa:end 1047 ;
    oa:start 910 .

<http://example.org/locx/sentence/29644770/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Depletion of TMEM55B was also found to evoke lysosomal stress as showed by translocation of the transcription factor TFEB to the nucleus." .

<http://example.org/locx/sentence/29689560/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29689560/S7/position>,
        <http://example.org/locx/sentence/29689560/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29689560> .

<http://example.org/locx/sentence/29689560/S7/position> a oa:TextPositionSelector ;
    oa:end 1052 ;
    oa:start 778 .

<http://example.org/locx/sentence/29689560/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "RESULTS: A low concentration of H2O2 induces TFEB phosphorylation at Ser467 and nuclear translocation, facilitating neuronal survival, whereas a high concentration of H2O2 promotes SH-SY5Y cell apoptosis via suppressing TFEB Ser467 phosphorylation and nuclear translocation." .

<http://example.org/locx/sentence/29689560/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29689560/S8/position>,
        <http://example.org/locx/sentence/29689560/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29689560> .

<http://example.org/locx/sentence/29689560/S8/position> a oa:TextPositionSelector ;
    oa:end 1166 ;
    oa:start 1053 .

<http://example.org/locx/sentence/29689560/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "The TFEB-S467D mutant is more easily translocated into the nucleus than the non-phosphorylated TFEB-S467A mutant." .

<http://example.org/locx/sentence/29764979/S3/position> a oa:TextPositionSelector ;
    oa:end 550 ;
    oa:start 386 .

<http://example.org/locx/sentence/29764979/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "An important mechanism by which these transcription factors are regulated involves their shuttling between the surface of lysosomes, the cytoplasm, and the nucleus." .

<http://example.org/locx/sentence/29768192/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29768192/S3/position>,
        <http://example.org/locx/sentence/29768192/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29768192> .

<http://example.org/locx/sentence/29768192/S3/position> a oa:TextPositionSelector ;
    oa:end 514 ;
    oa:start 184 .

<http://example.org/locx/sentence/29768192/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "In order to systematically determine the regulatory network of HLH-30/TFEB, we performed a genome-wide RNAi screen in C. elegans and found that silencing the nuclear export protein XPO-1/XPO1 enhances autophagy by significantly enriching HLH-30 in the nucleus, which is accompanied by proteostatic benefits and improved longevity." .

<http://example.org/locx/sentence/29768192/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29768192/S6/position>,
        <http://example.org/locx/sentence/29768192/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29768192> .

<http://example.org/locx/sentence/29768192/S6/position> a oa:TextPositionSelector ;
    oa:end 1012 ;
    oa:start 819 .

<http://example.org/locx/sentence/29768192/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "XPO1 inhibition in HeLa cells enhanced TFEB nuclear localization, autophagy, and lysosome biogenesis without affecting mTOR activity, revealing a conserved regulatory mechanism for HLH-30/TFEB." .

<http://example.org/locx/sentence/29782848/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29782848/S14/position>,
        <http://example.org/locx/sentence/29782848/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29782848> .

<http://example.org/locx/sentence/29782848/S14/position> a oa:TextPositionSelector ;
    oa:end 2317 ;
    oa:start 2204 .

<http://example.org/locx/sentence/29782848/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "Liver tissues from patients with alcohol-induced hepatitis had lower nuclear levels of TFEB than control tissues." .

<http://example.org/locx/sentence/29782848/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29782848/S9/position>,
        <http://example.org/locx/sentence/29782848/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29782848> .

<http://example.org/locx/sentence/29782848/S9/position> a oa:TextPositionSelector ;
    oa:end 1592 ;
    oa:start 1404 .

<http://example.org/locx/sentence/29782848/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "RESULTS: Liver tissues from mice on the ethanol diet had lower levels of total and nuclear TFEB compared with control mice, and hepatocytes had decreased lysosome biogenesis and autophagy." .

<http://example.org/locx/sentence/29795139/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29795139/S7/position>,
        <http://example.org/locx/sentence/29795139/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29795139> .

<http://example.org/locx/sentence/29795139/S7/position> a oa:TextPositionSelector ;
    oa:end 666 ;
    oa:start 515 .

<http://example.org/locx/sentence/29795139/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Second, doctaxel treatment activates TFEB (transcription factor EB), a key nuclear transcription factor in control of lysosome biogenesis and function." .

<http://example.org/locx/sentence/29795139/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29795139/S8/position>,
        <http://example.org/locx/sentence/29795139/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29795139> .

<http://example.org/locx/sentence/29795139/S8/position> a oa:TextPositionSelector ;
    oa:end 836 ;
    oa:start 667 .

<http://example.org/locx/sentence/29795139/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that docetaxel promotes TFEB nuclear translocation and increases its transcriptional activity while knockdown of TFEB impairs lysosomal activation by docetaxel." .

<http://example.org/locx/sentence/29872222/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29872222/S12/position>,
        <http://example.org/locx/sentence/29872222/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29872222> .

<http://example.org/locx/sentence/29872222/S12/position> a oa:TextPositionSelector ;
    oa:end 1768 ;
    oa:start 1583 .

<http://example.org/locx/sentence/29872222/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "Downregulation of VRK2 abrogated the lysosomal accumulation of phosphorylated Akt and impaired nuclear localization of TFEB; these events coincided to inhibition of autophagy induction." .

<http://example.org/locx/sentence/29940807/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29940807/S5/position>,
        <http://example.org/locx/sentence/29940807/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29940807> .

<http://example.org/locx/sentence/29940807/S5/position> a oa:TextPositionSelector ;
    oa:end 869 ;
    oa:start 620 .

<http://example.org/locx/sentence/29940807/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In response to loss of TRIM37 functions, phosphorylation of TFEB is significantly reduced, resulting in its translocation into the nucleus enabling its transcriptional activation of genes involved in lysosome biogenesis and macroautophagy/autophagy." .

<http://example.org/locx/sentence/29962048/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29962048/S8/position>,
        <http://example.org/locx/sentence/29962048/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29962048> .

<http://example.org/locx/sentence/29962048/S8/position> a oa:TextPositionSelector ;
    oa:end 1532 ;
    oa:start 1341 .

<http://example.org/locx/sentence/29962048/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Notably, MTMR4 knockdown inhibited the nuclear translocation of starvation stress responsive transcription factor-EB (TFEB) with reduced expression of lysosome-related genes in starved cells." .

<http://example.org/locx/sentence/29966622/S9/position> a oa:TextPositionSelector ;
    oa:end 1137 ;
    oa:start 962 .

<http://example.org/locx/sentence/29966622/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, the nucleus/cytoplasm translocation of the transcription factor EB (TFEB), but not mTOR activity, correlates with the formation/dissipation of enlarged lysosomes." .

<http://example.org/locx/sentence/29990474/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29990474/S4/position>,
        <http://example.org/locx/sentence/29990474/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29990474> .

<http://example.org/locx/sentence/29990474/S4/position> a oa:TextPositionSelector ;
    oa:end 621 ;
    oa:start 333 .

<http://example.org/locx/sentence/29990474/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that TPC overexpression in 4T1 mouse breast cancer cell line or in HeLa human cervical cancer cell line inhibited the fusion between autophagosome and lysosome, resulting in the accumulation of autophagosomes accompanied with increased lysosomal pH and TFEB nuclear localization." .

<http://example.org/locx/sentence/29992949/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29992949/S3/position>,
        <http://example.org/locx/sentence/29992949/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29992949> .

<http://example.org/locx/sentence/29992949/S3/position> a oa:TextPositionSelector ;
    oa:end 481 ;
    oa:start 225 .

<http://example.org/locx/sentence/29992949/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Amino acid limitation that inactivates mTORC1 promotes de-phosphorylation and nuclear translocation of Transcription Factor EB (TFEB), a key transcriptional regulator of lysosome biogenesis and autophagy that is deregulated in cancer and neurodegeneration." .

<http://example.org/locx/sentence/29992949/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/29992949/S4/position>,
        <http://example.org/locx/sentence/29992949/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/29992949> .

<http://example.org/locx/sentence/29992949/S4/position> a oa:TextPositionSelector ;
    oa:end 687 ;
    oa:start 482 .

<http://example.org/locx/sentence/29992949/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Beyond its cytoplasmic sequestration, how TFEB phosphorylation regulates its nuclear-cytoplasmic shuttling, and whether TFEB can coordinate amino acid supply with glucose availability is poorly understood." .

<http://example.org/locx/sentence/30097775/S4/position> a oa:TextPositionSelector ;
    oa:end 753 ;
    oa:start 559 .

<http://example.org/locx/sentence/30097775/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Under conditions in which mTORC1 is inhibited including starvation, TFEB becomes dephosphorylated and translocates to the nucleus where it functions as a master regulator of lysosome biogenesis." .

<http://example.org/locx/sentence/30120233/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30120233/S2/position>,
        <http://example.org/locx/sentence/30120233/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30120233> .

<http://example.org/locx/sentence/30120233/S2/position> a oa:TextPositionSelector ;
    oa:end 291 ;
    oa:start 61 .

<http://example.org/locx/sentence/30120233/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "During starvation the transcriptional activation of catabolic processes is induced by the nuclear translocation and consequent activation of transcription factor EB (TFEB), a master modulator of autophagy and lysosomal biogenesis." .

<http://example.org/locx/sentence/30120233/S4/position> a oa:TextPositionSelector ;
    oa:end 563 ;
    oa:start 371 .

<http://example.org/locx/sentence/30120233/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here we show that TFEB subcellular localization is dynamically controlled by its continuous shuttling between the cytosol and the nucleus, with the nuclear export representing a limiting step." .

<http://example.org/locx/sentence/30154423/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30154423/S5/position>,
        <http://example.org/locx/sentence/30154423/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30154423> .

<http://example.org/locx/sentence/30154423/S5/position> a oa:TextPositionSelector ;
    oa:end 996 ;
    oa:start 815 .

<http://example.org/locx/sentence/30154423/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We demonstrated that the expression and nuclear localization of TFEB is decreased in human and mouse OA cartilage as well as in tert-Butyl hydroperoxide (TBHP)-treated chondrocytes." .

<http://example.org/locx/sentence/30185776/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30185776/S7/position>,
        <http://example.org/locx/sentence/30185776/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30185776> .

<http://example.org/locx/sentence/30185776/S7/position> a oa:TextPositionSelector ;
    oa:end 990 ;
    oa:start 847 .

<http://example.org/locx/sentence/30185776/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Consequently, Transcription Factor EB (TFEB) translocates to the nucleus increasing the transcription of autophagy- and lysosome-related genes." .

<http://example.org/locx/sentence/30221708/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30221708/S10/position>,
        <http://example.org/locx/sentence/30221708/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30221708> .

<http://example.org/locx/sentence/30221708/S10/position> a oa:TextPositionSelector ;
    oa:end 1623 ;
    oa:start 1523 .

<http://example.org/locx/sentence/30221708/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Amino acid starvation inhibited mTOR activity, and promoted nuclear translocation and TFEB activity." .

<http://example.org/locx/sentence/30263946/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30263946/S4/position>,
        <http://example.org/locx/sentence/30263946/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30263946> .

<http://example.org/locx/sentence/30263946/S4/position> a oa:TextPositionSelector ;
    oa:end 700 ;
    oa:start 423 .

<http://example.org/locx/sentence/30263946/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Recently, we demonstrated that inhibiting the function of nuclear export protein exportin 1 (XPO1 or CRM1) with RNAi or with selective inhibitors of nuclear export (SINE) results in the nuclear enrichment of TFEB and enhancement of autophagy in model organisms and human cells." .

<http://example.org/locx/sentence/30267477/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30267477/S7/position>,
        <http://example.org/locx/sentence/30267477/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30267477> .

<http://example.org/locx/sentence/30267477/S7/position> a oa:TextPositionSelector ;
    oa:end 1241 ;
    oa:start 1064 .

<http://example.org/locx/sentence/30267477/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Increased transcription factor EB (TFEB) in T80 (relative to HEY), accompanied by its nuclear translocation and increased CLEAR network gene expression with iron, is identified." .

<http://example.org/locx/sentence/30290719/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30290719/S5/position>,
        <http://example.org/locx/sentence/30290719/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30290719> .

<http://example.org/locx/sentence/30290719/S5/position> a oa:TextPositionSelector ;
    oa:end 708 ;
    oa:start 485 .

<http://example.org/locx/sentence/30290719/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Stress-mediated inhibition of MTORC1 results in the dephosphorylation and nuclear translocation of the TFE/MITF family of transcriptional factors, and triggers an autophagy- and lysosomal-related gene transcription program." .

<http://example.org/locx/sentence/30304977/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30304977/S5/position>,
        <http://example.org/locx/sentence/30304977/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30304977> .

<http://example.org/locx/sentence/30304977/S5/position> a oa:TextPositionSelector ;
    oa:end 936 ;
    oa:start 636 .

<http://example.org/locx/sentence/30304977/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "The results showed that ALP function was first enhanced in the early stage of the ischemic process, especially in neurons of the cortex, and this was accompanied by increased TFEB expression and translocation to the nucleus, which was mediated at least in part through activation by PPP3/calcineurin." .

<http://example.org/locx/sentence/30304977/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30304977/S6/position>,
        <http://example.org/locx/sentence/30304977/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30304977> .

<http://example.org/locx/sentence/30304977/S6/position> a oa:TextPositionSelector ;
    oa:end 1177 ;
    oa:start 937 .

<http://example.org/locx/sentence/30304977/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "At the later stages of ischemia, a gradual decrease in the level of nuclear TFEB was coupled with a progressive decline in lysosomal activity, accumulation of autophagosomes and autophagy substrates, and exacerbation of the ischemic injury." .

<http://example.org/locx/sentence/30324847/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30324847/S7/position>,
        <http://example.org/locx/sentence/30324847/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30324847> .

<http://example.org/locx/sentence/30324847/S7/position> a oa:TextPositionSelector ;
    oa:end 912 ;
    oa:start 734 .

<http://example.org/locx/sentence/30324847/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, Cd activated nuclear translocation of TFE3 but not that of TFEB or MITF, which contributed to the expression of autophagy-related genes and lysosomal biogenesis." .

<http://example.org/locx/sentence/30333555/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30333555/S6/position>,
        <http://example.org/locx/sentence/30333555/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30333555> .

<http://example.org/locx/sentence/30333555/S6/position> a oa:TextPositionSelector ;
    oa:end 909 ;
    oa:start 733 .

<http://example.org/locx/sentence/30333555/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "We showed that treatment with OC (15 muM) markedly enhanced the nuclear translocation of TFEB in HeLa cells, concomitantly reduced the interaction of TFEB with 14-3-3 proteins." .

<http://example.org/locx/sentence/30335591/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30335591/S6/position>,
        <http://example.org/locx/sentence/30335591/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30335591> .

<http://example.org/locx/sentence/30335591/S6/position> a oa:TextPositionSelector ;
    oa:end 780 ;
    oa:start 640 .

<http://example.org/locx/sentence/30335591/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "This effect correlated with the calcium-dependent phosphatase PPP3/calcineurin activation, TFEB dephosphorylation and nuclear translocation." .

<http://example.org/locx/sentence/30471247/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30471247/S1/position>,
        <http://example.org/locx/sentence/30471247/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30471247> .

<http://example.org/locx/sentence/30471247/S1/position> a oa:TextPositionSelector ;
    oa:end 154 ;
    oa:start 0 .

<http://example.org/locx/sentence/30471247/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Clomiphene citrate induces nuclear translocation of the TFEB transcription factor and triggers apoptosis by enhancing lysosomal membrane permeabilization." .

<http://example.org/locx/sentence/30471247/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30471247/S5/position>,
        <http://example.org/locx/sentence/30471247/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30471247> .

<http://example.org/locx/sentence/30471247/S5/position> a oa:TextPositionSelector ;
    oa:end 791 ;
    oa:start 599 .

<http://example.org/locx/sentence/30471247/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we describe that clomiphene citrate (CC), a selective estrogen receptor modulator, promotes nuclear translocation of TFEB and increases lysosomal biogenesis in HeLa and MDA-MB-231 cells." .

<http://example.org/locx/sentence/30510622/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30510622/S4/position>,
        <http://example.org/locx/sentence/30510622/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30510622> .

<http://example.org/locx/sentence/30510622/S4/position> a oa:TextPositionSelector ;
    oa:end 633 ;
    oa:start 442 .

<http://example.org/locx/sentence/30510622/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "In the current study, we show that a naturally occurring polyphenolic compound, quercetin, promoted TFEB nuclear translocation and enhanced its transcriptional activity in cultured RPE cells." .

<http://example.org/locx/sentence/30546014/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30546014/S10/position>,
        <http://example.org/locx/sentence/30546014/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30546014> .

<http://example.org/locx/sentence/30546014/S10/position> a oa:TextPositionSelector ;
    oa:end 1855 ;
    oa:start 1576 .

<http://example.org/locx/sentence/30546014/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "We further show that while lysosomotropic drug sequestration induces Ca2+ release into the cytoplasm, facilitating calcineurin activation, chelation of cytosolic Ca2+, or direct inhibition of calcineurin activity, do not interfere with drug-induced nuclear translocation of TFEB." .

<http://example.org/locx/sentence/30546014/S13/position> a oa:TextPositionSelector ;
    oa:end 2442 ;
    oa:start 2185 .

<http://example.org/locx/sentence/30546014/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, a rapid export of TFEB from the nucleus to the cytosol occurs upon relief of mTORC1 inhibition, suggesting that dephosphorylated TFEB constantly travels between the nucleus and the cytosol, acting as a rapidly responding sensor of mTORC1 activity." .

<http://example.org/locx/sentence/30546014/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30546014/S3/position>,
        <http://example.org/locx/sentence/30546014/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30546014> .

<http://example.org/locx/sentence/30546014/S3/position> a oa:TextPositionSelector ;
    oa:end 406 ;
    oa:start 266 .

<http://example.org/locx/sentence/30546014/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB activity is inhibited following its phosphorylation by mammalian target of rapamycin complex 1 (mTORC1) on the surface of the lysosome." .

<http://example.org/locx/sentence/30546014/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30546014/S4/position>,
        <http://example.org/locx/sentence/30546014/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30546014> .

<http://example.org/locx/sentence/30546014/S4/position> a oa:TextPositionSelector ;
    oa:end 516 ;
    oa:start 407 .

<http://example.org/locx/sentence/30546014/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Phosphorylated TFEB is bound by 14-3-3 proteins, resulting in its cytoplasmic retention in an inactive state." .

<http://example.org/locx/sentence/30546014/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30546014/S9/position>,
        <http://example.org/locx/sentence/30546014/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30546014> .

<http://example.org/locx/sentence/30546014/S9/position> a oa:TextPositionSelector ;
    oa:end 1575 ;
    oa:start 1274 .

<http://example.org/locx/sentence/30546014/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Lysosomal accumulation of lysosomotropic drugs and the consequent fluidization of the lysosomal membrane, facilitated the dissociation of mTOR from the lysosomal membrane and inhibited the kinase activity of mTORC1, which is necessary and sufficient for the rapid translocation of TFEB to the nucleus." .

<http://example.org/locx/sentence/30648757/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30648757/S5/position>,
        <http://example.org/locx/sentence/30648757/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30648757> .

<http://example.org/locx/sentence/30648757/S5/position> a oa:TextPositionSelector ;
    oa:end 779 ;
    oa:start 687 .

<http://example.org/locx/sentence/30648757/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB requires the oligomerization and localization to regulate transcription in the nucleus." .

<http://example.org/locx/sentence/30653408/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30653408/S1/position>,
        <http://example.org/locx/sentence/30653408/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30653408> .

<http://example.org/locx/sentence/30653408/S1/position> a oa:TextPositionSelector ;
    oa:end 120 ;
    oa:start 0 .

<http://example.org/locx/sentence/30653408/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "YWHA/14-3-3 proteins recognize phosphorylated TFEB by a noncanonical mode for controlling TFEB cytoplasmic localization." .

<http://example.org/locx/sentence/30653408/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30653408/S4/position>,
        <http://example.org/locx/sentence/30653408/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30653408> .

<http://example.org/locx/sentence/30653408/S4/position> a oa:TextPositionSelector ;
    oa:end 513 ;
    oa:start 400 .

<http://example.org/locx/sentence/30653408/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Phosphorylated S211 (p-S211) of TFEB can be recognized by YWHA/14-3-3 proteins for TFEB cytoplasmic localization." .

<http://example.org/locx/sentence/30653408/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30653408/S7/position>,
        <http://example.org/locx/sentence/30653408/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30653408> .

<http://example.org/locx/sentence/30653408/S7/position> a oa:TextPositionSelector ;
    oa:end 1330 ;
    oa:start 1069 .

<http://example.org/locx/sentence/30653408/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mutations of essential residues in the interaction interface between TFEB and YWHA/14-3-3 proteins disrupted their interactions and severely impaired the cytoplasmic localization of TFEB, which altered the expression of TFEB target genes and affected autophagy." .

<http://example.org/locx/sentence/30773991/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30773991/S8/position>,
        <http://example.org/locx/sentence/30773991/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30773991> .

<http://example.org/locx/sentence/30773991/S8/position> a oa:TextPositionSelector ;
    oa:end 1321 ;
    oa:start 1118 .

<http://example.org/locx/sentence/30773991/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "IF resulted in mammalian target of rapamycin inhibition and nuclear translocation of TFEB with restored lysosome abundance and autophagic flux; and reduced aggregates with normalized desmin localization." .

<http://example.org/locx/sentence/30889901/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30889901/S4/position>,
        <http://example.org/locx/sentence/30889901/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30889901> .

<http://example.org/locx/sentence/30889901/S4/position> a oa:TextPositionSelector ;
    oa:end 1101 ;
    oa:start 736 .

<http://example.org/locx/sentence/30889901/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we demonstrate that Jurkat cell stimulation elicits TFEB nuclear translocation and an increase of both the expression of hexosaminidase subunit beta (HEXB), hexosaminidase subunit alpha (HEXA), and galactosidase beta 1 (GLB1) genes, and the recruitment of beta-hexosaminidase (Hex, EC 3.2.1.52) and beta-galactosidase (Gal, EC 3.2.1.23) on lipid microdomains." .

<http://example.org/locx/sentence/30889901/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30889901/S7/position>,
        <http://example.org/locx/sentence/30889901/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30889901> .

<http://example.org/locx/sentence/30889901/S7/position> a oa:TextPositionSelector ;
    oa:end 1680 ;
    oa:start 1499 .

<http://example.org/locx/sentence/30889901/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Together, these results clearly demonstrate the existence of a direct link between TFEB nuclear translocation and the transport of Hex and Gal from lysosomes to the plasma membrane." .

<http://example.org/locx/sentence/30894069/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30894069/S11/position>,
        <http://example.org/locx/sentence/30894069/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30894069> .

<http://example.org/locx/sentence/30894069/S11/position> a oa:TextPositionSelector ;
    oa:end 1667 ;
    oa:start 1587 .

<http://example.org/locx/sentence/30894069/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Finally, decreased TFEB nuclear staining was associated with human pancreatitis." .

<http://example.org/locx/sentence/30917316/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30917316/S6/position>,
        <http://example.org/locx/sentence/30917316/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30917316> .

<http://example.org/locx/sentence/30917316/S6/position> a oa:TextPositionSelector ;
    oa:end 1120 ;
    oa:start 922 .

<http://example.org/locx/sentence/30917316/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, a rapid reduction in cellular ATP levels in murine macrophages is observed upon lipopolysaccharide (LPS) treatment accompanied by an acute AMPK activation and TFEB nuclear localization." .

<http://example.org/locx/sentence/30924108/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30924108/S5/position>,
        <http://example.org/locx/sentence/30924108/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30924108> .

<http://example.org/locx/sentence/30924108/S5/position> a oa:TextPositionSelector ;
    oa:end 949 ;
    oa:start 686 .

<http://example.org/locx/sentence/30924108/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In the present study, we find Dynasore, a potent inhibitor of dynamin, can repress the lysosomal localization of mTOR and block the activity of mTORC1, which in turn enhances the nuclear translocation of the master regulators of autophagy including TFE3 and TFEB." .

<http://example.org/locx/sentence/30979895/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/30979895/S6/position>,
        <http://example.org/locx/sentence/30979895/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/30979895> .

<http://example.org/locx/sentence/30979895/S6/position> a oa:TextPositionSelector ;
    oa:end 762 ;
    oa:start 569 .

<http://example.org/locx/sentence/30979895/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "BRAFi disrupts TFEB phosphorylation, allowing its nuclear translocation, which is synergized by increased phosphorylation/inactivation of the ZKSCAN3 transcriptional repressor by JNK2/p38-MAPK." .

<http://example.org/locx/sentence/31046771/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31046771/S14/position>,
        <http://example.org/locx/sentence/31046771/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31046771> .

<http://example.org/locx/sentence/31046771/S14/position> a oa:TextPositionSelector ;
    oa:end 2132 ;
    oa:start 1882 .

<http://example.org/locx/sentence/31046771/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "Concomitantly, mTOR expression and activation declined along with its detachment from the lysosomes and its degradation by the proteasome, and with the nuclear translocation of transcription factor EB (TFEB), a transcription factor of many ATG genes." .

<http://example.org/locx/sentence/31100306/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31100306/S8/position>,
        <http://example.org/locx/sentence/31100306/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31100306> .

<http://example.org/locx/sentence/31100306/S8/position> a oa:TextPositionSelector ;
    oa:end 1037 ;
    oa:start 919 .

<http://example.org/locx/sentence/31100306/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Additionally, R5020 enhances the co-recruitment of PRB and TFEB to each other to facilitate TFEB nuclear localization." .

<http://example.org/locx/sentence/31100306/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31100306/S9/position>,
        <http://example.org/locx/sentence/31100306/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31100306> .

<http://example.org/locx/sentence/31100306/S9/position> a oa:TextPositionSelector ;
    oa:end 1144 ;
    oa:start 1038 .

<http://example.org/locx/sentence/31100306/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Once in the nucleus, TFEB induces the expression of autophagy and lysosomal genes to potentiate autophagy." .

<http://example.org/locx/sentence/31112550/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31112550/S9/position>,
        <http://example.org/locx/sentence/31112550/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31112550> .

<http://example.org/locx/sentence/31112550/S9/position> a oa:TextPositionSelector ;
    oa:end 1178 ;
    oa:start 1030 .

<http://example.org/locx/sentence/31112550/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "In both healthy and disease human fibroblasts, Rap and rapalogs induced autophagic flux via nuclear translocation of transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/31119852/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31119852/S9/position>,
        <http://example.org/locx/sentence/31119852/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31119852> .

<http://example.org/locx/sentence/31119852/S9/position> a oa:TextPositionSelector ;
    oa:end 1437 ;
    oa:start 1238 .

<http://example.org/locx/sentence/31119852/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, SCD1 overexpression enhanced LD-lysosome fusion, increased lysosomal biogenesis and inhibited VSMC foam cell formation by activating TFEB nuclear translocation and its reporter activity." .

<http://example.org/locx/sentence/31173156/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31173156/S3/position>,
        <http://example.org/locx/sentence/31173156/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31173156> .

<http://example.org/locx/sentence/31173156/S3/position> a oa:TextPositionSelector ;
    oa:end 453 ;
    oa:start 314 .

<http://example.org/locx/sentence/31173156/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "High glucose-induced time-dependent changes in TFEB expression were identified and nuclear translocation of TFEB was observed in podocytes." .

<http://example.org/locx/sentence/31174569/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31174569/S8/position>,
        <http://example.org/locx/sentence/31174569/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31174569> .

<http://example.org/locx/sentence/31174569/S8/position> a oa:TextPositionSelector ;
    oa:end 1538 ;
    oa:start 1166 .

<http://example.org/locx/sentence/31174569/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, we observed that although it induced significant accumulation of autophagosomes, NEO212 quenched GFP-LC3 degradation, down-regulated a series of lysosome related gene expression and blocked the autophagic flux, which significantly facilitated it induced apoptosis and was largely because it inhibited the nuclear translocation of transcription factor EB (EB)." .

<http://example.org/locx/sentence/31383732/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31383732/S11/position>,
        <http://example.org/locx/sentence/31383732/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31383732> .

<http://example.org/locx/sentence/31383732/S11/position> a oa:TextPositionSelector ;
    oa:end 1322 ;
    oa:start 1198 .

<http://example.org/locx/sentence/31383732/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB bound to PD-L1 promoter in RCCs and inhibition of mTOR led to enhanced TFEB nuclear translocation and PD-L1 expression." .

<http://example.org/locx/sentence/31401659/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31401659/S8/position>,
        <http://example.org/locx/sentence/31401659/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31401659> .

<http://example.org/locx/sentence/31401659/S8/position> a oa:TextPositionSelector ;
    oa:end 1233 ;
    oa:start 922 .

<http://example.org/locx/sentence/31401659/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "hADSC CM did not compromise lysosomal acidification; however, it was able to activate mTORC1 signaling and, as a consequence, led to a decrease in the nuclear translocation of TFEB, a master transcriptional regulator of lysosomal biogenesis and autophagy, thereby contributing to a defective autophagic process." .

<http://example.org/locx/sentence/31413743/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31413743/S7/position>,
        <http://example.org/locx/sentence/31413743/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31413743> .

<http://example.org/locx/sentence/31413743/S7/position> a oa:TextPositionSelector ;
    oa:end 1023 ;
    oa:start 762 .

<http://example.org/locx/sentence/31413743/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Specifically, DHM induced TFEB(Ser142) de-phosphorylation, activated TFEB nuclear translocation and increased of TFEB reporter activity, which contributed to the expression of autophagy-related genes and subsequent initiated autophagic cell death in A431 cells." .

<http://example.org/locx/sentence/31508418/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31508418/S7/position>,
        <http://example.org/locx/sentence/31508418/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31508418> .

<http://example.org/locx/sentence/31508418/S7/position> a oa:TextPositionSelector ;
    oa:end 887 ;
    oa:start 750 .

<http://example.org/locx/sentence/31508418/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, proteasome impairment not only promotes TFEB accumulation but also facilitates its dephosphorylation and nuclear translocation." .

<http://example.org/locx/sentence/31520816/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31520816/S9/position>,
        <http://example.org/locx/sentence/31520816/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31520816> .

<http://example.org/locx/sentence/31520816/S9/position> a oa:TextPositionSelector ;
    oa:end 1394 ;
    oa:start 1178 .

<http://example.org/locx/sentence/31520816/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, formononetin activated adenosine monophosphate activated protein kinase (AMPK) and promoted subsequent nuclear translocation of transcription factor EB (TFEB), a key regulator of lysosome biogenesis." .

<http://example.org/locx/sentence/31522191/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31522191/S8/position>,
        <http://example.org/locx/sentence/31522191/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31522191> .

<http://example.org/locx/sentence/31522191/S8/position> a oa:TextPositionSelector ;
    oa:end 1239 ;
    oa:start 1017 .

<http://example.org/locx/sentence/31522191/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, we showed that trehalose's autophagy augmentation is mediated by activation and nuclear translocation of TFEB, which may be due to inhibition of Akt and activation of the AMPK-SKP2-CARM1 signaling pathway." .

<http://example.org/locx/sentence/31546610/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31546610/S8/position>,
        <http://example.org/locx/sentence/31546610/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31546610> .

<http://example.org/locx/sentence/31546610/S8/position> a oa:TextPositionSelector ;
    oa:end 1249 ;
    oa:start 1009 .

<http://example.org/locx/sentence/31546610/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Consistently with the fact that mTOR signaling may impair ALP, we observed, an increase in DCM activation, together with a reduction in the nuclear localization of Transcription Factor EB -TFEB- (a master regulator of lysosomal biogenesis)." .

<http://example.org/locx/sentence/31558022/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31558022/S1/position>,
        <http://example.org/locx/sentence/31558022/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31558022> .

<http://example.org/locx/sentence/31558022/S1/position> a oa:TextPositionSelector ;
    oa:end 152 ;
    oa:start 0 .

<http://example.org/locx/sentence/31558022/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Polystyrene Nanoparticles Reduced ROS and Inhibited Ferroptosis by Triggering Lysosome Stress and TFEB Nucleus Translocation in a Size-Dependent Manner." .

<http://example.org/locx/sentence/31558022/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31558022/S3/position>,
        <http://example.org/locx/sentence/31558022/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31558022> .

<http://example.org/locx/sentence/31558022/S3/position> a oa:TextPositionSelector ;
    oa:end 569 ;
    oa:start 325 .

<http://example.org/locx/sentence/31558022/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Here we demonstrate for the first time that carboxyl-modified polystyrene nanoparticles (CPS) could effectively inhibit ferroptosis as a result of reduced cellular ROS which was triggered by transcription factor EB (TFEB) nucleus translocation." .

<http://example.org/locx/sentence/31558022/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31558022/S6/position>,
        <http://example.org/locx/sentence/31558022/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31558022> .

<http://example.org/locx/sentence/31558022/S6/position> a oa:TextPositionSelector ;
    oa:end 1060 ;
    oa:start 936 .

<http://example.org/locx/sentence/31558022/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "The lysosome stress induced deactivation of mammalian target of rapamycin (mTOR) which led to nucleus translocation of TFEB." .

<http://example.org/locx/sentence/31609086/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31609086/S7/position>,
        <http://example.org/locx/sentence/31609086/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31609086> .

<http://example.org/locx/sentence/31609086/S7/position> a oa:TextPositionSelector ;
    oa:end 975 ;
    oa:start 849 .

<http://example.org/locx/sentence/31609086/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "3,4-DC stimulated the translocation of TFEB and TFE3 into nuclei both in vitro and in vivo, in hepatocytes and cardiomyocytes." .

<http://example.org/locx/sentence/31609760/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31609760/S9/position>,
        <http://example.org/locx/sentence/31609760/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31609760> .

<http://example.org/locx/sentence/31609760/S9/position> a oa:TextPositionSelector ;
    oa:end 1025 ;
    oa:start 859 .

<http://example.org/locx/sentence/31609760/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "This inhibitory interaction prevents the dephosphorylation and nucleus translocation of TFEB, which hampers the transcriptional activation of autophagy-related genes." .

<http://example.org/locx/sentence/31637311/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31637311/S6/position>,
        <http://example.org/locx/sentence/31637311/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31637311> .

<http://example.org/locx/sentence/31637311/S6/position> a oa:TextPositionSelector ;
    oa:end 931 ;
    oa:start 738 .

<http://example.org/locx/sentence/31637311/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Higher cytosolic calcium levels promote the nuclear translocation of the master regulator of lysosomes TFEB, preventing the formation of tubules and the clearance of cholesterol from lysosomes." .

<http://example.org/locx/sentence/31738957/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31738957/S12/position>,
        <http://example.org/locx/sentence/31738957/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31738957> .

<http://example.org/locx/sentence/31738957/S12/position> a oa:TextPositionSelector ;
    oa:end 2132 ;
    oa:start 1954 .

<http://example.org/locx/sentence/31738957/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "CONCLUSIONS: In skeletal muscle, GSK-3beta inactivation causes dephosphorylation and nuclear translocation of TFEB resulting in TFEB-dependent induction of Pgc-1alpha expression." .

<http://example.org/locx/sentence/31738957/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31738957/S9/position>,
        <http://example.org/locx/sentence/31738957/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31738957> .

<http://example.org/locx/sentence/31738957/S9/position> a oa:TextPositionSelector ;
    oa:end 1626 ;
    oa:start 1453 .

<http://example.org/locx/sentence/31738957/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Interestingly, GSK-3beta inactivation activated transcription factor EB (TFEB), evidenced by decreased phosphorylation and enhanced nuclear localization of the TFEB protein." .

<http://example.org/locx/sentence/31818957/S7/position> a oa:TextPositionSelector ;
    oa:end 1258 ;
    oa:start 1101 .

<http://example.org/locx/sentence/31818957/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "During infection with C. burnetii, both TFEB and TFE3 were activated, as demonstrated by the transport of these proteins from the cytoplasm into the nucleus." .

<http://example.org/locx/sentence/31818957/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31818957/S8/position>,
        <http://example.org/locx/sentence/31818957/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31818957> .

<http://example.org/locx/sentence/31818957/S8/position> a oa:TextPositionSelector ;
    oa:end 1429 ;
    oa:start 1259 .

<http://example.org/locx/sentence/31818957/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "The nuclear translocation of these transcription factors was shown to be dependent on the T4SS, as a Dot/Icm mutant showed reduced nuclear translocation of TFEB and TFE3." .

<http://example.org/locx/sentence/31818957/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31818957/S9/position>,
        <http://example.org/locx/sentence/31818957/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31818957> .

<http://example.org/locx/sentence/31818957/S9/position> a oa:TextPositionSelector ;
    oa:end 1591 ;
    oa:start 1430 .

<http://example.org/locx/sentence/31818957/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "This was supported by the observation that blocking bacterial translation with chloramphenicol resulted in the movement of TFEB and TFE3 back into the cytoplasm." .

<http://example.org/locx/sentence/31820786/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31820786/S7/position>,
        <http://example.org/locx/sentence/31820786/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31820786> .

<http://example.org/locx/sentence/31820786/S7/position> a oa:TextPositionSelector ;
    oa:end 855 ;
    oa:start 763 .

<http://example.org/locx/sentence/31820786/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In TNBC cells, TFEB was hypo-phosphorylated and localized to the nucleus upon DOX treatment." .

<http://example.org/locx/sentence/31822666/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31822666/S2/position>,
        <http://example.org/locx/sentence/31822666/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31822666> .

<http://example.org/locx/sentence/31822666/S2/position> a oa:TextPositionSelector ;
    oa:end 360 ;
    oa:start 114 .

<http://example.org/locx/sentence/31822666/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "The lysosomal calcium channel TRPML1, whose mutations cause the lysosomal storage disorder (LSD) mucolipidosis type IV (MLIV), contributes to upregulate autophagic genes by inducing the nuclear translocation of the transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/31826695/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31826695/S5/position>,
        <http://example.org/locx/sentence/31826695/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31826695> .

<http://example.org/locx/sentence/31826695/S5/position> a oa:TextPositionSelector ;
    oa:end 966 ;
    oa:start 735 .

<http://example.org/locx/sentence/31826695/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Oxidation promotes the nuclear translocation of these MiT-TFE transcription factors by inhibiting the association of them with RRAG GTPases, which in turn leads to enhanced global gene expression level in autophagy-lysosome system." .

<http://example.org/locx/sentence/31856641/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31856641/S10/position>,
        <http://example.org/locx/sentence/31856641/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31856641> .

<http://example.org/locx/sentence/31856641/S10/position> a oa:TextPositionSelector ;
    oa:end 1481 ;
    oa:start 1326 .

<http://example.org/locx/sentence/31856641/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Autophagy-deficient human EVTs exhibited poor TFEB nuclear translocation, reduced lysosomal protein expression and function, and increased MTORC1 activity." .

<http://example.org/locx/sentence/31856641/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31856641/S6/position>,
        <http://example.org/locx/sentence/31856641/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31856641> .

<http://example.org/locx/sentence/31856641/S6/position> a oa:TextPositionSelector ;
    oa:end 932 ;
    oa:start 738 .

<http://example.org/locx/sentence/31856641/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Primary human trophoblasts and immortalized extravillous trophoblasts (EVTs) showed reduced TFEB expression and nuclear translocation as well as lysosomal protein content in response to hypoxia." .

<http://example.org/locx/sentence/31856641/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31856641/S7/position>,
        <http://example.org/locx/sentence/31856641/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31856641> .

<http://example.org/locx/sentence/31856641/S7/position> a oa:TextPositionSelector ;
    oa:end 1107 ;
    oa:start 933 .

<http://example.org/locx/sentence/31856641/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Hypoxia-exposed trophoblasts also showed decreased PPP3/calcineurin phosphatase activity and increased XPO1/CRM1 (exportin 1), events that inhibit TFEB nuclear translocation." .

<http://example.org/locx/sentence/31947839/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31947839/S3/position>,
        <http://example.org/locx/sentence/31947839/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31947839> .

<http://example.org/locx/sentence/31947839/S3/position> a oa:TextPositionSelector ;
    oa:end 571 ;
    oa:start 306 .

<http://example.org/locx/sentence/31947839/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Only recently has it been shown that lysosomal sequestration of weak base drugs induces lysosomal biogenesis mediated by activation of transcription factor EB (TFEB) which, in turn, enhances their accumulation capacity, thereby increasing resistance to these drugs." .

<http://example.org/locx/sentence/31947943/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31947943/S5/position>,
        <http://example.org/locx/sentence/31947943/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31947943> .

<http://example.org/locx/sentence/31947943/S5/position> a oa:TextPositionSelector ;
    oa:end 676 ;
    oa:start 543 .

<http://example.org/locx/sentence/31947943/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Induction of autophagy and lysosomal biogenesis by transcription factor EB (TFEB) nuclear translocation can rescue fibrotic diseases." .

<http://example.org/locx/sentence/31947943/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31947943/S7/position>,
        <http://example.org/locx/sentence/31947943/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31947943> .

<http://example.org/locx/sentence/31947943/S7/position> a oa:TextPositionSelector ;
    oa:end 865 ;
    oa:start 728 .

<http://example.org/locx/sentence/31947943/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In this study, we found that CS induced TFEB nuclear localization and increased TFEB expression in macrophages both in vivo and in vitro." .

<http://example.org/locx/sentence/31987928/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31987928/S6/position>,
        <http://example.org/locx/sentence/31987928/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31987928> .

<http://example.org/locx/sentence/31987928/S6/position> a oa:TextPositionSelector ;
    oa:end 1212 ;
    oa:start 1015 .

<http://example.org/locx/sentence/31987928/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "While Gao-binge alcohol increased the number of autophagosomes, it also concurrently inhibited TFEB nuclear translocation and TFEB-mediated lysosomal biogenesis resulting in insufficient autophagy." .

<http://example.org/locx/sentence/31987928/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/31987928/S9/position>,
        <http://example.org/locx/sentence/31987928/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/31987928> .

<http://example.org/locx/sentence/31987928/S9/position> a oa:TextPositionSelector ;
    oa:end 1676 ;
    oa:start 1540 .

<http://example.org/locx/sentence/31987928/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "In line with our findings in mice, decreased LAMP1 and TFEB nuclear staining were also observed in human alcoholic pancreatitis tissues." .

<http://example.org/locx/sentence/32037305/S6/position> a oa:TextPositionSelector ;
    oa:end 996 ;
    oa:start 778 .

<http://example.org/locx/sentence/32037305/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Unexpectedly, we found that only SB202190, rather than several other p38 inhibitors, promotes TFEB and TFE3 to translocate from the cytosol into the nucleus and subsequently enhances autophagy and lysosomal biogenesis." .

<http://example.org/locx/sentence/32042327/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32042327/S9/position>,
        <http://example.org/locx/sentence/32042327/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32042327> .

<http://example.org/locx/sentence/32042327/S9/position> a oa:TextPositionSelector ;
    oa:end 1293 ;
    oa:start 1134 .

<http://example.org/locx/sentence/32042327/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Specifically, they stimulated the transient nuclear accumulation of TFEB and Nrf2, transcription factors that promote lysosome biogenesis and stress responses." .

<http://example.org/locx/sentence/32079455/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32079455/S7/position>,
        <http://example.org/locx/sentence/32079455/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32079455> .

<http://example.org/locx/sentence/32079455/S7/position> a oa:TextPositionSelector ;
    oa:end 940 ;
    oa:start 812 .

<http://example.org/locx/sentence/32079455/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Trehalose, we delineate, activates PIKFYVE leading to TFEB nuclear translocation in MCOLN1-dependent manner to induce autophagy." .

<http://example.org/locx/sentence/32098449/S5/position> a oa:TextPositionSelector ;
    oa:end 631 ;
    oa:start 496 .

<http://example.org/locx/sentence/32098449/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Compound E4 promoted the translocation of TFEB from cytoplasm into nucleus, accompanied by enhanced autophagy and lysosomal biogenesis." .

<http://example.org/locx/sentence/32100453/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32100453/S7/position>,
        <http://example.org/locx/sentence/32100453/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32100453> .

<http://example.org/locx/sentence/32100453/S7/position> a oa:TextPositionSelector ;
    oa:end 1226 ;
    oa:start 911 .

<http://example.org/locx/sentence/32100453/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "We show that loss of C9orf72 leads to striking accumulation of lysosomes, autophagosomes, and autolysosomes in cells, which is associated with suppressed mTORC1 activity and enhanced nuclear translocation of MiT/TFE family members MITF, TFE3, and TFEB, three master regulators of lysosomal biogenesis and autophagy." .

<http://example.org/locx/sentence/32130941/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32130941/S7/position>,
        <http://example.org/locx/sentence/32130941/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32130941> .

<http://example.org/locx/sentence/32130941/S7/position> a oa:TextPositionSelector ;
    oa:end 910 ;
    oa:start 690 .

<http://example.org/locx/sentence/32130941/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "THZ-P1-2 causes autophagosome clearance defects and upregulation in TFEB nuclear localization and target genes, disrupting autophagy in a covalent-dependent manner and phenocopying the effects of PI5P4K genetic deletion." .

<http://example.org/locx/sentence/32138578/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32138578/S7/position>,
        <http://example.org/locx/sentence/32138578/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32138578> .

<http://example.org/locx/sentence/32138578/S7/position> a oa:TextPositionSelector ;
    oa:end 1103 ;
    oa:start 910 .

<http://example.org/locx/sentence/32138578/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "SFN induces TFEB nuclear translocation via a Ca2+-dependent but MTOR (mechanistic target of rapamycin kinase)-independent mechanism through a moderate increase in reactive oxygen species (ROS)." .

<http://example.org/locx/sentence/32194992/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32194992/S8/position>,
        <http://example.org/locx/sentence/32194992/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32194992> .

<http://example.org/locx/sentence/32194992/S8/position> a oa:TextPositionSelector ;
    oa:end 1140 ;
    oa:start 992 .

<http://example.org/locx/sentence/32194992/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Increase in lysosomal content was associated with nuclear translocation of the Transcription Factor EB (TFEB) and upregulation of TFEB target genes." .

<http://example.org/locx/sentence/32282804/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32282804/S5/position>,
        <http://example.org/locx/sentence/32282804/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32282804> .

<http://example.org/locx/sentence/32282804/S5/position> a oa:TextPositionSelector ;
    oa:end 832 ;
    oa:start 609 .

<http://example.org/locx/sentence/32282804/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Loss of the C. elegans orthologue of C9orf72, ALFA-1, causes the nuclear translocation of HLH-30/TFEB, leading to activation of lipolysis and premature lethality during starvation-induced developmental arrest in C. elegans." .

<http://example.org/locx/sentence/32282804/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32282804/S7/position>,
        <http://example.org/locx/sentence/32282804/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32282804> .

<http://example.org/locx/sentence/32282804/S7/position> a oa:TextPositionSelector ;
    oa:end 1110 ;
    oa:start 936 .

<http://example.org/locx/sentence/32282804/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "C9orf72 interacts with and dynamically regulates the level of Rag GTPases, which are responsible for the recruitment of mTOR and TFEB on the lysosome upon amino acid signals." .

<http://example.org/locx/sentence/32295849/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32295849/S7/position>,
        <http://example.org/locx/sentence/32295849/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32295849> .

<http://example.org/locx/sentence/32295849/S7/position> a oa:TextPositionSelector ;
    oa:end 908 ;
    oa:start 768 .

<http://example.org/locx/sentence/32295849/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Consistent with inhibited mTORC1, an increase in nuclear TFEB localization and lysosome biogenesis is also observed in Rab32-depleted cells." .

<http://example.org/locx/sentence/32440476/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32440476/S7/position>,
        <http://example.org/locx/sentence/32440476/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32440476> .

<http://example.org/locx/sentence/32440476/S7/position> a oa:TextPositionSelector ;
    oa:end 1153 ;
    oa:start 964 .

<http://example.org/locx/sentence/32440476/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "ESC-sEVs rejuvenate H-NSCs senescence partly by transferring these miRNAs to inhibit mTORC1 activation, promote transcription factor EB (TFEB) nuclear translocation and lysosome resumption." .

<http://example.org/locx/sentence/32440476/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32440476/S9/position>,
        <http://example.org/locx/sentence/32440476/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32440476> .

<http://example.org/locx/sentence/32440476/S9/position> a oa:TextPositionSelector ;
    oa:end 1532 ;
    oa:start 1291 .

<http://example.org/locx/sentence/32440476/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "ESC-sEVs treatment ameliorates H-NSCs senescence by inhibiting mTORC1 activation, and promoting TFEB nuclear translocation and lysosome resumption, thereby reversing senescence-related neurogenesis dysfunction and cognitive impairment in VD." .

<http://example.org/locx/sentence/32575830/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32575830/S8/position>,
        <http://example.org/locx/sentence/32575830/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32575830> .

<http://example.org/locx/sentence/32575830/S8/position> a oa:TextPositionSelector ;
    oa:end 1194 ;
    oa:start 942 .

<http://example.org/locx/sentence/32575830/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Specifically, heterologously expressed STIM1 mutations in the non-canonical EF-hand promoted translocation of the autophagy transcription factors microphthalmia-associated transcription factor (MITF) and transcription factor EB (TFEB) into the nucleus." .

<http://example.org/locx/sentence/32601373/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32601373/S4/position>,
        <http://example.org/locx/sentence/32601373/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32601373> .

<http://example.org/locx/sentence/32601373/S4/position> a oa:TextPositionSelector ;
    oa:end 543 ;
    oa:start 391 .

<http://example.org/locx/sentence/32601373/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear translocation and activation of TFEB are induced by a variety of conditions such as starvation, lysosome stress and lysosomal storage disorders." .

<http://example.org/locx/sentence/32608399/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32608399/S6/position>,
        <http://example.org/locx/sentence/32608399/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32608399> .

<http://example.org/locx/sentence/32608399/S6/position> a oa:TextPositionSelector ;
    oa:end 1002 ;
    oa:start 768 .

<http://example.org/locx/sentence/32608399/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "ZIF-8 also caused dephosphorylation of the transcription factor EB (TFEB) at serine-142 and serine-211, leading to the nucleus translocation of TFEB, an event that promoted lysosome biogenesis and is necessary for autophagy induction." .

<http://example.org/locx/sentence/32621922/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32621922/S11/position>,
        <http://example.org/locx/sentence/32621922/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32621922> .

<http://example.org/locx/sentence/32621922/S11/position> a oa:TextPositionSelector ;
    oa:end 989 ;
    oa:start 906 .

<http://example.org/locx/sentence/32621922/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "RESULTS: Tre induced localization of TFEB to the nucleus in the AMs of both groups." .

<http://example.org/locx/sentence/32622269/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32622269/S4/position>,
        <http://example.org/locx/sentence/32622269/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32622269> .

<http://example.org/locx/sentence/32622269/S4/position> a oa:TextPositionSelector ;
    oa:end 531 ;
    oa:start 333 .

<http://example.org/locx/sentence/32622269/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "The homeostasis of amino acids in eukaryotic cells is regulated by the transcription factor EB (TFEB), which translocates into the nucleus and activates genes for autophagy and lysosomal biogenesis." .

<http://example.org/locx/sentence/32622269/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32622269/S5/position>,
        <http://example.org/locx/sentence/32622269/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32622269> .

<http://example.org/locx/sentence/32622269/S5/position> a oa:TextPositionSelector ;
    oa:end 755 ;
    oa:start 532 .

<http://example.org/locx/sentence/32622269/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here we show that the Legionella effector SetA causes a robust nuclear translocation of TFEB when exogenously expressed in mammalian cells and that the translocation is dependent on the glucosyltransferase activity of SetA." .

<http://example.org/locx/sentence/32623920/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32623920/S2/position>,
        <http://example.org/locx/sentence/32623920/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32623920> .

<http://example.org/locx/sentence/32623920/S2/position> a oa:TextPositionSelector ;
    oa:end 314 ;
    oa:start 137 .

<http://example.org/locx/sentence/32623920/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "The translocation of transcription factor EB (TFEB) to the nucleus plays a pivotal role in the regulation of basic cellular processes, such as lysosome biogenesis and autophagy." .

<http://example.org/locx/sentence/32640907/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32640907/S6/position>,
        <http://example.org/locx/sentence/32640907/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32640907> .

<http://example.org/locx/sentence/32640907/S6/position> a oa:TextPositionSelector ;
    oa:end 868 ;
    oa:start 617 .

<http://example.org/locx/sentence/32640907/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Western blotting and immunofluorescent staining showed that nicotine inhibited the mTORC1 (mammalian target of rapamycin complex 1) activity, promoted the nuclear translocation of TFEB (transcription factor EB), and upregulated the expression of CTSS." .

<http://example.org/locx/sentence/32662822/S5/position> a oa:TextPositionSelector ;
    oa:end 647 ;
    oa:start 510 .

<http://example.org/locx/sentence/32662822/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "CDK4/6 interact with and phosphorylate TFEB/TFE3 in the nucleus, thereby inactivating them by promoting their shuttling to the cytoplasm." .

<http://example.org/locx/sentence/32681035/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32681035/S6/position>,
        <http://example.org/locx/sentence/32681035/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32681035> .

<http://example.org/locx/sentence/32681035/S6/position> a oa:TextPositionSelector ;
    oa:end 885 ;
    oa:start 575 .

<http://example.org/locx/sentence/32681035/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, we find that cholesterol-induced lysosomal stress feed-forward activates TFEB via promoting TFEB nuclear translocation, while bile acid-induced fibroblast growth factor 19 (FGF19), acting via mTOR/ERK signaling and TFEB phosphorylation, feedback inhibits TFEB nuclear translocation in hepatocytes." .

<http://example.org/locx/sentence/32681035/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32681035/S7/position>,
        <http://example.org/locx/sentence/32681035/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32681035> .

<http://example.org/locx/sentence/32681035/S7/position> a oa:TextPositionSelector ;
    oa:end 1124 ;
    oa:start 886 .

<http://example.org/locx/sentence/32681035/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Consistently, blocking intestinal bile acid uptake by an apical sodium-bile acid transporter (ASBT) inhibitor decreases ileal FGF15, enhances hepatic TFEB nuclear localization and improves cholesterol homeostasis in Western diet-fed mice." .

<http://example.org/locx/sentence/32753672/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32753672/S4/position>,
        <http://example.org/locx/sentence/32753672/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32753672> .

<http://example.org/locx/sentence/32753672/S4/position> a oa:TextPositionSelector ;
    oa:end 447 ;
    oa:start 365 .

<http://example.org/locx/sentence/32753672/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "IRGM directly interacted with TFEB and promoted the nuclear translocation of TFEB." .

<http://example.org/locx/sentence/32785678/S13/position> a oa:TextPositionSelector ;
    oa:end 1692 ;
    oa:start 1580 .

<http://example.org/locx/sentence/32785678/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "Trehalose further activated TFEB, with translocation from cytoplasm to the nucleus, but diminished Akt activity." .

<http://example.org/locx/sentence/32807902/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32807902/S8/position>,
        <http://example.org/locx/sentence/32807902/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32807902> .

<http://example.org/locx/sentence/32807902/S8/position> a oa:TextPositionSelector ;
    oa:end 1071 ;
    oa:start 937 .

<http://example.org/locx/sentence/32807902/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "This is associated with cytoplasmic sequestration of TFEB, preventing induction of the lysosomal genes required for lysosome function." .

<http://example.org/locx/sentence/32839434/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32839434/S10/position>,
        <http://example.org/locx/sentence/32839434/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32839434> .

<http://example.org/locx/sentence/32839434/S10/position> a oa:TextPositionSelector ;
    oa:end 1208 ;
    oa:start 1077 .

<http://example.org/locx/sentence/32839434/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, anlotinib treatment activates TFEB, a key nuclear transcription factor that controls lysosome biogenesis and function." .

<http://example.org/locx/sentence/32839434/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32839434/S11/position>,
        <http://example.org/locx/sentence/32839434/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32839434> .

<http://example.org/locx/sentence/32839434/S11/position> a oa:TextPositionSelector ;
    oa:end 1321 ;
    oa:start 1209 .

<http://example.org/locx/sentence/32839434/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that anlotinib treatment promotes TFEB nuclear translocation and enhances its transcriptional activity." .

<http://example.org/locx/sentence/32950675/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32950675/S1/position>,
        <http://example.org/locx/sentence/32950675/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32950675> .

<http://example.org/locx/sentence/32950675/S1/position> a oa:TextPositionSelector ;
    oa:end 108 ;
    oa:start 0 .

<http://example.org/locx/sentence/32950675/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "The anti-tumor agent, Dp44mT, promotes nuclear translocation of TFEB via inhibition of the AMPK-mTORC1 axis." .

<http://example.org/locx/sentence/32950675/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32950675/S5/position>,
        <http://example.org/locx/sentence/32950675/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32950675> .

<http://example.org/locx/sentence/32950675/S5/position> a oa:TextPositionSelector ;
    oa:end 771 ;
    oa:start 670 .

<http://example.org/locx/sentence/32950675/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "For the first time, this study demonstrated that Dp44mT induces translocation of TFEB to the nucleus." .

<http://example.org/locx/sentence/32950675/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32950675/S6/position>,
        <http://example.org/locx/sentence/32950675/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32950675> .

<http://example.org/locx/sentence/32950675/S6/position> a oa:TextPositionSelector ;
    oa:end 850 ;
    oa:start 772 .

<http://example.org/locx/sentence/32950675/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, Dp44mT-mediated nuclear translocation of TFEB was AMPK-dependent." .

<http://example.org/locx/sentence/32960686/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/32960686/S4/position>,
        <http://example.org/locx/sentence/32960686/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/32960686> .

<http://example.org/locx/sentence/32960686/S4/position> a oa:TextPositionSelector ;
    oa:end 737 ;
    oa:start 476 .

<http://example.org/locx/sentence/32960686/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Through increasing PPP3/calcineurin activity and inhibiting MTOR signaling, PSMI promotes the dephosphorylation and thereby nuclear translocation of TFEB, resulting in transactivation of genes in the autophagic-lysosomal pathway (ALP) such as Mcoln1 and Sqstm1." .

<http://example.org/locx/sentence/33016184/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33016184/S7/position>,
        <http://example.org/locx/sentence/33016184/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33016184> .

<http://example.org/locx/sentence/33016184/S7/position> a oa:TextPositionSelector ;
    oa:end 984 ;
    oa:start 777 .

<http://example.org/locx/sentence/33016184/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Therefore, CDKN1B represses MTORC1 activity, leading to nuclear translocation of the transcription factor TFEB and activation of lysosomal function, enhancing starvation-induced autophagy flux and apoptosis." .

<http://example.org/locx/sentence/33070669/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33070669/S6/position>,
        <http://example.org/locx/sentence/33070669/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33070669> .

<http://example.org/locx/sentence/33070669/S6/position> a oa:TextPositionSelector ;
    oa:end 731 ;
    oa:start 645 .

<http://example.org/locx/sentence/33070669/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "mAtg8s promote TFEB's nuclear translocation in response to stimuli such as starvation." .

<http://example.org/locx/sentence/33070669/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33070669/S8/position>,
        <http://example.org/locx/sentence/33070669/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33070669> .

<http://example.org/locx/sentence/33070669/S8/position> a oa:TextPositionSelector ;
    oa:end 1301 ;
    oa:start 948 .

<http://example.org/locx/sentence/33070669/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "We furthermore show that GABARAPs in cooperation with other proteins, IRGM, a factor implicated in tuberculosis and Crohn disease, and STX17, are required during starvation for optimal inhibition of MTOR, an upstream kinase of TFEB, and activation of the PPP3/calcineurin phosphatase that dephosphorylates TFEB, thus promoting its nuclear translocation." .

<http://example.org/locx/sentence/33100324/S3/position> a oa:TextPositionSelector ;
    oa:end 358 ;
    oa:start 177 .

<http://example.org/locx/sentence/33100324/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "The post-translational phosphorylation modulations of TFEB by mTOR and ERK signaling can determine its nucleocytoplasmic shuttling and activity in response to nutrient availability." .

<http://example.org/locx/sentence/33100324/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33100324/S5/position>,
        <http://example.org/locx/sentence/33100324/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33100324> .

<http://example.org/locx/sentence/33100324/S5/position> a oa:TextPositionSelector ;
    oa:end 579 ;
    oa:start 429 .

<http://example.org/locx/sentence/33100324/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we found that programmed cell death 4 (PDCD4), a tumor suppressor, decreased levels of nuclear TFEB to inhibit lysosome biogenesis and function." .

<http://example.org/locx/sentence/33145177/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33145177/S6/position>,
        <http://example.org/locx/sentence/33145177/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33145177> .

<http://example.org/locx/sentence/33145177/S6/position> a oa:TextPositionSelector ;
    oa:end 759 ;
    oa:start 594 .

<http://example.org/locx/sentence/33145177/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Pathological findings revealed 6p21 translocation RCC based on diffuse nuclear immunoreactivity for TFEB and TFEB gene rearrangement in tumor cells by FISH analysis." .

<http://example.org/locx/sentence/33163944/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33163944/S5/position>,
        <http://example.org/locx/sentence/33163944/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33163944> .

<http://example.org/locx/sentence/33163944/S5/position> a oa:TextPositionSelector ;
    oa:end 684 ;
    oa:start 450 .

<http://example.org/locx/sentence/33163944/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we show that under pharmacological and genetic c-Abl inhibition, TFEB translocates into the nucleus promoting the expression of its target genes independently of its well-known regulator, mammalian target of rapamycin complex 1." .

<http://example.org/locx/sentence/33172973/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33172973/S3/position>,
        <http://example.org/locx/sentence/33172973/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33172973> .

<http://example.org/locx/sentence/33172973/S3/position> a oa:TextPositionSelector ;
    oa:end 405 ;
    oa:start 255 .

<http://example.org/locx/sentence/33172973/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Lysosomotropic agents have also been shown to activate master lysosomal biogenesis transcription factor EB (TFEB) and ultimately lysosomal biogenesis." .

<http://example.org/locx/sentence/33176151/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33176151/S4/position>,
        <http://example.org/locx/sentence/33176151/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33176151> .

<http://example.org/locx/sentence/33176151/S4/position> a oa:TextPositionSelector ;
    oa:end 650 ;
    oa:start 454 .

<http://example.org/locx/sentence/33176151/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "We reveal that steady-state nuclear TFEB is sufficient to activate transcription of lysosomal, autophagy, and innate immunity genes, whereas other targets require higher thresholds of stimulation." .

<http://example.org/locx/sentence/33212310/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33212310/S6/position>,
        <http://example.org/locx/sentence/33212310/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33212310> .

<http://example.org/locx/sentence/33212310/S6/position> a oa:TextPositionSelector ;
    oa:end 1027 ;
    oa:start 805 .

<http://example.org/locx/sentence/33212310/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In addition, compounds 1 and 3 could promote the nuclear translocation of TFEB, a master transcriptional factor of lysosomal genes, indicating that compounds 1 and 3 induced lysosomal biogenesis through activation of TFEB." .

<http://example.org/locx/sentence/33290695/S4/position> a oa:TextPositionSelector ;
    oa:end 634 ;
    oa:start 459 .

<http://example.org/locx/sentence/33290695/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Cytoplasmic-nuclear trafficking of TFEB, a well-characterized mechanism by which diverse signaling pathways regulate TFEB activity, is not evidently altered by IPMK depletion." .

<http://example.org/locx/sentence/33290695/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33290695/S5/position>,
        <http://example.org/locx/sentence/33290695/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33290695> .

<http://example.org/locx/sentence/33290695/S5/position> a oa:TextPositionSelector ;
    oa:end 774 ;
    oa:start 635 .

<http://example.org/locx/sentence/33290695/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We demonstrated that nuclear TFEB forms distinct puncta that colocalize with the Mediator complex and with mRNAs of target lysosomal genes." .

<http://example.org/locx/sentence/33290695/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33290695/S8/position>,
        <http://example.org/locx/sentence/33290695/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33290695> .

<http://example.org/locx/sentence/33290695/S8/position> a oa:TextPositionSelector ;
    oa:end 1031 ;
    oa:start 897 .

<http://example.org/locx/sentence/33290695/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Depletion of IPMK increases the number of nuclear TFEB puncta and the co-localization of TFEB with Mediator and mRNAs of target genes." .

<http://example.org/locx/sentence/33300868/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33300868/S6/position>,
        <http://example.org/locx/sentence/33300868/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33300868> .

<http://example.org/locx/sentence/33300868/S6/position> a oa:TextPositionSelector ;
    oa:end 976 ;
    oa:start 830 .

<http://example.org/locx/sentence/33300868/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "These phenotypes are partially caused by cytoplasmic mislocalization of Mitf/TFEB, a key transcriptional regulator of autophagolysosomal function." .

<http://example.org/locx/sentence/33300868/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33300868/S7/position>,
        <http://example.org/locx/sentence/33300868/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33300868> .

<http://example.org/locx/sentence/33300868/S7/position> a oa:TextPositionSelector ;
    oa:end 1106 ;
    oa:start 977 .

<http://example.org/locx/sentence/33300868/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Additionally, TFEB is mislocalized and downregulated in human cells expressing GGGGCC repeats and in C9-ALS patient motor cortex." .

<http://example.org/locx/sentence/33300868/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33300868/S8/position>,
        <http://example.org/locx/sentence/33300868/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33300868> .

<http://example.org/locx/sentence/33300868/S8/position> a oa:TextPositionSelector ;
    oa:end 1260 ;
    oa:start 1107 .

<http://example.org/locx/sentence/33300868/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Our data suggest that the C9orf72-HRE impairs Mitf/TFEB nuclear import, thereby disrupting autophagy and exacerbating proteostasis defects in C9-ALS/FTD." .

<http://example.org/locx/sentence/33318473/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33318473/S7/position>,
        <http://example.org/locx/sentence/33318473/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33318473> .

<http://example.org/locx/sentence/33318473/S7/position> a oa:TextPositionSelector ;
    oa:end 1271 ;
    oa:start 1029 .

<http://example.org/locx/sentence/33318473/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, we identified that miR-21 inhibited the activation and nuclear translocation of transcription factor EB (TFEB) through reducing the inhibitory of PTEN on AKT phosphorylation, which can directly activate the transcription of VMP1." .

<http://example.org/locx/sentence/33335227/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33335227/S9/position>,
        <http://example.org/locx/sentence/33335227/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33335227> .

<http://example.org/locx/sentence/33335227/S9/position> a oa:TextPositionSelector ;
    oa:end 1514 ;
    oa:start 1338 .

<http://example.org/locx/sentence/33335227/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, the activation of alpha7 nAChRs was found to increase the biogenesis of lysosomes by inducing translocation of the transcription factor EB (TFEB) into the nucleus." .

<http://example.org/locx/sentence/33352478/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33352478/S4/position>,
        <http://example.org/locx/sentence/33352478/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33352478> .

<http://example.org/locx/sentence/33352478/S4/position> a oa:TextPositionSelector ;
    oa:end 654 ;
    oa:start 451 .

<http://example.org/locx/sentence/33352478/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "This leads to TFEB dephosphorylation and translocation into the nucleus which results in clearance of damaged lysosomes and their contents which may reduce the deleterious effects of crystal nephropathy." .

<http://example.org/locx/sentence/33405796/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33405796/S7/position>,
        <http://example.org/locx/sentence/33405796/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33405796> .

<http://example.org/locx/sentence/33405796/S7/position> a oa:TextPositionSelector ;
    oa:end 1480 ;
    oa:start 1116 .

<http://example.org/locx/sentence/33405796/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, using in vitro transforming growth factor (TGF)-beta-induced EndMT model, we demonstrated that the cardiovascular protective effect of MoS2 QDs against EndMT acted through triggering TFEB nucleus translocation and restoring an impairment of autophagic flux, whereas genetic suppression of TFEB impaired the protective action of MoS2 QDs against EndMT." .

<http://example.org/locx/sentence/33414451/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33414451/S9/position>,
        <http://example.org/locx/sentence/33414451/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33414451> .

<http://example.org/locx/sentence/33414451/S9/position> a oa:TextPositionSelector ;
    oa:end 1573 ;
    oa:start 1282 .

<http://example.org/locx/sentence/33414451/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, we demonstrated that TRIM21, via facilitating the ANXA2 trafficking at the PM, enabled to release the transcription factor EB (TFEB, a master regulator of autophagy) from the ANXA2-TFEB complex, which in turn entered into the nucleus for the regulation of OS cell autophagy." .

<http://example.org/locx/sentence/33418500/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33418500/S5/position>,
        <http://example.org/locx/sentence/33418500/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33418500> .

<http://example.org/locx/sentence/33418500/S5/position> a oa:TextPositionSelector ;
    oa:end 765 ;
    oa:start 663 .

<http://example.org/locx/sentence/33418500/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Post-translational modifications regulate TFEB nuclear translocation and its transcriptional activity." .

<http://example.org/locx/sentence/33464298/S9/position> a oa:TextPositionSelector ;
    oa:end 1164 ;
    oa:start 1040 .

<http://example.org/locx/sentence/33464298/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "A genome-wide screen identified factors mediating TFEB relocation from the nucleus to the cytosol upon prolonged starvation." .

<http://example.org/locx/sentence/33560918/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33560918/S4/position>,
        <http://example.org/locx/sentence/33560918/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33560918> .

<http://example.org/locx/sentence/33560918/S4/position> a oa:TextPositionSelector ;
    oa:end 628 ;
    oa:start 439 .

<http://example.org/locx/sentence/33560918/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Herein, we report that cetrimonium bromide (CTAB; a quaternary ammonium compound) promotes autophagy and lysosomal biogenesis by inducing the nuclear translocation of TFEB in hepatic cells." .

<http://example.org/locx/sentence/33560918/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33560918/S8/position>,
        <http://example.org/locx/sentence/33560918/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33560918> .

<http://example.org/locx/sentence/33560918/S8/position> a oa:TextPositionSelector ;
    oa:end 1162 ;
    oa:start 982 .

<http://example.org/locx/sentence/33560918/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Collectively, our results indicate that CTAB activates the autophagosome-lysosome pathway via inducing the nuclear translocation of TFEB by inhibiting the mTORC1 signaling pathway." .

<http://example.org/locx/sentence/33605996/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33605996/S6/position>,
        <http://example.org/locx/sentence/33605996/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33605996> .

<http://example.org/locx/sentence/33605996/S6/position> a oa:TextPositionSelector ;
    oa:end 998 ;
    oa:start 776 .

<http://example.org/locx/sentence/33605996/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, RSV activates protein phosphatase 2A (PP2A), which binds and dephosphorylates TFEB, promoting its nuclear translocation and the expression of TFEB target genes required for autophagosome and lysosomal biogenesis." .

<http://example.org/locx/sentence/33639613/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33639613/S9/position>,
        <http://example.org/locx/sentence/33639613/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33639613> .

<http://example.org/locx/sentence/33639613/S9/position> a oa:TextPositionSelector ;
    oa:end 1134 ;
    oa:start 945 .

<http://example.org/locx/sentence/33639613/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that berberine promoted autophagy of peritoneal macrophages by activating SIRT1 via the NAD+ synthesis pathway and, in turn, promoting TFEB nuclear translocation and deacetylation." .

<http://example.org/locx/sentence/33642520/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33642520/S6/position>,
        <http://example.org/locx/sentence/33642520/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33642520> .

<http://example.org/locx/sentence/33642520/S6/position> a oa:TextPositionSelector ;
    oa:end 1117 ;
    oa:start 875 .

<http://example.org/locx/sentence/33642520/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In this study, we confirmed that LLOMe-induced lysosomal damage triggered nuclear translocation of TFEB/TFE3/MITF and increased the mRNA levels of their target genes encoding lysosomal hydrolases and lysosomal membrane proteins in HeLa cells." .

<http://example.org/locx/sentence/33691586/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33691586/S7/position>,
        <http://example.org/locx/sentence/33691586/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33691586> .

<http://example.org/locx/sentence/33691586/S7/position> a oa:TextPositionSelector ;
    oa:end 1301 ;
    oa:start 1090 .

<http://example.org/locx/sentence/33691586/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Assessment of TFEB transcriptional activity using a reporter construct discovered a loss of function of the cleavage fragment despite nuclear localization and retaining of the ability of DNA and protein binding." .

<http://example.org/locx/sentence/33691586/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33691586/S8/position>,
        <http://example.org/locx/sentence/33691586/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33691586> .

<http://example.org/locx/sentence/33691586/S8/position> a oa:TextPositionSelector ;
    oa:end 1486 ;
    oa:start 1302 .

<http://example.org/locx/sentence/33691586/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, we showed that CVB3 infection was also able to trigger cleavage-independent nuclear translocation of TFEB that relied on the serine-threonine phosphatase PPP3/calcineurin." .

<http://example.org/locx/sentence/33706671/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33706671/S10/position>,
        <http://example.org/locx/sentence/33706671/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33706671> .

<http://example.org/locx/sentence/33706671/S10/position> a oa:TextPositionSelector ;
    oa:end 1362 ;
    oa:start 1204 .

<http://example.org/locx/sentence/33706671/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "This leads to a low-grade lysosomal stress with mild elevation of lysosomal pH, which acts as a potent stimulus for TFEB activation and nuclear translocation." .

<http://example.org/locx/sentence/33742137/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33742137/S6/position>,
        <http://example.org/locx/sentence/33742137/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33742137> .

<http://example.org/locx/sentence/33742137/S6/position> a oa:TextPositionSelector ;
    oa:end 1004 ;
    oa:start 843 .

<http://example.org/locx/sentence/33742137/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "FASN reduction promoted translocation of transcription factor EB (TFEB) to the nucleus, paralleled by activation of CLEAR network genes and lysosomal biogenesis." .

<http://example.org/locx/sentence/33753903/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33753903/S4/position>,
        <http://example.org/locx/sentence/33753903/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33753903> .

<http://example.org/locx/sentence/33753903/S4/position> a oa:TextPositionSelector ;
    oa:end 507 ;
    oa:start 403 .

<http://example.org/locx/sentence/33753903/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB's nuclear localization and transcriptional activity are also regulated by various upstream signals." .

<http://example.org/locx/sentence/33753903/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33753903/S5/position>,
        <http://example.org/locx/sentence/33753903/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33753903> .

<http://example.org/locx/sentence/33753903/S5/position> a oa:TextPositionSelector ;
    oa:end 717 ;
    oa:start 508 .

<http://example.org/locx/sentence/33753903/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In this study, we found that Wnt signaling induces the nuclear localization of TFEB and the expression of Wnt target genes is regulated by TFEB-beta-catenin-TCF/LEF1 as well as beta-catenin-TCF/LEF1 complexes." .

<http://example.org/locx/sentence/33753903/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33753903/S6/position>,
        <http://example.org/locx/sentence/33753903/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33753903> .

<http://example.org/locx/sentence/33753903/S6/position> a oa:TextPositionSelector ;
    oa:end 927 ;
    oa:start 718 .

<http://example.org/locx/sentence/33753903/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Our biochemical data revealed that TFEB is a part of the beta-catenin destruction complex, and destabilization of the destruction complex by knockdown of either Axin or APC causes nuclear localization of TFEB." .

<http://example.org/locx/sentence/33753903/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33753903/S9/position>,
        <http://example.org/locx/sentence/33753903/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33753903> .

<http://example.org/locx/sentence/33753903/S9/position> a oa:TextPositionSelector ;
    oa:end 1398 ;
    oa:start 1179 .

<http://example.org/locx/sentence/33753903/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, we found that Tankyrase (TNKS) PARsylates TFEB with Wnt ON signaling, and the nuclear localized PARsylated TFEB forms a complex with beta-catenin-TCF/LEF1 to induce the \"TFEB mediated Wnt target genes\"." .

<http://example.org/locx/sentence/33758420/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33758420/S5/position>,
        <http://example.org/locx/sentence/33758420/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33758420> .

<http://example.org/locx/sentence/33758420/S5/position> a oa:TextPositionSelector ;
    oa:end 832 ;
    oa:start 702 .

<http://example.org/locx/sentence/33758420/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Palmitic acid induces Gdf15 expression through lysosomal Ca2+-mediated TFEB nuclear translocation in response to lysosomal stress." .

<http://example.org/locx/sentence/33818279/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33818279/S7/position>,
        <http://example.org/locx/sentence/33818279/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33818279> .

<http://example.org/locx/sentence/33818279/S7/position> a oa:TextPositionSelector ;
    oa:end 1087 ;
    oa:start 762 .

<http://example.org/locx/sentence/33818279/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "The NOX/PHOX (NADPH oxidase)-dependent oxidative burst was required for nuclear translocation of TFEB during phagocytosis of Gram-positive or -negative bacteria, and reactive oxygen species (ROS) were sufficient to trigger TFEB activation in a CD38- and NAADP (nicotinic acid adenine dinucleotide phosphate)-dependent manner." .

<http://example.org/locx/sentence/33818279/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33818279/S8/position>,
        <http://example.org/locx/sentence/33818279/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33818279> .

<http://example.org/locx/sentence/33818279/S8/position> a oa:TextPositionSelector ;
    oa:end 1363 ;
    oa:start 1088 .

<http://example.org/locx/sentence/33818279/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Consistent with the Ca2+-releasing activity of NAADP, intracellular Ca2+ chelation and PPP3/calcineurin inhibition prevented TFEB activation by phagocytosis and ROS (reactive oxygen species), impairing the induction of pro-inflammatory cytokines such as IL6 and TNF/TNFalpha." .

<http://example.org/locx/sentence/33960270/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33960270/S4/position>,
        <http://example.org/locx/sentence/33960270/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33960270> .

<http://example.org/locx/sentence/33960270/S4/position> a oa:TextPositionSelector ;
    oa:end 761 ;
    oa:start 488 .

<http://example.org/locx/sentence/33960270/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Knockout (KO) of VTRNA1-1 in human hepatocellular carcinoma cells reduced nuclear localization of TFEB (transcription factor EB), leading to a downregulation of the coordinated lysosomal expression and regulation (CLEAR) network genes and lysosomal compartment dysfunction." .

<http://example.org/locx/sentence/33972476/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/33972476/S7/position>,
        <http://example.org/locx/sentence/33972476/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/33972476> .

<http://example.org/locx/sentence/33972476/S7/position> a oa:TextPositionSelector ;
    oa:end 1166 ;
    oa:start 893 .

<http://example.org/locx/sentence/33972476/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "The control of nuclear localization via phosphorylation and dephosphorylation serves as the primary regulatory mechanism for MiT family proteins, and several kinases and phosphatases have been identified to directly determine the transcriptional activities of MiT proteins." .

<http://example.org/locx/sentence/34017832/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34017832/S6/position>,
        <http://example.org/locx/sentence/34017832/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34017832> .

<http://example.org/locx/sentence/34017832/S6/position> a oa:TextPositionSelector ;
    oa:end 774 ;
    oa:start 616 .

<http://example.org/locx/sentence/34017832/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In vitro and in vivo experiments demonstrate that ceramide increases TFEB expression and nuclear translocation and induces lysosomal formation and exocytosis." .

<http://example.org/locx/sentence/34071043/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34071043/S10/position>,
        <http://example.org/locx/sentence/34071043/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34071043> .

<http://example.org/locx/sentence/34071043/S10/position> a oa:TextPositionSelector ;
    oa:end 1306 ;
    oa:start 1205 .

<http://example.org/locx/sentence/34071043/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, TFEB overexpression resulted in more nuclear TFEB and rescued cardiomyopathy phenotypes." .

<http://example.org/locx/sentence/34071043/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34071043/S8/position>,
        <http://example.org/locx/sentence/34071043/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34071043> .

<http://example.org/locx/sentence/34071043/S8/position> a oa:TextPositionSelector ;
    oa:end 1057 ;
    oa:start 888 .

<http://example.org/locx/sentence/34071043/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "However, mTOR inhibition failed to ameliorate cardiac phenotypes in the RagCS75Y cardiomyopathy models, concomitant with a failure to promote TFEB nuclear translocation." .

<http://example.org/locx/sentence/34071043/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34071043/S9/position>,
        <http://example.org/locx/sentence/34071043/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34071043> .

<http://example.org/locx/sentence/34071043/S9/position> a oa:TextPositionSelector ;
    oa:end 1204 ;
    oa:start 1058 .

<http://example.org/locx/sentence/34071043/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "This observation was at least partially explained by increased and mTOR-independent physical interaction between RagCS75Y and TFEB in the cytosol." .

<http://example.org/locx/sentence/34091590/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34091590/S11/position>,
        <http://example.org/locx/sentence/34091590/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34091590> .

<http://example.org/locx/sentence/34091590/S11/position> a oa:TextPositionSelector ;
    oa:end 1545 ;
    oa:start 1321 .

<http://example.org/locx/sentence/34091590/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "We also found that CDDP treatment induced TFEB nuclear translocation, thus increasing PD-L1 and PD-L2 expression to foster an immunosuppressive tumor microenvironment, which mediates tumor immune evasion and drug resistance." .

<http://example.org/locx/sentence/34158631/S7/position> a oa:TextPositionSelector ;
    oa:end 1011 ;
    oa:start 807 .

<http://example.org/locx/sentence/34158631/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This is mediated by the key autophagy transcription factor, TFEB, which becomes dephosphorylated and translocates from the cytoplasm to the nucleus where it elicits an integrated transcriptional response." .

<http://example.org/locx/sentence/34209164/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34209164/S9/position>,
        <http://example.org/locx/sentence/34209164/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34209164> .

<http://example.org/locx/sentence/34209164/S9/position> a oa:TextPositionSelector ;
    oa:end 1447 ;
    oa:start 1229 .

<http://example.org/locx/sentence/34209164/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "We could further correlate early LBPA enrichment with dissociation of the mechanistic target of rapamycin (mTOR) from lysosomes followed by nuclear translocation of its downtream target, transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/34215848/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34215848/S4/position>,
        <http://example.org/locx/sentence/34215848/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34215848> .

<http://example.org/locx/sentence/34215848/S4/position> a oa:TextPositionSelector ;
    oa:end 684 ;
    oa:start 495 .

<http://example.org/locx/sentence/34215848/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "We show that the constitutive nuclear localization of TFEB, a transcription factor that activates the expression of autophagy and lysosomal genes, is characteristic of human trisomic cells." .

<http://example.org/locx/sentence/34215848/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34215848/S5/position>,
        <http://example.org/locx/sentence/34215848/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34215848> .

<http://example.org/locx/sentence/34215848/S5/position> a oa:TextPositionSelector ;
    oa:end 822 ;
    oa:start 685 .

<http://example.org/locx/sentence/34215848/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Constitutive nuclear localization of TFEB in trisomic cells is independent of mTORC1 signaling, but depends on the cGAS-STING activation." .

<http://example.org/locx/sentence/34225908/S3/position> a oa:TextPositionSelector ;
    oa:end 368 ;
    oa:start 210 .

<http://example.org/locx/sentence/34225908/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "In response to a series of stresses such as nutrient starvation, TFEB translocates from the cytoplasm to the nucleus, where it exerts its regulatory function." .

<http://example.org/locx/sentence/34253294/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34253294/S3/position>,
        <http://example.org/locx/sentence/34253294/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34253294> .

<http://example.org/locx/sentence/34253294/S3/position> a oa:TextPositionSelector ;
    oa:end 403 ;
    oa:start 176 .

<http://example.org/locx/sentence/34253294/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "A variety of specific signals such as nutrient deprivation or oxidative stress can trigger lysosomal calcium-mediated nuclear translocation of the transcription factor EB (TFEB), a master regulator of global lysosomal function." .

<http://example.org/locx/sentence/34313548/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34313548/S11/position>,
        <http://example.org/locx/sentence/34313548/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34313548> .

<http://example.org/locx/sentence/34313548/S11/position> a oa:TextPositionSelector ;
    oa:end 1685 ;
    oa:start 1467 .

<http://example.org/locx/sentence/34313548/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "In overexpression models, the pathogenic LRRK2G2019S mutant promotes hyperactivation of TFEB even in the absence of CD38, both by stabilizing TFEB and promoting its nuclear translocation via aberrant calcium signaling." .

<http://example.org/locx/sentence/34338217/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34338217/S10/position>,
        <http://example.org/locx/sentence/34338217/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34338217> .

<http://example.org/locx/sentence/34338217/S10/position> a oa:TextPositionSelector ;
    oa:end 1643 ;
    oa:start 1489 .

<http://example.org/locx/sentence/34338217/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Blastocysts from women with high body-mass index, but not the method of fertilisation, revealed stimulated lysosome biogenesis and TFEB nuclear migration." .

<http://example.org/locx/sentence/34338217/S8/position> a oa:TextPositionSelector ;
    oa:end 1362 ;
    oa:start 1167 .

<http://example.org/locx/sentence/34338217/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Secondly, we identified the transcription factor TFEB as mediating the histotrophic response by translocation from cytoplasm to nucleus during ILE deficiency and in response to mTORC1 inhibition." .

<http://example.org/locx/sentence/34414176/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34414176/S5/position>,
        <http://example.org/locx/sentence/34414176/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34414176> .

<http://example.org/locx/sentence/34414176/S5/position> a oa:TextPositionSelector ;
    oa:end 919 ;
    oa:start 669 .

<http://example.org/locx/sentence/34414176/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, the ERKi regulated autophagic flux by promoting the translocation of transcription factor EB (TFEB) in OS cells, thereby increasing the dependence of OS cells on autophagy and sensitivity to treatment with autophagy inhibitors in OS." .

<http://example.org/locx/sentence/34417577/S4/position> a oa:TextPositionSelector ;
    oa:end 687 ;
    oa:start 479 .

<http://example.org/locx/sentence/34417577/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Specifically, 15d-PGJ2 promotes TFEB translocation from the cytoplasm into the nucleus to induce autophagy and lysosome biogenesis via reactive oxygen species (ROS) production rather than mTORC1 inactivation." .

<http://example.org/locx/sentence/34434486/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34434486/S4/position>,
        <http://example.org/locx/sentence/34434486/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34434486> .

<http://example.org/locx/sentence/34434486/S4/position> a oa:TextPositionSelector ;
    oa:end 635 ;
    oa:start 412 .

<http://example.org/locx/sentence/34434486/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "CRM1 (exportin-1/XPO1) exports hundreds of nuclear proteins into the cytoplasm, including the transcription factors TFEB (the main inducer of autophagy and lysosomal biogenesis genes) and STAT3, another autophagy modulator." .

<http://example.org/locx/sentence/34434486/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34434486/S5/position>,
        <http://example.org/locx/sentence/34434486/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34434486> .

<http://example.org/locx/sentence/34434486/S5/position> a oa:TextPositionSelector ;
    oa:end 1099 ;
    oa:start 636 .

<http://example.org/locx/sentence/34434486/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "It appears that CRM1 is a modulator of aging-associated senescence and autophagy, because pharmacological inhibition of CRM1 improved autophagic degradation in flies, by increasing nuclear TFEB levels, and because enhanced CRM1 activity is mechanistically linked to senescence in fibroblasts from Hutchinson-Gilford progeria syndrome patients and old healthy individuals; furthermore, the exogenous overexpression of CRM1 induced senescence in normal fibroblasts." .

<http://example.org/locx/sentence/34434486/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34434486/S7/position>,
        <http://example.org/locx/sentence/34434486/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34434486> .

<http://example.org/locx/sentence/34434486/S7/position> a oa:TextPositionSelector ;
    oa:end 1396 ;
    oa:start 1234 .

<http://example.org/locx/sentence/34434486/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that CRM1 levels and activity increased in the hippocampus and cortex during physiological aging, which resulted in a decrease of nuclear TFEB and STAT3." .

<http://example.org/locx/sentence/34434486/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34434486/S9/position>,
        <http://example.org/locx/sentence/34434486/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34434486> .

<http://example.org/locx/sentence/34434486/S9/position> a oa:TextPositionSelector ;
    oa:end 1764 ;
    oa:start 1584 .

<http://example.org/locx/sentence/34434486/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Using an in vitro model of neuronal senescence, we demonstrate that CRM1 inhibition improved autophagy flux and reduced SA-beta-gal activity by restoring TFEB nuclear localization." .

<http://example.org/locx/sentence/34445390/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34445390/S9/position>,
        <http://example.org/locx/sentence/34445390/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34445390> .

<http://example.org/locx/sentence/34445390/S9/position> a oa:TextPositionSelector ;
    oa:end 1489 ;
    oa:start 1167 .

<http://example.org/locx/sentence/34445390/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Our results show that inhibition of NFAT with VIVIT in cells deprived of nutrients resulted in cytosolic retention of transcription Factor EB (TFEB), decreased expression of TFEB-regulated coordinated Lysosomal Expression and Regulation CLEAR network genes and decreased starvation-induced autophagy flux in the RPE cells." .

<http://example.org/locx/sentence/34490237/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34490237/S4/position>,
        <http://example.org/locx/sentence/34490237/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34490237> .

<http://example.org/locx/sentence/34490237/S4/position> a oa:TextPositionSelector ;
    oa:end 630 ;
    oa:start 541 .

<http://example.org/locx/sentence/34490237/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "The activated TFEB enters into the nucleus and induces the expressions of targeted genes." .

<http://example.org/locx/sentence/34556628/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34556628/S7/position>,
        <http://example.org/locx/sentence/34556628/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34556628> .

<http://example.org/locx/sentence/34556628/S7/position> a oa:TextPositionSelector ;
    oa:end 1087 ;
    oa:start 899 .

<http://example.org/locx/sentence/34556628/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "It was observed that the FGF21-induced autophagy flux enhancement was mediated by the nuclear translocation of TFEB, which occurs due to the activation of the SIRT1-mTOR signaling pathway." .

<http://example.org/locx/sentence/34611296/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34611296/S7/position>,
        <http://example.org/locx/sentence/34611296/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34611296> .

<http://example.org/locx/sentence/34611296/S7/position> a oa:TextPositionSelector ;
    oa:end 892 ;
    oa:start 709 .

<http://example.org/locx/sentence/34611296/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Receptor for activated C kinase 1 (RACK1) was identified as a signal adapter of LOX-1, which incented RAS/MEK/ERK pathway and TFEB nuclear export signal and safeguarded tumorigenesis." .

<http://example.org/locx/sentence/34643458/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34643458/S5/position>,
        <http://example.org/locx/sentence/34643458/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34643458> .

<http://example.org/locx/sentence/34643458/S5/position> a oa:TextPositionSelector ;
    oa:end 683 ;
    oa:start 478 .

<http://example.org/locx/sentence/34643458/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, we report that EIF4A3, through its ability to safeguard splicing, can maintain low basal levels of autophagy through the cytosolic retention of the key autophagy transcription factor TFEB." .

<http://example.org/locx/sentence/34643458/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34643458/S6/position>,
        <http://example.org/locx/sentence/34643458/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34643458> .

<http://example.org/locx/sentence/34643458/S6/position> a oa:TextPositionSelector ;
    oa:end 889 ;
    oa:start 684 .

<http://example.org/locx/sentence/34643458/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Upon EIF4A3 depletion, the shuttling of TFEB to the nucleus results in an integrated transcriptional response, which induces both early and late steps of the autophagy pathway and enhances autophagic flux." .

<http://example.org/locx/sentence/34680130/S9/position> a oa:TextPositionSelector ;
    oa:end 1143 ;
    oa:start 1035 .

<http://example.org/locx/sentence/34680130/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, the movement of TFEB from cytosol to the nucleus via microtubules was impaired by AGS exposure." .

<http://example.org/locx/sentence/34769510/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34769510/S4/position>,
        <http://example.org/locx/sentence/34769510/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34769510> .

<http://example.org/locx/sentence/34769510/S4/position> a oa:TextPositionSelector ;
    oa:end 697 ;
    oa:start 497 .

<http://example.org/locx/sentence/34769510/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here we report that three translation inhibitors (cycloheximide, lactimidomycin, and rocaglamide A) can facilitate the nuclear translocation of TFEB/TFE3 via dephosphorylation and 14-3-3 dissociation." .

<http://example.org/locx/sentence/34774699/S5/position> a oa:TextPositionSelector ;
    oa:end 940 ;
    oa:start 683 .

<http://example.org/locx/sentence/34774699/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Further analyses revealed that starvation-induced autophagy promotes the translocation of transcription factor EB (TFEB) from the cytoplasm to nucleus and its binding to the promoter region of LAMP2, whereas FSH suppresses the nuclear translocation of TFEB." .

<http://example.org/locx/sentence/34776962/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/34776962/S4/position>,
        <http://example.org/locx/sentence/34776962/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/34776962> .

<http://example.org/locx/sentence/34776962/S4/position> a oa:TextPositionSelector ;
    oa:end 631 ;
    oa:start 492 .

<http://example.org/locx/sentence/34776962/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "We delineate the mechanism that SC75741 could markedly enhance TFEB nuclear translocation by an mTORC1-independent TFEB regulatory pathway." .

<http://example.org/locx/sentence/35020443/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35020443/S3/position>,
        <http://example.org/locx/sentence/35020443/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35020443> .

<http://example.org/locx/sentence/35020443/S3/position> a oa:TextPositionSelector ;
    oa:end 361 ;
    oa:start 189 .

<http://example.org/locx/sentence/35020443/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "The nuclear localization of TFEB is blocked by the mechanistic target of rapamycin complex 1 (mTORC1)-dependent phosphorylation of TFEB at multiple sites including Ser-211." .

<http://example.org/locx/sentence/35020443/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35020443/S4/position>,
        <http://example.org/locx/sentence/35020443/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35020443> .

<http://example.org/locx/sentence/35020443/S4/position> a oa:TextPositionSelector ;
    oa:end 570 ;
    oa:start 362 .

<http://example.org/locx/sentence/35020443/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here we show that inhibition of PIKfyve, which produces phosphatidylinositol 3,5-bisphosphate on endosomes and lysosomes, causes a loss of Ser-211 phosphorylation and concomitant nuclear localization of TFEB." .

<http://example.org/locx/sentence/35053374/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35053374/S7/position>,
        <http://example.org/locx/sentence/35053374/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35053374> .

<http://example.org/locx/sentence/35053374/S7/position> a oa:TextPositionSelector ;
    oa:end 1011 ;
    oa:start 850 .

<http://example.org/locx/sentence/35053374/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "During myocardial reperfusion, Tfeb is activated and translocated into the nucleus, which in turn upregulates genes involved in autophagy and lysosomal function." .

<http://example.org/locx/sentence/35070939/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35070939/S5/position>,
        <http://example.org/locx/sentence/35070939/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35070939> .

<http://example.org/locx/sentence/35070939/S5/position> a oa:TextPositionSelector ;
    oa:end 1033 ;
    oa:start 742 .

<http://example.org/locx/sentence/35070939/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In addition, transcription factor EB (TFEB), which acts as a transcription factor regulating the transcription of autophagy-related genes, was much more localized in the nucleus in A375P/Mdr cells than in A375P cells, indicating that the increase in basal autophagic flux was TFEB-dependent." .

<http://example.org/locx/sentence/35070939/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35070939/S9/position>,
        <http://example.org/locx/sentence/35070939/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35070939> .

<http://example.org/locx/sentence/35070939/S9/position> a oa:TextPositionSelector ;
    oa:end 1592 ;
    oa:start 1418 .

<http://example.org/locx/sentence/35070939/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, ER stress inhibition significantly remarkably inhibited the nuclear localization of TFEB, resulting in an increase in the sensitivity of A375P/Mdr cells to PLX4720." .

<http://example.org/locx/sentence/35078192/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35078192/S6/position>,
        <http://example.org/locx/sentence/35078192/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35078192> .

<http://example.org/locx/sentence/35078192/S6/position> a oa:TextPositionSelector ;
    oa:end 1008 ;
    oa:start 746 .

<http://example.org/locx/sentence/35078192/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "The phenotypic changes indicated that autophagy induction was associated with activation of 5' adenosine monophosphate-activated protein kinase (AMPK), nuclear translocation of transcription factor EB (TFEB), and changes in expression of autophagy-related genes." .

<http://example.org/locx/sentence/35078192/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35078192/S7/position>,
        <http://example.org/locx/sentence/35078192/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35078192> .

<http://example.org/locx/sentence/35078192/S7/position> a oa:TextPositionSelector ;
    oa:end 1135 ;
    oa:start 1009 .

<http://example.org/locx/sentence/35078192/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "The kinetics of the explored signaling pathways indicated on activation of AMPK followed by the nuclear translocation of TFEB." .

<http://example.org/locx/sentence/35090378/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35090378/S11/position>,
        <http://example.org/locx/sentence/35090378/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35090378> .

<http://example.org/locx/sentence/35090378/S11/position> a oa:TextPositionSelector ;
    oa:end 1570 ;
    oa:start 1375 .

<http://example.org/locx/sentence/35090378/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Next, we demonstrated that CTH-H2S sulfhydrated TFEB at Cys212 site, facilitating its nuclear translocation, and then promoting transcription of its target genes such as ATG9A, LAPTM5 or LDLRAP1." .

<http://example.org/locx/sentence/35182526/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35182526/S7/position>,
        <http://example.org/locx/sentence/35182526/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35182526> .

<http://example.org/locx/sentence/35182526/S7/position> a oa:TextPositionSelector ;
    oa:end 1424 ;
    oa:start 1307 .

<http://example.org/locx/sentence/35182526/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This mechanism involves calcineurin and the nuclear translocation and elevated transcriptional activity of TFEB/TFE3." .

<http://example.org/locx/sentence/35183507/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35183507/S5/position>,
        <http://example.org/locx/sentence/35183507/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35183507> .

<http://example.org/locx/sentence/35183507/S5/position> a oa:TextPositionSelector ;
    oa:end 820 ;
    oa:start 602 .

<http://example.org/locx/sentence/35183507/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we demonstrate that Ragulator, a heteropentameric protein complex required for mTORC1 activation in response to amino acids, is critical for inhibiting the nuclear translocation of transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/35183507/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35183507/S7/position>,
        <http://example.org/locx/sentence/35183507/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35183507> .

<http://example.org/locx/sentence/35183507/S7/position> a oa:TextPositionSelector ;
    oa:end 1057 ;
    oa:start 918 .

<http://example.org/locx/sentence/35183507/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In a nutrition-sufficient state, the nuclear translocation of TFEB was markedly enhanced in the clone despite total mTORC1 kinase activity." .

<http://example.org/locx/sentence/35230915/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35230915/S4/position>,
        <http://example.org/locx/sentence/35230915/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35230915> .

<http://example.org/locx/sentence/35230915/S4/position> a oa:TextPositionSelector ;
    oa:end 813 ;
    oa:start 589 .

<http://example.org/locx/sentence/35230915/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Extracellular stimuli, such as nutrient deprivation or oxidative stress, induce nuclear translocation and activation of TFEB and TFE3, which then associate with the FACT complex to regulate stress-induced gene transcription." .

<http://example.org/locx/sentence/35243365/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35243365/S2/position>,
        <http://example.org/locx/sentence/35243365/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35243365> .

<http://example.org/locx/sentence/35243365/S2/position> a oa:TextPositionSelector ;
    oa:end 269 ;
    oa:start 119 .

<http://example.org/locx/sentence/35243365/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "Following lysosomal damage, activation and nuclear translocation of transcription factor EB (TFEB) is the key event to maintain lysosomal homeostasis." .

<http://example.org/locx/sentence/35293953/S7/position> a oa:TextPositionSelector ;
    oa:end 942 ;
    oa:start 802 .

<http://example.org/locx/sentence/35293953/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "These compounds promote lysosomal biogenesis and function in a TFEB-dependent manner without changing its cytoplasmic-nuclear translocation." .

<http://example.org/locx/sentence/35304128/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35304128/S5/position>,
        <http://example.org/locx/sentence/35304128/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35304128> .

<http://example.org/locx/sentence/35304128/S5/position> a oa:TextPositionSelector ;
    oa:end 907 ;
    oa:start 725 .

<http://example.org/locx/sentence/35304128/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "PMA also increased nuclear translocation of autophagy transcription factors TFEB, FOXO1, and FOXO3, as well as the expression of several autophagy-related (ATG) genes in HL-60 cells." .

<http://example.org/locx/sentence/35304128/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35304128/S8/position>,
        <http://example.org/locx/sentence/35304128/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35304128> .

<http://example.org/locx/sentence/35304128/S8/position> a oa:TextPositionSelector ;
    oa:end 1580 ;
    oa:start 1296 .

<http://example.org/locx/sentence/35304128/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Pharmacological or genetic inhibition of ERK or JNK suppressed PMA-triggered nuclear translocation of TFEB and FOXO1/3, ATG expression, dissociation of pro-autophagic beclin-1 from its inhibitor BCL2, autophagy induction, and differentiation of HL-60 cells into macrophage-like cells." .

<http://example.org/locx/sentence/35308126/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35308126/S5/position>,
        <http://example.org/locx/sentence/35308126/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35308126> .

<http://example.org/locx/sentence/35308126/S5/position> a oa:TextPositionSelector ;
    oa:end 828 ;
    oa:start 667 .

<http://example.org/locx/sentence/35308126/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Kazinol C activated the transducers of unfolded protein response signaling, leading to target gene expression, LC3-II conversion, and TFEB nuclear translocation." .

<http://example.org/locx/sentence/35316161/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35316161/S6/position>,
        <http://example.org/locx/sentence/35316161/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35316161> .

<http://example.org/locx/sentence/35316161/S6/position> a oa:TextPositionSelector ;
    oa:end 886 ;
    oa:start 666 .

<http://example.org/locx/sentence/35316161/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Centrosome depletion inactivates PLK4, resulting in TFEB and TFE3 dephosphorylation and subsequent promotion of TFEB and TFE3 nuclear translocation and transcriptional activation of autophagy- and lysosome-related genes." .

<http://example.org/locx/sentence/35330074/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35330074/S11/position>,
        <http://example.org/locx/sentence/35330074/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35330074> .

<http://example.org/locx/sentence/35330074/S11/position> a oa:TextPositionSelector ;
    oa:end 1320 ;
    oa:start 1177 .

<http://example.org/locx/sentence/35330074/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "This is remarkable as TFEB factor has been reported to be sequestered inside Lewy bodies, pointing to a role of TFEB in the pathogenesis of PD." .

<http://example.org/locx/sentence/35367291/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35367291/S4/position>,
        <http://example.org/locx/sentence/35367291/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35367291> .

<http://example.org/locx/sentence/35367291/S4/position> a oa:TextPositionSelector ;
    oa:end 536 ;
    oa:start 385 .

<http://example.org/locx/sentence/35367291/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we show that nuclear translocation of transcription factor EB (TFEB), a master regulator of autophagy, was regulated by miR-34a in HEI-OC1 cells." .

<http://example.org/locx/sentence/35367291/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35367291/S5/position>,
        <http://example.org/locx/sentence/35367291/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35367291> .

<http://example.org/locx/sentence/35367291/S5/position> a oa:TextPositionSelector ;
    oa:end 682 ;
    oa:start 537 .

<http://example.org/locx/sentence/35367291/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, ATG9A, one of the main targets of miR-34a, was shown to interact with TFEB and thus promote its nuclear translocation in HEI-OC1 cells." .

<http://example.org/locx/sentence/35367291/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35367291/S6/position>,
        <http://example.org/locx/sentence/35367291/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35367291> .

<http://example.org/locx/sentence/35367291/S6/position> a oa:TextPositionSelector ;
    oa:end 854 ;
    oa:start 683 .

<http://example.org/locx/sentence/35367291/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Rapamycin rescued the inhibition of TFEB nuclear translocation induced by miR-34a/ATG9A activation, restored autophagic flux and consequently prevented HEI-OC1 cell death." .

<http://example.org/locx/sentence/35367291/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35367291/S8/position>,
        <http://example.org/locx/sentence/35367291/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35367291> .

<http://example.org/locx/sentence/35367291/S8/position> a oa:TextPositionSelector ;
    oa:end 1127 ;
    oa:start 1002 .

<http://example.org/locx/sentence/35367291/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Most importantly, rapamycin partially restored TFEB's nuclear localization and autophagic flux in OHCs of the ageing cochlea." .

<http://example.org/locx/sentence/35454800/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35454800/S11/position>,
        <http://example.org/locx/sentence/35454800/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35454800> .

<http://example.org/locx/sentence/35454800/S11/position> a oa:TextPositionSelector ;
    oa:end 1465 ;
    oa:start 1337 .

<http://example.org/locx/sentence/35454800/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "This activation induced transcription factor EB (TFEB) nuclear translocation and lysosome biogenesis, leading to autophagy flux." .

<http://example.org/locx/sentence/35462098/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35462098/S6/position>,
        <http://example.org/locx/sentence/35462098/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35462098> .

<http://example.org/locx/sentence/35462098/S6/position> a oa:TextPositionSelector ;
    oa:end 964 ;
    oa:start 711 .

<http://example.org/locx/sentence/35462098/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "This study found that in HK-2 cells, with the prolongation of high concentration glucose stimulation, the expression level of TFEB showed a trend of first increasing and then decreasing; and nuclear translocation of TFEB expression occurred within 24 h." .

<http://example.org/locx/sentence/35550146/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35550146/S7/position>,
        <http://example.org/locx/sentence/35550146/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35550146> .

<http://example.org/locx/sentence/35550146/S7/position> a oa:TextPositionSelector ;
    oa:end 932 ;
    oa:start 769 .

<http://example.org/locx/sentence/35550146/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "4-HNE induces TFEB nuclear translocation and activated TFEB then upregulates the expression of genes required for autophagic and lysosomal biogenesis and function." .

<http://example.org/locx/sentence/35662396/S5/position> a oa:TextPositionSelector ;
    oa:end 630 ;
    oa:start 435 .

<http://example.org/locx/sentence/35662396/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, itaconate directly alkylates human TFEB at cysteine 212 (Cys270 in mice) to induce its nuclear localization by antagonizing mTOR-mediated phosphorylation and cytosolic retention." .

<http://example.org/locx/sentence/35664771/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35664771/S7/position>,
        <http://example.org/locx/sentence/35664771/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35664771> .

<http://example.org/locx/sentence/35664771/S7/position> a oa:TextPositionSelector ;
    oa:end 881 ;
    oa:start 736 .

<http://example.org/locx/sentence/35664771/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Two transcription factors, oncogenic TFEB and TFE3, were shown to be regulated by FLCN inactivation, which results in their nuclear localization." .

<http://example.org/locx/sentence/35686465/S7/position> a oa:TextPositionSelector ;
    oa:end 1182 ;
    oa:start 946 .

<http://example.org/locx/sentence/35686465/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, feeding-induced FGF15/19 signaling increased the nuclear localization of TFEB and SHP via PKC beta/zeta-mediated phosphorylation, leading to increased transcription of the TFEB/SHP target lipophagy genes, Ulk1 and Atgl." .

<http://example.org/locx/sentence/35786165/S4/position> a oa:TextPositionSelector ;
    oa:end 787 ;
    oa:start 496 .

<http://example.org/locx/sentence/35786165/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Using a novel multi-parameter high-throughput screen for cytoplasmic:nuclear translocation of endogenous TFEB and the related transcription factor TFE3, we screened the Published Kinase Inhibitor Set 2 (PKIS2) library as proof of principle and to identify kinase regulators of TFEB and TFE3." .

<http://example.org/locx/sentence/35786165/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35786165/S6/position>,
        <http://example.org/locx/sentence/35786165/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35786165> .

<http://example.org/locx/sentence/35786165/S6/position> a oa:TextPositionSelector ;
    oa:end 1190 ;
    oa:start 1026 .

<http://example.org/locx/sentence/35786165/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In addition to AKT inhibitors which regulate TFEB localization, we identified a series of quinazoline-derivative compounds that induced TFEB and TFE3 translocation." .

<http://example.org/locx/sentence/35786165/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35786165/S7/position>,
        <http://example.org/locx/sentence/35786165/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35786165> .

<http://example.org/locx/sentence/35786165/S7/position> a oa:TextPositionSelector ;
    oa:end 1364 ;
    oa:start 1191 .

<http://example.org/locx/sentence/35786165/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "A novel series of structurally-related analogs was developed, and several compounds induced TFEB and TFE3 translocation at higher potency than previously screened compounds." .

<http://example.org/locx/sentence/35841069/S15> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35841069/S15/position>,
        <http://example.org/locx/sentence/35841069/S15/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35841069> .

<http://example.org/locx/sentence/35841069/S15/position> a oa:TextPositionSelector ;
    oa:end 2151 ;
    oa:start 2018 .

<http://example.org/locx/sentence/35841069/S15/quote> a oa:TextQuoteSelector ;
    oa:exact "The combination of CCR6 and TFEB to inhibit TFEB nuclear translocation mediates the role of the CCL20/CCR6 axis in the above process." .

<http://example.org/locx/sentence/35851059/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35851059/S5/position>,
        <http://example.org/locx/sentence/35851059/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35851059> .

<http://example.org/locx/sentence/35851059/S5/position> a oa:TextPositionSelector ;
    oa:end 905 ;
    oa:start 647 .

<http://example.org/locx/sentence/35851059/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Herein, we used a Transcription Factor EB (TFEB) nuclear translocation-mediated MSCs co-culture approach to reconstitute autophagy and lysosomal biogenesis, and reduce SCA3-like behaviors in induced pluripotent stem cells (iPSCs)-derived neuron cells models." .

<http://example.org/locx/sentence/35895663/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35895663/S5/position>,
        <http://example.org/locx/sentence/35895663/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35895663> .

<http://example.org/locx/sentence/35895663/S5/position> a oa:TextPositionSelector ;
    oa:end 955 ;
    oa:start 706 .

<http://example.org/locx/sentence/35895663/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "The results showed that the S-PRG eluate specifically induced CXADR expression at the transcriptional level of messenger RNA as well as the protein level, and also nuclear translocation of transcription factor EB (TFEB) in gingival epithelial cells." .

<http://example.org/locx/sentence/35898781/S10/position> a oa:TextPositionSelector ;
    oa:end 1168 ;
    oa:start 1079 .

<http://example.org/locx/sentence/35898781/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Meanwhile, TFEB was highly expressed in the nucleus and lowly expressed in the cytoplasm." .

<http://example.org/locx/sentence/35933473/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35933473/S8/position>,
        <http://example.org/locx/sentence/35933473/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35933473> .

<http://example.org/locx/sentence/35933473/S8/position> a oa:TextPositionSelector ;
    oa:end 1226 ;
    oa:start 1066 .

<http://example.org/locx/sentence/35933473/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "We also demonstrate that harmol promotes the translocation of TFEB into the nucleus and accompanies the restoration of autophagic flux and lysosomal biogenesis." .

<http://example.org/locx/sentence/35977156/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35977156/S8/position>,
        <http://example.org/locx/sentence/35977156/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35977156> .

<http://example.org/locx/sentence/35977156/S8/position> a oa:TextPositionSelector ;
    oa:end 1050 ;
    oa:start 942 .

<http://example.org/locx/sentence/35977156/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "JNK-IN-8 inhibited TFEB phosphorylation and induced nuclear translocation of unphosphorylated TFEB and TFE3." .

<http://example.org/locx/sentence/35983247/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35983247/S13/position>,
        <http://example.org/locx/sentence/35983247/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35983247> .

<http://example.org/locx/sentence/35983247/S13/position> a oa:TextPositionSelector ;
    oa:end 1763 ;
    oa:start 1653 .

<http://example.org/locx/sentence/35983247/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "Compared with C57/BL6J mice, the amount of TFEB in the brain nucleus of APP/PS1 transgenic mice was decreased." .

<http://example.org/locx/sentence/35983247/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/35983247/S14/position>,
        <http://example.org/locx/sentence/35983247/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/35983247> .

<http://example.org/locx/sentence/35983247/S14/position> a oa:TextPositionSelector ;
    oa:end 1845 ;
    oa:start 1764 .

<http://example.org/locx/sentence/35983247/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "Melatonin treatment increased the nuclear translocation of TFEB in SH-SY5Y cells." .

<http://example.org/locx/sentence/36009195/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36009195/S7/position>,
        <http://example.org/locx/sentence/36009195/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36009195> .

<http://example.org/locx/sentence/36009195/S7/position> a oa:TextPositionSelector ;
    oa:end 1122 ;
    oa:start 862 .

<http://example.org/locx/sentence/36009195/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Increased mitochondrial reactive oxygen species (mROS) by DOX oxidized transient receptor potential mucolipin 1 (TRPML1) on the lysosomal membrane, which led to nuclear localization of transcription factor EB (TFEB), an autophagy-inducing transcription factor." .

<http://example.org/locx/sentence/36131369/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36131369/S1/position>,
        <http://example.org/locx/sentence/36131369/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36131369> .

<http://example.org/locx/sentence/36131369/S1/position> a oa:TextPositionSelector ;
    oa:end 140 ;
    oa:start 0 .

<http://example.org/locx/sentence/36131369/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Quercetin alleviates ethanol-induced hepatic steatosis in L02 cells by activating TFEB translocation to compensate for inadequate autophagy." .

<http://example.org/locx/sentence/36131369/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36131369/S6/position>,
        <http://example.org/locx/sentence/36131369/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36131369> .

<http://example.org/locx/sentence/36131369/S6/position> a oa:TextPositionSelector ;
    oa:end 928 ;
    oa:start 800 .

<http://example.org/locx/sentence/36131369/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, quercetin activated TFEB nuclear translocation, contributing to lysosomal biogenesis and autophagic activation." .

<http://example.org/locx/sentence/36150104/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36150104/S10/position>,
        <http://example.org/locx/sentence/36150104/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36150104> .

<http://example.org/locx/sentence/36150104/S10/position> a oa:TextPositionSelector ;
    oa:end 1339 ;
    oa:start 1101 .

<http://example.org/locx/sentence/36150104/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "RESULTS: PPIs caused a 70% inhibition of V-ATPase activity at 20 muM, leading to lysosomal stress through TFEB nuclear translocation; ER stress by inducing the expression of PERK, IRE1, and ATF6; and enhanced SOD activity for ROS removal." .

<http://example.org/locx/sentence/36264642/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36264642/S7/position>,
        <http://example.org/locx/sentence/36264642/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36264642> .

<http://example.org/locx/sentence/36264642/S7/position> a oa:TextPositionSelector ;
    oa:end 1276 ;
    oa:start 1093 .

<http://example.org/locx/sentence/36264642/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Rapalogs that increased virus entry inhibited mTOR-mediated phosphorylation of the transcription factor TFEB, which facilitated its nuclear translocation and triggered microautophagy." .

<http://example.org/locx/sentence/36357396/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36357396/S3/position>,
        <http://example.org/locx/sentence/36357396/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36357396> .

<http://example.org/locx/sentence/36357396/S3/position> a oa:TextPositionSelector ;
    oa:end 457 ;
    oa:start 290 .

<http://example.org/locx/sentence/36357396/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "The MiT/TFE transcription factors are phosphorylated and inactivated by mTORC1 following lysosomal recruitment by RagC/D GTPases in response to amino acid stimulation." .

<http://example.org/locx/sentence/36377675/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36377675/S7/position>,
        <http://example.org/locx/sentence/36377675/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36377675> .

<http://example.org/locx/sentence/36377675/S7/position> a oa:TextPositionSelector ;
    oa:end 1084 ;
    oa:start 927 .

<http://example.org/locx/sentence/36377675/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Trans-gnetin H significantly inhibits cancer cell viability through autophagy by suppressing the phosphorylation of TFEB and promoting its nuclear transport." .

<http://example.org/locx/sentence/36464658/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36464658/S6/position>,
        <http://example.org/locx/sentence/36464658/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36464658> .

<http://example.org/locx/sentence/36464658/S6/position> a oa:TextPositionSelector ;
    oa:end 652 ;
    oa:start 552 .

<http://example.org/locx/sentence/36464658/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "SiNP-induced TFEB nuclear translocation is verified using immunofluorescence and western blot assay." .

<http://example.org/locx/sentence/36484324/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36484324/S7/position>,
        <http://example.org/locx/sentence/36484324/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36484324> .

<http://example.org/locx/sentence/36484324/S7/position> a oa:TextPositionSelector ;
    oa:end 954 ;
    oa:start 782 .

<http://example.org/locx/sentence/36484324/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, we found that Gs-Rb1 promoted the nucleus translocation of the transcription factor EB (TFEB) and the target role of miR-128, thus stimulating autophagic flux." .

<http://example.org/locx/sentence/36587696/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36587696/S6/position>,
        <http://example.org/locx/sentence/36587696/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36587696> .

<http://example.org/locx/sentence/36587696/S6/position> a oa:TextPositionSelector ;
    oa:end 1384 ;
    oa:start 1149 .

<http://example.org/locx/sentence/36587696/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In this process, the adjustment of TFEB expression and nuclear translocation by gene knockout and gene overexpression, further altered the tendency of ZnO NPs-induced pyroptosis via the regulation of autophagy and lysosomal biogenesis." .

<http://example.org/locx/sentence/36588318/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36588318/S3/position>,
        <http://example.org/locx/sentence/36588318/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36588318> .

<http://example.org/locx/sentence/36588318/S3/position> a oa:TextPositionSelector ;
    oa:end 681 ;
    oa:start 313 .

<http://example.org/locx/sentence/36588318/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Herein, we show that bortezomib exposure leads to microglia activation and cognitive impairment, this occurs along with decreased nuclear translocation of TFEB (transcription factor EB), which is linked to macroautophagy/autophagy disorder, STAT3 (signal transducer and activator of transcription 3) phosphorylation and IL23A (interleukin 23 subunit alpha) expression." .

<http://example.org/locx/sentence/36588318/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36588318/S4/position>,
        <http://example.org/locx/sentence/36588318/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36588318> .

<http://example.org/locx/sentence/36588318/S4/position> a oa:TextPositionSelector ;
    oa:end 835 ;
    oa:start 682 .

<http://example.org/locx/sentence/36588318/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Pharmacological enhancement of TFEB nuclear translocation by digoxin restores lysosomal function and reduces STAT3-dependent endothelial IL23A secretion." .

<http://example.org/locx/sentence/36627100/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36627100/S1/position>,
        <http://example.org/locx/sentence/36627100/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36627100> .

<http://example.org/locx/sentence/36627100/S1/position> a oa:TextPositionSelector ;
    oa:end 131 ;
    oa:start 0 .

<http://example.org/locx/sentence/36627100/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Exendin-4 alleviates myocardial ischemia reperfusion injury by enhancing autophagy through promoting nuclear translocation of TFEB." .

<http://example.org/locx/sentence/36627100/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36627100/S8/position>,
        <http://example.org/locx/sentence/36627100/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36627100> .

<http://example.org/locx/sentence/36627100/S8/position> a oa:TextPositionSelector ;
    oa:end 1101 ;
    oa:start 856 .

<http://example.org/locx/sentence/36627100/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Exendin-4 pre-treatment markedly restored the blocked autophagic flux induced by OGD/R through promoting nuclear translocation of TFEB and transcription of genes involving autophagy initiation, the effect of which was reversed by TFEB knockdown." .

<http://example.org/locx/sentence/36690191/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36690191/S6/position>,
        <http://example.org/locx/sentence/36690191/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36690191> .

<http://example.org/locx/sentence/36690191/S6/position> a oa:TextPositionSelector ;
    oa:end 907 ;
    oa:start 670 .

<http://example.org/locx/sentence/36690191/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that the DEHP-caused immunosenescence is accompanied with downregulation of an antimicrobial gene lys-7 as well as an enhancement of the nuclear translocation of HLH-30, an orthologue of mammalian transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/36697823/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36697823/S1/position>,
        <http://example.org/locx/sentence/36697823/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36697823> .

<http://example.org/locx/sentence/36697823/S1/position> a oa:TextPositionSelector ;
    oa:end 65 ;
    oa:start 0 .

<http://example.org/locx/sentence/36697823/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Structure of the lysosomal mTORC1-TFEB-Rag-Ragulator megacomplex." .

<http://example.org/locx/sentence/36697823/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36697823/S10/position>,
        <http://example.org/locx/sentence/36697823/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36697823> .

<http://example.org/locx/sentence/36697823/S10/position> a oa:TextPositionSelector ;
    oa:end 1267 ;
    oa:start 1144 .

<http://example.org/locx/sentence/36697823/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "In cellulo mutation of the clamp drives TFEB constitutively into the nucleus while having no effect on mTORC1 localization." .

<http://example.org/locx/sentence/36736819/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36736819/S9/position>,
        <http://example.org/locx/sentence/36736819/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36736819> .

<http://example.org/locx/sentence/36736819/S9/position> a oa:TextPositionSelector ;
    oa:end 1512 ;
    oa:start 1331 .

<http://example.org/locx/sentence/36736819/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistic studies showed maltol promoted TFEB nuclear translocation through the AMPK/mTOR signaling pathway to restore lysosomal function and reduce autophagy dependent apoptosis." .

<http://example.org/locx/sentence/36759727/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36759727/S8/position>,
        <http://example.org/locx/sentence/36759727/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36759727> .

<http://example.org/locx/sentence/36759727/S8/position> a oa:TextPositionSelector ;
    oa:end 1003 ;
    oa:start 861 .

<http://example.org/locx/sentence/36759727/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Hsp90 inhibition enhances the interaction between CMA substrates and LAMP-2A and TFEB nuclear localisation, suggesting CMA activation by ManA." .

<http://example.org/locx/sentence/36765702/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36765702/S2/position>,
        <http://example.org/locx/sentence/36765702/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36765702> .

<http://example.org/locx/sentence/36765702/S2/position> a oa:TextPositionSelector ;
    oa:end 277 ;
    oa:start 139 .

<http://example.org/locx/sentence/36765702/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "Dephosphorylation of transcription factor EB (TFEB) at Ser142 and Ser138 determines its nuclear localization and transcriptional activity." .

<http://example.org/locx/sentence/36785787/S4/position> a oa:TextPositionSelector ;
    oa:end 526 ;
    oa:start 313 .

<http://example.org/locx/sentence/36785787/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here we report that the transcription factors TFEB and TFE3 translocate from the cytosol to the nucleus in response to beta-coronavirus infection by a mechanism that requires activation of calcineurin phosphatase." .

<http://example.org/locx/sentence/36794754/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36794754/S13/position>,
        <http://example.org/locx/sentence/36794754/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36794754> .

<http://example.org/locx/sentence/36794754/S13/position> a oa:TextPositionSelector ;
    oa:end 2330 ;
    oa:start 2213 .

<http://example.org/locx/sentence/36794754/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear TFEB translocation was uniformly observed in cystic epithelia in each model of renal cystic disease examined." .

<http://example.org/locx/sentence/36794754/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36794754/S14/position>,
        <http://example.org/locx/sentence/36794754/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36794754> .

<http://example.org/locx/sentence/36794754/S14/position> a oa:TextPositionSelector ;
    oa:end 2526 ;
    oa:start 2331 .

<http://example.org/locx/sentence/36794754/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB translocation was functionally active and associated with lysosomal biogenesis and perinuclear repositioning, increased TFEB-associated protein expression, and activation of autophagic flux." .

<http://example.org/locx/sentence/36794754/S5/position> a oa:TextPositionSelector ;
    oa:end 861 ;
    oa:start 683 .

<http://example.org/locx/sentence/36794754/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear translocation of Tfeb characterized cystic but not noncystic renal tubular epithelia in all three murine models as both an early and sustained response to cyst formation." .

<http://example.org/locx/sentence/36794754/S6/position> a oa:TextPositionSelector ;
    oa:end 1118 ;
    oa:start 862 .

<http://example.org/locx/sentence/36794754/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Epithelia expressed elevated levels of Tfeb-dependent gene products, including cathepsin B and glycoprotein nonmetastatic melanoma protein B. Nuclear Tfeb translocation was observed in mouse embryonic fibroblasts lacking Pkd1 but not wild-type fibroblasts." .

<http://example.org/locx/sentence/36794754/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36794754/S8/position>,
        <http://example.org/locx/sentence/36794754/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36794754> .

<http://example.org/locx/sentence/36794754/S8/position> a oa:TextPositionSelector ;
    oa:end 1496 ;
    oa:start 1270 .

<http://example.org/locx/sentence/36794754/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "The growth of Madin-Darby canine kidney cell cysts was markedly increased following exposure to the TFEB agonist compound C1, and nuclear Tfeb translocation was observed in response to both forskolin and compound C1 treatment." .

<http://example.org/locx/sentence/36794754/S9/position> a oa:TextPositionSelector ;
    oa:end 1650 ;
    oa:start 1497 .

<http://example.org/locx/sentence/36794754/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear TFEB also characterized cystic epithelia but not noncystic tubular epithelia in human patients with autosomal dominant polycystic kidney disease." .

<http://example.org/locx/sentence/36868108/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36868108/S11/position>,
        <http://example.org/locx/sentence/36868108/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36868108> .

<http://example.org/locx/sentence/36868108/S11/position> a oa:TextPositionSelector ;
    oa:end 1768 ;
    oa:start 1613 .

<http://example.org/locx/sentence/36868108/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, TE induces TFEB and TFE3 nuclear translocation through an mTOR/PKC/ROS-independent and endoplasmic reticulum (ER) stress-mediated pathway." .

<http://example.org/locx/sentence/36868222/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36868222/S3/position>,
        <http://example.org/locx/sentence/36868222/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36868222> .

<http://example.org/locx/sentence/36868222/S3/position> a oa:TextPositionSelector ;
    oa:end 392 ;
    oa:start 167 .

<http://example.org/locx/sentence/36868222/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Prior murine studies suggest that alternate-day fasting may attenuate doxorubicin cardiotoxicity and stimulate nuclear translocation of transcription factor EB (TFEB), a master regulator of autophagy and lysosomal biogenesis." .

<http://example.org/locx/sentence/36868222/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36868222/S4/position>,
        <http://example.org/locx/sentence/36868222/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36868222> .

<http://example.org/locx/sentence/36868222/S4/position> a oa:TextPositionSelector ;
    oa:end 524 ;
    oa:start 393 .

<http://example.org/locx/sentence/36868222/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "In this study, human heart tissue from patients with doxorubicin-induced heart failure demonstrated increased nuclear TFEB protein." .

<http://example.org/locx/sentence/36868222/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36868222/S6/position>,
        <http://example.org/locx/sentence/36868222/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36868222> .

<http://example.org/locx/sentence/36868222/S6/position> a oa:TextPositionSelector ;
    oa:end 782 ;
    oa:start 659 .

<http://example.org/locx/sentence/36868222/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mice randomized to alternate-day fasting plus doxorubicin exhibited increased TFEB nuclear translocation in the myocardium." .

<http://example.org/locx/sentence/36879478/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36879478/S8/position>,
        <http://example.org/locx/sentence/36879478/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36879478> .

<http://example.org/locx/sentence/36879478/S8/position> a oa:TextPositionSelector ;
    oa:end 985 ;
    oa:start 883 .

<http://example.org/locx/sentence/36879478/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, Hom promoted gene expression and nuclear translocation of transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/36958418/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36958418/S5/position>,
        <http://example.org/locx/sentence/36958418/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36958418> .

<http://example.org/locx/sentence/36958418/S5/position> a oa:TextPositionSelector ;
    oa:end 916 ;
    oa:start 703 .

<http://example.org/locx/sentence/36958418/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we report that filbertone activates PERK through mitochondrial ROS (mtROS) production, resulting in the increased nuclear translocation of transcription factor-EB (TFEB) in SH-SY5Y human neuroblastoma cells." .

<http://example.org/locx/sentence/36970883/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36970883/S8/position>,
        <http://example.org/locx/sentence/36970883/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36970883> .

<http://example.org/locx/sentence/36970883/S8/position> a oa:TextPositionSelector ;
    oa:end 1077 ;
    oa:start 909 .

<http://example.org/locx/sentence/36970883/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "We demonstrate that increased nuclear TFEB/TFE3 supports lysosome biogenesis, is a hallmark of multiple forms of senescence and is required for senescent cell survival." .

<http://example.org/locx/sentence/36970883/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/36970883/S9/position>,
        <http://example.org/locx/sentence/36970883/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/36970883> .

<http://example.org/locx/sentence/36970883/S9/position> a oa:TextPositionSelector ;
    oa:end 1169 ;
    oa:start 1078 .

<http://example.org/locx/sentence/36970883/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB/TFE3 are hypo-phosphorylated and show constitutive nuclear localisation in senescence." .

<http://example.org/locx/sentence/37013375/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37013375/S8/position>,
        <http://example.org/locx/sentence/37013375/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37013375> .

<http://example.org/locx/sentence/37013375/S8/position> a oa:TextPositionSelector ;
    oa:end 1491 ;
    oa:start 1313 .

<http://example.org/locx/sentence/37013375/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "In addition, tissue contraction activates calcineurin in skeletal muscle, which induces TFEB nuclear translocation, raising the hypothesis that the same would occur in the brain." .

<http://example.org/locx/sentence/37079666/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37079666/S5/position>,
        <http://example.org/locx/sentence/37079666/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37079666> .

<http://example.org/locx/sentence/37079666/S5/position> a oa:TextPositionSelector ;
    oa:end 971 ;
    oa:start 713 .

<http://example.org/locx/sentence/37079666/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "FNIP1 phosphorylation is required for AMPK to induce nuclear translocation of TFEB and TFEB-dependent increases of peroxisome proliferator-activated receptor gamma coactivator 1-alpha (PGC1alpha) and estrogen-related receptor alpha (ERRalpha) messenger RNAs." .

<http://example.org/locx/sentence/37079666/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37079666/S6/position>,
        <http://example.org/locx/sentence/37079666/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37079666> .

<http://example.org/locx/sentence/37079666/S6/position> a oa:TextPositionSelector ;
    oa:end 1128 ;
    oa:start 972 .

<http://example.org/locx/sentence/37079666/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Thus, mitochondrial damage triggers AMPK-FNIP1-dependent nuclear translocation of TFEB, inducing sequential waves of lysosomal and mitochondrial biogenesis." .

<http://example.org/locx/sentence/37126988/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37126988/S8/position>,
        <http://example.org/locx/sentence/37126988/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37126988> .

<http://example.org/locx/sentence/37126988/S8/position> a oa:TextPositionSelector ;
    oa:end 1557 ;
    oa:start 1341 .

<http://example.org/locx/sentence/37126988/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "The increased nuclear translocation of TFEB not only restored lysosome function, but also promoted autophagosome-lysosome fusion, eventually restoring the inhibited autophagic flux and filling the high energy levels." .

<http://example.org/locx/sentence/37188688/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37188688/S5/position>,
        <http://example.org/locx/sentence/37188688/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37188688> .

<http://example.org/locx/sentence/37188688/S5/position> a oa:TextPositionSelector ;
    oa:end 1202 ;
    oa:start 869 .

<http://example.org/locx/sentence/37188688/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "By using HeLa and HK-2 cell lines, human induced pluripotent stem cell-derived cardiomyocytes and patient-derived primary fibroblasts, we show that RRAGD auto-activating mutations lead to inhibition of TFEB and TFE3 nuclear translocation and transcriptional activity, which impairs the response to lysosomal and mitochondrial injury." .

<http://example.org/locx/sentence/37198709/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37198709/S7/position>,
        <http://example.org/locx/sentence/37198709/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37198709> .

<http://example.org/locx/sentence/37198709/S7/position> a oa:TextPositionSelector ;
    oa:end 968 ;
    oa:start 824 .

<http://example.org/locx/sentence/37198709/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Further, knockdown of STYXL1 causes the nuclear translocation of unfolded protein response (UPR) and lysosomal biogenesis transcription factors." .

<http://example.org/locx/sentence/37198709/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37198709/S8/position>,
        <http://example.org/locx/sentence/37198709/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37198709> .

<http://example.org/locx/sentence/37198709/S8/position> a oa:TextPositionSelector ;
    oa:end 1103 ;
    oa:start 969 .

<http://example.org/locx/sentence/37198709/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "However, the upregulated beta-GC activity in the lysosomes is independent of TFEB/TFE3 nuclear localization in STYXL1 knockdown cells." .

<http://example.org/locx/sentence/37237490/S7/position> a oa:TextPositionSelector ;
    oa:end 1119 ;
    oa:start 883 .

<http://example.org/locx/sentence/37237490/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This effect was not dependent on TFEB localization in nuclei or cytoplasm or on the transcription of different autophagy genes, but did correlate with the reduction in protein translation due to a strong eIF2alpha-Ser51 phosphorylation." .

<http://example.org/locx/sentence/37243374/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37243374/S12/position>,
        <http://example.org/locx/sentence/37243374/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37243374> .

<http://example.org/locx/sentence/37243374/S12/position> a oa:TextPositionSelector ;
    oa:end 1587 ;
    oa:start 1363 .

<http://example.org/locx/sentence/37243374/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "Subsequent studies showed that ATP13A2 overexpression promoted TFEB nuclear localization by inhibiting the phosphorylation of TFEB, thereby enhancing the transcription of PGD and ultimately affecting the activity of the PPP." .

<http://example.org/locx/sentence/37248958/S7/position> a oa:TextPositionSelector ;
    oa:end 908 ;
    oa:start 738 .

<http://example.org/locx/sentence/37248958/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Recent evidence suggests that infection with certain bacterial and viral pathogens causes TFEB, which is normally located in the cytoplasm, to translocate to the nucleus." .

<http://example.org/locx/sentence/37248958/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37248958/S9/position>,
        <http://example.org/locx/sentence/37248958/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37248958> .

<http://example.org/locx/sentence/37248958/S9/position> a oa:TextPositionSelector ;
    oa:end 1273 ;
    oa:start 1054 .

<http://example.org/locx/sentence/37248958/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "It is known that some pathogens modulate TFEB to establish themselves inside the host; in some cases, pathogens restrict TFEB to the cytoplasm, whereas in others, functional TFEB fuels pathogen survival and replication." .

<http://example.org/locx/sentence/37253404/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37253404/S10/position>,
        <http://example.org/locx/sentence/37253404/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37253404> .

<http://example.org/locx/sentence/37253404/S10/position> a oa:TextPositionSelector ;
    oa:end 1340 ;
    oa:start 1187 .

<http://example.org/locx/sentence/37253404/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, PA/TM induced autophagy impairment by reducing the nuclear translocation of transcription factor EB (TFEB) and inhibiting the activity of CTSB." .

<http://example.org/locx/sentence/37269887/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37269887/S9/position>,
        <http://example.org/locx/sentence/37269887/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37269887> .

<http://example.org/locx/sentence/37269887/S9/position> a oa:TextPositionSelector ;
    oa:end 1142 ;
    oa:start 958 .

<http://example.org/locx/sentence/37269887/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "By immunoblot, light and electron microscopy, we revealed that NE also transiently induced autophagy, mediated by increased expression levels and nuclear localization of TFEB and TFE3." .

<http://example.org/locx/sentence/37332877/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37332877/S8/position>,
        <http://example.org/locx/sentence/37332877/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37332877> .

<http://example.org/locx/sentence/37332877/S8/position> a oa:TextPositionSelector ;
    oa:end 1286 ;
    oa:start 1184 .

<http://example.org/locx/sentence/37332877/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Increased mTORC1 activity resulted in excess TFEB phosphorylation and decreased nuclear translocation." .

<http://example.org/locx/sentence/37366889/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37366889/S7/position>,
        <http://example.org/locx/sentence/37366889/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37366889> .

<http://example.org/locx/sentence/37366889/S7/position> a oa:TextPositionSelector ;
    oa:end 858 ;
    oa:start 740 .

<http://example.org/locx/sentence/37366889/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "We further investigated that GSK-3beta inhibition induced the nucleus translocation of transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/37482200/S2/position> a oa:TextPositionSelector ;
    oa:end 365 ;
    oa:start 144 .

<http://example.org/locx/sentence/37482200/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "The transcription factor EB (TFEB) is a transcription factor of the MiTF/TFE family that translocations from the cytoplasm to the nucleus in response to various stimuli, including lysosomal stress and nutrient starvation." .

<http://example.org/locx/sentence/37487100/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37487100/S7/position>,
        <http://example.org/locx/sentence/37487100/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37487100> .

<http://example.org/locx/sentence/37487100/S7/position> a oa:TextPositionSelector ;
    oa:end 1066 ;
    oa:start 888 .

<http://example.org/locx/sentence/37487100/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "LRRK2 negatively regulated the abundance and nuclear localization of these transcription factors and their depletion prevented LRRK2-dependent changes in lysosome protein levels." .

<http://example.org/locx/sentence/37545052/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37545052/S9/position>,
        <http://example.org/locx/sentence/37545052/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37545052> .

<http://example.org/locx/sentence/37545052/S9/position> a oa:TextPositionSelector ;
    oa:end 1521 ;
    oa:start 1215 .

<http://example.org/locx/sentence/37545052/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "This process involves activation of MTOR (mechanistic target of rapamycin kinase) activity, which leads to cytoplasmic accumulation of TFEB (transcription factor EB), a critical regulator of genes involved in the autophagy-lysosomal pathway, and consequently reduced expression of autophagy-lysosome genes." .

<http://example.org/locx/sentence/37569278/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37569278/S7/position>,
        <http://example.org/locx/sentence/37569278/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37569278> .

<http://example.org/locx/sentence/37569278/S7/position> a oa:TextPositionSelector ;
    oa:end 1125 ;
    oa:start 860 .

<http://example.org/locx/sentence/37569278/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, using human trophoblast cell models, treatment with HDAC inhibitor (HDACI)-trichostatin A (TSA) can induce autophagy by promoting nuclear translocation and transcriptional activity of the central autophagic regulator transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/37605006/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37605006/S6/position>,
        <http://example.org/locx/sentence/37605006/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37605006> .

<http://example.org/locx/sentence/37605006/S6/position> a oa:TextPositionSelector ;
    oa:end 1042 ;
    oa:start 809 .

<http://example.org/locx/sentence/37605006/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In degenerated NPCs, increased K141-methylation of PPP1CA disrupts its interaction with TEFB and subsequently blocks TEFB dephosphorylation and nuclear translocation, which eventually leads to autophagy deficiency and NPC senescence." .

<http://example.org/locx/sentence/37611054/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37611054/S7/position>,
        <http://example.org/locx/sentence/37611054/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37611054> .

<http://example.org/locx/sentence/37611054/S7/position> a oa:TextPositionSelector ;
    oa:end 1227 ;
    oa:start 954 .

<http://example.org/locx/sentence/37611054/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Transcription factor EB (TFEB) is a master regulator of lysosome biogenesis, Tp activates the mechanistic target of rapamycin complex 1 (mTORC1) signaling to inhibit the nuclear translocation of TFEB, leading to decreased lysosomal biogenesis and accumulated autophagosome." .

<http://example.org/locx/sentence/37739033/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37739033/S11/position>,
        <http://example.org/locx/sentence/37739033/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37739033> .

<http://example.org/locx/sentence/37739033/S11/position> a oa:TextPositionSelector ;
    oa:end 1779 ;
    oa:start 1612 .

<http://example.org/locx/sentence/37739033/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "The treatment inducing TDP-43 secretion increased the nuclear translocation of GFP-tagged TFEB, a master regulator of the autophagy-lysosomal pathway in SH-SY5Y cells." .

<http://example.org/locx/sentence/37745295/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37745295/S6/position>,
        <http://example.org/locx/sentence/37745295/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37745295> .

<http://example.org/locx/sentence/37745295/S6/position> a oa:TextPositionSelector ;
    oa:end 1012 ;
    oa:start 819 .

<http://example.org/locx/sentence/37745295/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In our present study, we find that CPZ treatment induces TFEB nuclear translocation through Rag GTPases, the upstream regulators of mechanistic target of rapamycin complex 1 (mTORC1) signaling." .

<http://example.org/locx/sentence/37749236/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37749236/S9/position>,
        <http://example.org/locx/sentence/37749236/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37749236> .

<http://example.org/locx/sentence/37749236/S9/position> a oa:TextPositionSelector ;
    oa:end 1233 ;
    oa:start 1063 .

<http://example.org/locx/sentence/37749236/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, S670 treatment induced ROS-mediated Nrf2 activation and TFEB nuclear translocation, promoting protective autophagosome and lysosome biogenesis in the GBM cells." .

<http://example.org/locx/sentence/37755761/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37755761/S8/position>,
        <http://example.org/locx/sentence/37755761/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37755761> .

<http://example.org/locx/sentence/37755761/S8/position> a oa:TextPositionSelector ;
    oa:end 1375 ;
    oa:start 1203 .

<http://example.org/locx/sentence/37755761/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "LO2 cell death, autophagy, and TFEB nuclear translocation were induced by AgNPs, which could be inhibited by lysosome inhibitor chloroquine (CQ) or siRNA specific for TFEB." .

<http://example.org/locx/sentence/37851191/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37851191/S11/position>,
        <http://example.org/locx/sentence/37851191/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37851191> .

<http://example.org/locx/sentence/37851191/S11/position> a oa:TextPositionSelector ;
    oa:end 1047 ;
    oa:start 968 .

<http://example.org/locx/sentence/37851191/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "PTPRC knockdown promoted the phosphorylation and nuclear translocation of TFEB." .

<http://example.org/locx/sentence/37885995/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37885995/S10/position>,
        <http://example.org/locx/sentence/37885995/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37885995> .

<http://example.org/locx/sentence/37885995/S10/position> a oa:TextPositionSelector ;
    oa:end 1284 ;
    oa:start 1146 .

<http://example.org/locx/sentence/37885995/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "The effects of MCU activation or inhibition on TFEB nuclear translocation in BC cells were detected by laser scanning confocal microscopy." .

<http://example.org/locx/sentence/37885995/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37885995/S13/position>,
        <http://example.org/locx/sentence/37885995/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37885995> .

<http://example.org/locx/sentence/37885995/S13/position> a oa:TextPositionSelector ;
    oa:end 1681 ;
    oa:start 1506 .

<http://example.org/locx/sentence/37885995/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "MCU overexpression promoted cellular migration, activated autophagy, and increased TFEB nuclear translocation in BC cells, whereas its knockdown produced the opposite effects." .

<http://example.org/locx/sentence/37904332/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37904332/S1/position>,
        <http://example.org/locx/sentence/37904332/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37904332> .

<http://example.org/locx/sentence/37904332/S1/position> a oa:TextPositionSelector ;
    oa:end 124 ;
    oa:start 0 .

<http://example.org/locx/sentence/37904332/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Luteolin induces ferroptosis in prostate cancer cells by promoting TFEB nuclear translocation and increasing ferritinophagy." .

<http://example.org/locx/sentence/37904332/S18> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37904332/S18/position>,
        <http://example.org/locx/sentence/37904332/S18/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37904332> .

<http://example.org/locx/sentence/37904332/S18/position> a oa:TextPositionSelector ;
    oa:end 2072 ;
    oa:start 1947 .

<http://example.org/locx/sentence/37904332/S18/quote> a oa:TextQuoteSelector ;
    oa:exact "CONCLUSIONS: Luteolin-induced ferroptosis in PCa cells by promoting TFEB nuclear translocation and increasing ferritinophagy." .

<http://example.org/locx/sentence/37909662/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37909662/S10/position>,
        <http://example.org/locx/sentence/37909662/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37909662> .

<http://example.org/locx/sentence/37909662/S10/position> a oa:TextPositionSelector ;
    oa:end 1286 ;
    oa:start 1168 .

<http://example.org/locx/sentence/37909662/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "We determined that LLOMe-mediated TFEB nuclear import is dependent on SMURF1 under the condition of MTORC1 inhibition." .

<http://example.org/locx/sentence/37909662/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37909662/S3/position>,
        <http://example.org/locx/sentence/37909662/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37909662> .

<http://example.org/locx/sentence/37909662/S3/position> a oa:TextPositionSelector ;
    oa:end 384 ;
    oa:start 259 .

<http://example.org/locx/sentence/37909662/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Starvation-induced MTOR inactivation and PPP3/calcineurin activation were shown to promote the nuclear translocation of TFEB." .

<http://example.org/locx/sentence/37909662/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/37909662/S6/position>,
        <http://example.org/locx/sentence/37909662/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/37909662> .

<http://example.org/locx/sentence/37909662/S6/position> a oa:TextPositionSelector ;
    oa:end 832 ;
    oa:start 698 .

<http://example.org/locx/sentence/37909662/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "We showed that blocking SMURF1 affected lysosomal biogenesis in response to lysosomal damage by preventing TFEB nuclear translocation." .

<http://example.org/locx/sentence/38066314/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38066314/S7/position>,
        <http://example.org/locx/sentence/38066314/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38066314> .

<http://example.org/locx/sentence/38066314/S7/position> a oa:TextPositionSelector ;
    oa:end 1087 ;
    oa:start 884 .

<http://example.org/locx/sentence/38066314/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "RCAN1 knockdown enhanced chromatin accessibility of genes involved in longevity and autophagy, mediated through enhanced calcineurin activity, leading to TFEB's nuclear localization by dephosphorylation." .

<http://example.org/locx/sentence/38158714/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38158714/S11/position>,
        <http://example.org/locx/sentence/38158714/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38158714> .

<http://example.org/locx/sentence/38158714/S11/position> a oa:TextPositionSelector ;
    oa:end 1510 ;
    oa:start 1314 .

<http://example.org/locx/sentence/38158714/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Gal-8 binds to the Ragulator-Rag complex at the lysosome membrane and inactivates mTORC1, leading to the nuclear translocation of downstream TFEB and initiation of autophagic lysosomal biogenesis." .

<http://example.org/locx/sentence/38180612/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38180612/S7/position>,
        <http://example.org/locx/sentence/38180612/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38180612> .

<http://example.org/locx/sentence/38180612/S7/position> a oa:TextPositionSelector ;
    oa:end 1031 ;
    oa:start 909 .

<http://example.org/locx/sentence/38180612/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In C9orf72-ALS, the nuclear translocation of TFEB autophagy factor decreased owing to nucleocytoplasmic transport defects." .

<http://example.org/locx/sentence/38180612/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38180612/S8/position>,
        <http://example.org/locx/sentence/38180612/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38180612> .

<http://example.org/locx/sentence/38180612/S8/position> a oa:TextPositionSelector ;
    oa:end 1240 ;
    oa:start 1032 .

<http://example.org/locx/sentence/38180612/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Our results showed that pretreatment of NSC34 cells with fluvoxamine promoted the shuttling of TFEB into the nucleus and elevated the expression of LC3-II compared to the overexpression of (G4C2)31-RNA alone." .

<http://example.org/locx/sentence/38180612/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38180612/S9/position>,
        <http://example.org/locx/sentence/38180612/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38180612> .

<http://example.org/locx/sentence/38180612/S9/position> a oa:TextPositionSelector ;
    oa:end 1340 ;
    oa:start 1241 .

<http://example.org/locx/sentence/38180612/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Additionally, even when used alone, fluvoxamine increases Pom121 expression and TFEB translocation." .

<http://example.org/locx/sentence/38203629/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38203629/S6/position>,
        <http://example.org/locx/sentence/38203629/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38203629> .

<http://example.org/locx/sentence/38203629/S6/position> a oa:TextPositionSelector ;
    oa:end 935 ;
    oa:start 728 .

<http://example.org/locx/sentence/38203629/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB was overexpressed and prominently nuclear in Tam-resistant MCF7 cells (MCF7-TamR) compared with their parental counterpart, and this was not dependent on alterations of its nucleo-cytoplasmic shuttling." .

<http://example.org/locx/sentence/38203629/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38203629/S7/position>,
        <http://example.org/locx/sentence/38203629/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38203629> .

<http://example.org/locx/sentence/38203629/S7/position> a oa:TextPositionSelector ;
    oa:end 1171 ;
    oa:start 936 .

<http://example.org/locx/sentence/38203629/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Tam promoted the release of lysosomal Ca2+ through the major transient receptor potential cation channel mucolipin subfamily member 1 (TRPML1) and two-pore channels (TPCs), which caused the nuclear translocation and activation of TFEB." .

<http://example.org/locx/sentence/38203629/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38203629/S9/position>,
        <http://example.org/locx/sentence/38203629/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38203629> .

<http://example.org/locx/sentence/38203629/S9/position> a oa:TextPositionSelector ;
    oa:end 1626 ;
    oa:start 1278 .

<http://example.org/locx/sentence/38203629/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Our findings demonstrate that Tam drives the nuclear relocation and transcriptional activation of TFEB by triggering the release of Ca2+ from the acidic compartment, and they suggest that lysosomal Ca2+ channels may represent new druggable targets to counteract the onset of autophagy-mediated endocrine resistance in luminal A breast cancer cells." .

<http://example.org/locx/sentence/38228650/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38228650/S10/position>,
        <http://example.org/locx/sentence/38228650/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38228650> .

<http://example.org/locx/sentence/38228650/S10/position> a oa:TextPositionSelector ;
    oa:end 1280 ;
    oa:start 1155 .

<http://example.org/locx/sentence/38228650/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear localization of TFEB was also reduced in mdx mice, which was associated with elevated phosphorylation levels of TFEB." .

<http://example.org/locx/sentence/38241809/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38241809/S10/position>,
        <http://example.org/locx/sentence/38241809/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38241809> .

<http://example.org/locx/sentence/38241809/S10/position> a oa:TextPositionSelector ;
    oa:end 1639 ;
    oa:start 1476 .

<http://example.org/locx/sentence/38241809/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Our results collectively indicate that PA is a strong inducer for TFEB phosphorylation modification at ser211 accompanied with lower nuclear translocation of TFEB." .

<http://example.org/locx/sentence/38241809/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38241809/S6/position>,
        <http://example.org/locx/sentence/38241809/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38241809> .

<http://example.org/locx/sentence/38241809/S6/position> a oa:TextPositionSelector ;
    oa:end 1066 ;
    oa:start 857 .

<http://example.org/locx/sentence/38241809/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "We found significant lipid accumulation, increased apoptosis, accompanied with elevated Ps211-TFEB, decreased nuclear TFEB, reduced lysosome biogenesis and insufficient autophagy in HK-2 cells treated with PA." .

<http://example.org/locx/sentence/38241809/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38241809/S7/position>,
        <http://example.org/locx/sentence/38241809/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38241809> .

<http://example.org/locx/sentence/38241809/S7/position> a oa:TextPositionSelector ;
    oa:end 1201 ;
    oa:start 1067 .

<http://example.org/locx/sentence/38241809/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Kidney tissues from patients with diabetic nephropathy had lower nuclear and total levels of TFEB than that in control kidney tissues." .

<http://example.org/locx/sentence/38241809/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38241809/S8/position>,
        <http://example.org/locx/sentence/38241809/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38241809> .

<http://example.org/locx/sentence/38241809/S8/position> a oa:TextPositionSelector ;
    oa:end 1279 ;
    oa:start 1202 .

<http://example.org/locx/sentence/38241809/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Level of renal nuclear TFEB in HFD rats was also lower than that in LFD rats." .

<http://example.org/locx/sentence/38241809/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38241809/S9/position>,
        <http://example.org/locx/sentence/38241809/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38241809> .

<http://example.org/locx/sentence/38241809/S9/position> a oa:TextPositionSelector ;
    oa:end 1475 ;
    oa:start 1280 .

<http://example.org/locx/sentence/38241809/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Exogenous overexpression of TFEB increased the nuclear TFEB level in HK-2 cells treated with PA, promoted lysosomal biogenesis, improved autophagic flux, reduced lipid accumulation and apoptosis." .

<http://example.org/locx/sentence/38250603/S8/position> a oa:TextPositionSelector ;
    oa:end 1537 ;
    oa:start 1208 .

<http://example.org/locx/sentence/38250603/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, the deficiency of DGKzeta disrupted the activation of AKT/mTOR signaling, the association between mTOR and TFEB, and favored the nuclear translocation of TFEB from the cytoplasm, leading to enhanced activation of Beclin1-mediated autophagy through ULK1/Beclin1 signaling and TFEB-dependent Beclin1 transcription." .

<http://example.org/locx/sentence/38261662/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38261662/S6/position>,
        <http://example.org/locx/sentence/38261662/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38261662> .

<http://example.org/locx/sentence/38261662/S6/position> a oa:TextPositionSelector ;
    oa:end 771 ;
    oa:start 629 .

<http://example.org/locx/sentence/38261662/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we reveal that PRMT-7 (protein arginine methyltransferase-7) is indispensable to the nuclear transactivation of HLH-30 elicited by PFTs." .

<http://example.org/locx/sentence/38261662/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38261662/S7/position>,
        <http://example.org/locx/sentence/38261662/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38261662> .

<http://example.org/locx/sentence/38261662/S7/position> a oa:TextPositionSelector ;
    oa:end 929 ;
    oa:start 772 .

<http://example.org/locx/sentence/38261662/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "We demonstrate that PRMT-7 participates in the methylation of HLH-30 on its RAG complex binding domain to facilitate its nuclear localization and activation." .

<http://example.org/locx/sentence/38261662/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38261662/S8/position>,
        <http://example.org/locx/sentence/38261662/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38261662> .

<http://example.org/locx/sentence/38261662/S8/position> a oa:TextPositionSelector ;
    oa:end 1094 ;
    oa:start 930 .

<http://example.org/locx/sentence/38261662/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, we showed that PRMT7 is evolutionarily conserved to regulate TFEB cellular localization and repair plasma damage caused by PFTs in human intestinal cells." .

<http://example.org/locx/sentence/38280941/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38280941/S11/position>,
        <http://example.org/locx/sentence/38280941/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38280941> .

<http://example.org/locx/sentence/38280941/S11/position> a oa:TextPositionSelector ;
    oa:end 1576 ;
    oa:start 1237 .

<http://example.org/locx/sentence/38280941/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, circEGFR facilitated the translocation of Annexin A2 (ANXA2) toward the plasma membrane in TNBC cells, which led to the release of Transcription Factor EB (a transcription factor of autophagy-related proteins, TFEB) from ANXA2-TFEB complex, causing nuclear translocation of TFEB, thereby promoting autophagy in TNBC cells." .

<http://example.org/locx/sentence/38368721/S12/position> a oa:TextPositionSelector ;
    oa:end 1224 ;
    oa:start 1104 .

<http://example.org/locx/sentence/38368721/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "Bortezomib promoted the nuclear translocation of TFEB, leading to decreased cytoplasmic TFEB and increased nuclear TFEB." .

<http://example.org/locx/sentence/38374070/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38374070/S6/position>,
        <http://example.org/locx/sentence/38374070/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38374070> .

<http://example.org/locx/sentence/38374070/S6/position> a oa:TextPositionSelector ;
    oa:end 965 ;
    oa:start 884 .

<http://example.org/locx/sentence/38374070/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "We observe enhanced TFEB nuclear translocation in alpha-syn-overexpressing cells." .

<http://example.org/locx/sentence/38383392/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38383392/S12/position>,
        <http://example.org/locx/sentence/38383392/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38383392> .

<http://example.org/locx/sentence/38383392/S12/position> a oa:TextPositionSelector ;
    oa:end 1591 ;
    oa:start 1405 .

<http://example.org/locx/sentence/38383392/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "However, treatment with the antioxidant N-acetyl-l-cysteine (NAC) and the autophagy inhibitor chloroquine impeded the nuclear translocation of TFEB and attenuated peroxisome degradation." .

<http://example.org/locx/sentence/38383392/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38383392/S7/position>,
        <http://example.org/locx/sentence/38383392/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38383392> .

<http://example.org/locx/sentence/38383392/S7/position> a oa:TextPositionSelector ;
    oa:end 833 ;
    oa:start 731 .

<http://example.org/locx/sentence/38383392/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In response to oxidative stress, lysosomal calcium mediates transcription factor EB (TFEB) activation." .

<http://example.org/locx/sentence/38383507/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38383507/S9/position>,
        <http://example.org/locx/sentence/38383507/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38383507> .

<http://example.org/locx/sentence/38383507/S9/position> a oa:TextPositionSelector ;
    oa:end 1570 ;
    oa:start 1372 .

<http://example.org/locx/sentence/38383507/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "The protein expression and nuclear translocation of transcription factor EB (TFEB), the key regulator of lysosomal and autophagic function, were also impaired by the AOPP-activated ROS-mTOR pathway." .

<http://example.org/locx/sentence/38396745/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38396745/S7/position>,
        <http://example.org/locx/sentence/38396745/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38396745> .

<http://example.org/locx/sentence/38396745/S7/position> a oa:TextPositionSelector ;
    oa:end 1509 ;
    oa:start 1284 .

<http://example.org/locx/sentence/38396745/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In the absence of the GATOR1 complex, cells are refractory to PI3K-dependent inhibition of mTORC1, permitting sustained translation and restricting the nuclear localization of TFEB, a transcription factor regulated by mTORC1." .

<http://example.org/locx/sentence/38536415/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38536415/S5/position>,
        <http://example.org/locx/sentence/38536415/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38536415> .

<http://example.org/locx/sentence/38536415/S5/position> a oa:TextPositionSelector ;
    oa:end 956 ;
    oa:start 759 .

<http://example.org/locx/sentence/38536415/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here we find a form of microautophagy induction that requires activity of the lipid kinase PIKfyve and is associated with the nuclear translocation of TFEB, a known mediator of lysosome biogenesis." .

<http://example.org/locx/sentence/38554522/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38554522/S10/position>,
        <http://example.org/locx/sentence/38554522/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38554522> .

<http://example.org/locx/sentence/38554522/S10/position> a oa:TextPositionSelector ;
    oa:end 1499 ;
    oa:start 1282 .

<http://example.org/locx/sentence/38554522/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, ITA mainly promotes the nuclear translocation of transcription factor EB (TFEB) to facilitate dysfunctional mitochondrial clearance and reduces apoptosis in AEC II cells by regulating autophagic flux." .

<http://example.org/locx/sentence/38579922/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38579922/S8/position>,
        <http://example.org/locx/sentence/38579922/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38579922> .

<http://example.org/locx/sentence/38579922/S8/position> a oa:TextPositionSelector ;
    oa:end 1401 ;
    oa:start 1223 .

<http://example.org/locx/sentence/38579922/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Conversely, treatment with trehalose, a known activator of TFEB promote TFEB nuclear translocation suggesting that TFEB plays an important role in protection against SW toxicity." .

<http://example.org/locx/sentence/38581586/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38581586/S10/position>,
        <http://example.org/locx/sentence/38581586/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38581586> .

<http://example.org/locx/sentence/38581586/S10/position> a oa:TextPositionSelector ;
    oa:end 1860 ;
    oa:start 1660 .

<http://example.org/locx/sentence/38581586/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "In aSyn-negative cells, cytoplasmic TFEB clusters were more frequently observed in GBA-PD/DLB and iLBD patients, and correlated with reduced GBA enzymatic activity as well as increased Braak LB stage." .

<http://example.org/locx/sentence/38581586/S12/position> a oa:TextPositionSelector ;
    oa:end 2209 ;
    oa:start 2051 .

<http://example.org/locx/sentence/38581586/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "Overall, we observed cytoplasmic TFEB retention and accumulation at the Golgi in cells without apparent pSer129 aSyn accumulation in iLBD and PD/DLB patients." .

<http://example.org/locx/sentence/38581586/S3/position> a oa:TextPositionSelector ;
    oa:end 486 ;
    oa:start 409 .

<http://example.org/locx/sentence/38581586/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB activation results in its translocation from the cytosol to the nucleus." .

<http://example.org/locx/sentence/38581586/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38581586/S6/position>,
        <http://example.org/locx/sentence/38581586/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38581586> .

<http://example.org/locx/sentence/38581586/S6/position> a oa:TextPositionSelector ;
    oa:end 1146 ;
    oa:start 990 .

<http://example.org/locx/sentence/38581586/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "We observed reduced nuclear TFEB immunoreactivity in PD/DLB patients compared to controls, both in sporadic and GBA-related cases, as well as in iLBD cases." .

<http://example.org/locx/sentence/38581586/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38581586/S7/position>,
        <http://example.org/locx/sentence/38581586/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38581586> .

<http://example.org/locx/sentence/38581586/S7/position> a oa:TextPositionSelector ;
    oa:end 1273 ;
    oa:start 1147 .

<http://example.org/locx/sentence/38581586/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear depletion of TFEB was more pronounced in neurons with Ser129-phosphorylated (pSer129) aSyn accumulation in all groups." .

<http://example.org/locx/sentence/38581586/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38581586/S8/position>,
        <http://example.org/locx/sentence/38581586/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38581586> .

<http://example.org/locx/sentence/38581586/S8/position> a oa:TextPositionSelector ;
    oa:end 1434 ;
    oa:start 1274 .

<http://example.org/locx/sentence/38581586/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, we observed previously-unidentified TFEB-immunopositive perinuclear clusters in human dopaminergic neurons, which localized at the Golgi apparatus." .

<http://example.org/locx/sentence/38615740/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38615740/S10/position>,
        <http://example.org/locx/sentence/38615740/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38615740> .

<http://example.org/locx/sentence/38615740/S10/position> a oa:TextPositionSelector ;
    oa:end 1821 ;
    oa:start 1687 .

<http://example.org/locx/sentence/38615740/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Molecular docking and experimental studies suggest that UA block the recognition of TFEB by 1433 and induce TFEB nuclear localization." .

<http://example.org/locx/sentence/38615740/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38615740/S9/position>,
        <http://example.org/locx/sentence/38615740/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38615740> .

<http://example.org/locx/sentence/38615740/S9/position> a oa:TextPositionSelector ;
    oa:end 1686 ;
    oa:start 1233 .

<http://example.org/locx/sentence/38615740/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, UA induced the key regulator of autophagy, transcription factor EB (TFEB), into the nucleus in a partially mTOR-dependent manner and inhibited the ubiquitination degradation of TFEB, which facilitated the clearance of damaged mitochondria via the mitophagy-lysosomal pathway in macrophages under tumor supernatant stress, and reduced the deleterious inflammatory factors induced by the release of nucleic acid from damaged mitochondria." .

<http://example.org/locx/sentence/38616177/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38616177/S6/position>,
        <http://example.org/locx/sentence/38616177/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38616177> .

<http://example.org/locx/sentence/38616177/S6/position> a oa:TextPositionSelector ;
    oa:end 998 ;
    oa:start 727 .

<http://example.org/locx/sentence/38616177/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Simultaneously, TXNIP interference inhibited epithelial-to-mesenchymal transformation (EMT), collagen I and fibronectin expression, and mTORC1 activation, increased TFEB nuclear translocation, and promoted autophagy restoration in HK-2 cells exposed to high glucose (HG)." .

<http://example.org/locx/sentence/38616177/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38616177/S7/position>,
        <http://example.org/locx/sentence/38616177/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38616177> .

<http://example.org/locx/sentence/38616177/S7/position> a oa:TextPositionSelector ;
    oa:end 1119 ;
    oa:start 999 .

<http://example.org/locx/sentence/38616177/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Rapamycin, an inhibitor of mTORC1, increased TFEB nuclear translocation and autophagy in HK-2 cells under HG conditions." .

<http://example.org/locx/sentence/38738312/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38738312/S8/position>,
        <http://example.org/locx/sentence/38738312/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38738312> .

<http://example.org/locx/sentence/38738312/S8/position> a oa:TextPositionSelector ;
    oa:end 1274 ;
    oa:start 1055 .

<http://example.org/locx/sentence/38738312/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Our results showed that p-NP reduced the expression of Prolactin protein, increased the nuclear localization of TFEB, and induced the increase and translocation of the lysosomal protein LAMP-1 to the membrane of tHESCs." .

<http://example.org/locx/sentence/38759815/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38759815/S9/position>,
        <http://example.org/locx/sentence/38759815/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38759815> .

<http://example.org/locx/sentence/38759815/S9/position> a oa:TextPositionSelector ;
    oa:end 1131 ;
    oa:start 1018 .

<http://example.org/locx/sentence/38759815/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, Irgm1 orchestrates autophagy in LECs by inhibiting mTOR and facilitating nuclear translocation of Tfeb." .

<http://example.org/locx/sentence/38797513/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38797513/S8/position>,
        <http://example.org/locx/sentence/38797513/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38797513> .

<http://example.org/locx/sentence/38797513/S8/position> a oa:TextPositionSelector ;
    oa:end 916 ;
    oa:start 780 .

<http://example.org/locx/sentence/38797513/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, TMX2 was demonstrated to promote macroautophagy/autophagy by facilitating KPNB1 nuclear export and TFEB nuclear import." .

<http://example.org/locx/sentence/38838134/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38838134/S5/position>,
        <http://example.org/locx/sentence/38838134/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38838134> .

<http://example.org/locx/sentence/38838134/S5/position> a oa:TextPositionSelector ;
    oa:end 984 ;
    oa:start 735 .

<http://example.org/locx/sentence/38838134/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Myofiber-specific FNIP1 deficiency stimulated expression of nuclear translocation of transcription factor EB, thereby activating transcription of insulin-like growth factor 2 (Igf2) at a conserved promoter-binding site and subsequent IGF2 secretion." .

<http://example.org/locx/sentence/38850787/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38850787/S7/position>,
        <http://example.org/locx/sentence/38850787/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38850787> .

<http://example.org/locx/sentence/38850787/S7/position> a oa:TextPositionSelector ;
    oa:end 1141 ;
    oa:start 933 .

<http://example.org/locx/sentence/38850787/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Nicotine treatment impaired autophagy flux by regulating the AMPK/mTOR signaling pathway, impeding the nuclear translocation of transcription factor EB (TFEB), and reducing the activity of cathepsin B (CTSB)." .

<http://example.org/locx/sentence/38888347/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38888347/S7/position>,
        <http://example.org/locx/sentence/38888347/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38888347> .

<http://example.org/locx/sentence/38888347/S7/position> a oa:TextPositionSelector ;
    oa:end 958 ;
    oa:start 739 .

<http://example.org/locx/sentence/38888347/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "The 3C protease of EV-D68 cleaves TFEB at the N-terminus at glutamine 60 (Q60) immediately post-peak viral RNA replication, disrupting TFEB-RagC interaction and restricting TFEB transport to the surface of the lysosome." .

<http://example.org/locx/sentence/38888347/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38888347/S8/position>,
        <http://example.org/locx/sentence/38888347/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38888347> .

<http://example.org/locx/sentence/38888347/S8/position> a oa:TextPositionSelector ;
    oa:end 1028 ;
    oa:start 959 .

<http://example.org/locx/sentence/38888347/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Despite this, TFEB remained mostly cytosolic during EV-D68 infection." .

<http://example.org/locx/sentence/38901414/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38901414/S6/position>,
        <http://example.org/locx/sentence/38901414/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38901414> .

<http://example.org/locx/sentence/38901414/S6/position> a oa:TextPositionSelector ;
    oa:end 867 ;
    oa:start 689 .

<http://example.org/locx/sentence/38901414/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "This disruption hinders the the nuclear translocation and transcriptional activity of the transcription factor EB (TFEB) a crucial regulator of lysosomal and autophagic function." .

<http://example.org/locx/sentence/38914593/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38914593/S7/position>,
        <http://example.org/locx/sentence/38914593/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38914593> .

<http://example.org/locx/sentence/38914593/S7/position> a oa:TextPositionSelector ;
    oa:end 1169 ;
    oa:start 935 .

<http://example.org/locx/sentence/38914593/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Pharmacological inhibition of Akt using MK2206 or Akti-1/2 enhanced aggrephagy by promoting dephosphorylation and nuclear translocation of transcription factor EB (TFEB)/transcription factor E3 (TFE3), lysosomal transcription factors." .

<http://example.org/locx/sentence/38923811/S9/position> a oa:TextPositionSelector ;
    oa:end 1009 ;
    oa:start 862 .

<http://example.org/locx/sentence/38923811/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "This activation prompts transcription factor EB (TFEB) to translocate from the cytosol to the nucleus in a dose-dependent manner within live cells." .

<http://example.org/locx/sentence/38926803/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38926803/S14/position>,
        <http://example.org/locx/sentence/38926803/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38926803> .

<http://example.org/locx/sentence/38926803/S14/position> a oa:TextPositionSelector ;
    oa:end 2144 ;
    oa:start 1921 .

<http://example.org/locx/sentence/38926803/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "Subsequently, TRIM25 promotes the nuclear translocation of transcription factor EB (TFEB) and transcription of autophagy related genes by increasing K63-polyubiquitination of TFEB, thereby reducing tumor sensitivity to PTX." .

<http://example.org/locx/sentence/38944674/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38944674/S5/position>,
        <http://example.org/locx/sentence/38944674/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38944674> .

<http://example.org/locx/sentence/38944674/S5/position> a oa:TextPositionSelector ;
    oa:end 721 ;
    oa:start 529 .

<http://example.org/locx/sentence/38944674/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, reactive oxygen species (ROS) stimulate the nuclear translocation of transcription factor EB (TFEB), leading to the upregulation of both HEXB and its antisense lncRNA HEXB-AS." .

<http://example.org/locx/sentence/38965447/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38965447/S7/position>,
        <http://example.org/locx/sentence/38965447/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38965447> .

<http://example.org/locx/sentence/38965447/S7/position> a oa:TextPositionSelector ;
    oa:end 1256 ;
    oa:start 852 .

<http://example.org/locx/sentence/38965447/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Indeed, using in vitro models of syncytialization, we demonstrated that TFEB translocates into the nucleus during syncytiotrophoblast formation and binds to the promoters of crucial placental genes, including genes encoding fusogenic proteins (Syncytin-1 and Syncytin-2) and enzymes involved in steroidogenic pathways, such as CYP19A1, the rate-limiting enzyme for the synthesis of 17beta-Estradiol (E2)." .

<http://example.org/locx/sentence/38971541/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38971541/S8/position>,
        <http://example.org/locx/sentence/38971541/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38971541> .

<http://example.org/locx/sentence/38971541/S8/position> a oa:TextPositionSelector ;
    oa:end 1083 ;
    oa:start 974 .

<http://example.org/locx/sentence/38971541/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Concurrently, it enhanced the dephosphorylation, nuclear translocation, and transcriptional activity of TFEB." .

<http://example.org/locx/sentence/38971541/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/38971541/S9/position>,
        <http://example.org/locx/sentence/38971541/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/38971541> .

<http://example.org/locx/sentence/38971541/S9/position> a oa:TextPositionSelector ;
    oa:end 1210 ;
    oa:start 1084 .

<http://example.org/locx/sentence/38971541/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "The aggregation of TFEB in nucleus triggered FTH1-dependent ferritinophagy, leading to lysosomal activation and iron overload." .

<http://example.org/locx/sentence/39009859/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39009859/S5/position>,
        <http://example.org/locx/sentence/39009859/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39009859> .

<http://example.org/locx/sentence/39009859/S5/position> a oa:TextPositionSelector ;
    oa:end 783 ;
    oa:start 621 .

<http://example.org/locx/sentence/39009859/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Notably, upon induction of autophagy by Torin 1, Tau35 inhibited nuclear translocation of transcription factor EB (TFEB), a key regulator of lysosomal biogenesis." .

<http://example.org/locx/sentence/39029574/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39029574/S8/position>,
        <http://example.org/locx/sentence/39029574/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39029574> .

<http://example.org/locx/sentence/39029574/S8/position> a oa:TextPositionSelector ;
    oa:end 968 ;
    oa:start 853 .

<http://example.org/locx/sentence/39029574/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanism study revealed that ROS accumulation induced TFEB nuclear translocation, followed by increased autophagy." .

<http://example.org/locx/sentence/39033876/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39033876/S10/position>,
        <http://example.org/locx/sentence/39033876/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39033876> .

<http://example.org/locx/sentence/39033876/S10/position> a oa:TextPositionSelector ;
    oa:end 1492 ;
    oa:start 1327 .

<http://example.org/locx/sentence/39033876/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Meanwhile, Cd activated general control non-repressed protein 5 (GCN5) to enhance nuclear TFEB acetylation, resulting in the decreased TFEB transcriptional activity." .

<http://example.org/locx/sentence/39033876/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39033876/S6/position>,
        <http://example.org/locx/sentence/39033876/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39033876> .

<http://example.org/locx/sentence/39033876/S6/position> a oa:TextPositionSelector ;
    oa:end 804 ;
    oa:start 623 .

<http://example.org/locx/sentence/39033876/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "METHODS AND RESULTS: Data firstly showed that reduced TFEB expression and nuclear translocation were evident in Cd-induced AKI models, accompanied by autophagy-lysosome dysfunction." .

<http://example.org/locx/sentence/39033876/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39033876/S8/position>,
        <http://example.org/locx/sentence/39033876/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39033876> .

<http://example.org/locx/sentence/39033876/S8/position> a oa:TextPositionSelector ;
    oa:end 1237 ;
    oa:start 1074 .

<http://example.org/locx/sentence/39033876/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, Cd activated mechanistic target of rapamycin complex 1 (mTORC1) to enhance TFEB phosphorylation and thereby inhibiting TFEB nuclear translocation." .

<http://example.org/locx/sentence/39033876/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39033876/S9/position>,
        <http://example.org/locx/sentence/39033876/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39033876> .

<http://example.org/locx/sentence/39033876/S9/position> a oa:TextPositionSelector ;
    oa:end 1326 ;
    oa:start 1238 .

<http://example.org/locx/sentence/39033876/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Cd also activated chromosome region maintenance 1 (CRM1) to promote TFEB nuclear export." .

<http://example.org/locx/sentence/39047035/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39047035/S5/position>,
        <http://example.org/locx/sentence/39047035/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39047035> .

<http://example.org/locx/sentence/39047035/S5/position> a oa:TextPositionSelector ;
    oa:end 934 ;
    oa:start 700 .

<http://example.org/locx/sentence/39047035/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In Irp2-deficient liver tissue or macrophages, the nuclear location of transcription factor EB (Tfeb) was remarkably reduced, leading to the downregulation of Tfeb target genes that encode critical components for lysosomal biogenesis." .

<http://example.org/locx/sentence/39047035/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39047035/S8/position>,
        <http://example.org/locx/sentence/39047035/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39047035> .

<http://example.org/locx/sentence/39047035/S8/position> a oa:TextPositionSelector ;
    oa:end 1607 ;
    oa:start 1362 .

<http://example.org/locx/sentence/39047035/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Overall, our study highlights a mechanism whereby Irp2 supports nuclear translocation of Tfeb and lysosomal function, preserving macrophage antimicrobial activity and protecting the liver against invading bacteria during intestinal inflammation." .

<http://example.org/locx/sentence/39081292/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39081292/S1/position>,
        <http://example.org/locx/sentence/39081292/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39081292> .

<http://example.org/locx/sentence/39081292/S1/position> a oa:TextPositionSelector ;
    oa:end 70 ;
    oa:start 0 .

<http://example.org/locx/sentence/39081292/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Targeted dephosphorylation of TFEB promotes its nuclear translocation." .

<http://example.org/locx/sentence/39081292/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39081292/S3/position>,
        <http://example.org/locx/sentence/39081292/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39081292> .

<http://example.org/locx/sentence/39081292/S3/position> a oa:TextPositionSelector ;
    oa:end 314 ;
    oa:start 200 .

<http://example.org/locx/sentence/39081292/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "During nutrient replete and stressor-free conditions, phosphorylated TFEB is primarily localized to the cytoplasm." .

<http://example.org/locx/sentence/39081292/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39081292/S4/position>,
        <http://example.org/locx/sentence/39081292/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39081292> .

<http://example.org/locx/sentence/39081292/S4/position> a oa:TextPositionSelector ;
    oa:end 449 ;
    oa:start 315 .

<http://example.org/locx/sentence/39081292/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Stressor-mediated reduction of TFEB phosphorylation promotes its nuclear translocation and context-dependent transcriptional activity." .

<http://example.org/locx/sentence/39081292/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39081292/S8/position>,
        <http://example.org/locx/sentence/39081292/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39081292> .

<http://example.org/locx/sentence/39081292/S8/position> a oa:TextPositionSelector ;
    oa:end 1164 ;
    oa:start 981 .

<http://example.org/locx/sentence/39081292/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Targeted dephosphorylation of TFEB-dTAG by bromoTAG-PPP2CA with BDPIC at the endogenous levels is sufficient to induce nuclear translocation and some transcriptional activity of TFEB." .

<http://example.org/locx/sentence/39107320/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39107320/S5/position>,
        <http://example.org/locx/sentence/39107320/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39107320> .

<http://example.org/locx/sentence/39107320/S5/position> a oa:TextPositionSelector ;
    oa:end 903 ;
    oa:start 697 .

<http://example.org/locx/sentence/39107320/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Conversely, PDCD4 deficiency significantly augmented global and nuclear TFE3 and TFEB distributions to alleviate neurodegeneration in a mouse model of PD with overexpressing alpha-synuclein in the striatum." .

<http://example.org/locx/sentence/39173889/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39173889/S9/position>,
        <http://example.org/locx/sentence/39173889/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39173889> .

<http://example.org/locx/sentence/39173889/S9/position> a oa:TextPositionSelector ;
    oa:end 1334 ;
    oa:start 1159 .

<http://example.org/locx/sentence/39173889/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, TRPML1 activation allows more Ca2+ to permeate from the lysosome into the cytoplasm, resulting in the dephosphorylation of TFEB and its nuclear translocation." .

<http://example.org/locx/sentence/39226078/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39226078/S8/position>,
        <http://example.org/locx/sentence/39226078/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39226078> .

<http://example.org/locx/sentence/39226078/S8/position> a oa:TextPositionSelector ;
    oa:end 1203 ;
    oa:start 1084 .

<http://example.org/locx/sentence/39226078/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, AS I inhibits the protein level of p-TFEB (ser211) expression and promotes TFEB nuclear translocation." .

<http://example.org/locx/sentence/39226078/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39226078/S9/position>,
        <http://example.org/locx/sentence/39226078/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39226078> .

<http://example.org/locx/sentence/39226078/S9/position> a oa:TextPositionSelector ;
    oa:end 1329 ;
    oa:start 1204 .

<http://example.org/locx/sentence/39226078/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "The activation of TFEB by AS I was impeded upon the introduction of the mammalian target of rapamycin (mTOR) agonist MHY1485." .

<http://example.org/locx/sentence/39324484/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39324484/S2/position>,
        <http://example.org/locx/sentence/39324484/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39324484> .

<http://example.org/locx/sentence/39324484/S2/position> a oa:TextPositionSelector ;
    oa:end 299 ;
    oa:start 106 .

<http://example.org/locx/sentence/39324484/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "The calcium-activated phosphatase PPP3/calcineurin dephosphorylates TFEB (transcription factor EB) to trigger its nuclear translocation and the activation of macroautophagic/autophagic targets." .

<http://example.org/locx/sentence/39332541/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39332541/S10/position>,
        <http://example.org/locx/sentence/39332541/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39332541> .

<http://example.org/locx/sentence/39332541/S10/position> a oa:TextPositionSelector ;
    oa:end 1558 ;
    oa:start 1390 .

<http://example.org/locx/sentence/39332541/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "During nutrient deprivation or exercise, AMPK activation inhibits mTORC1, facilitating TFEB/TFE3 nuclear translocation and promoting lysosomal biogenesis and autophagy." .

<http://example.org/locx/sentence/39332541/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39332541/S9/position>,
        <http://example.org/locx/sentence/39332541/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39332541> .

<http://example.org/locx/sentence/39332541/S9/position> a oa:TextPositionSelector ;
    oa:end 1389 ;
    oa:start 1214 .

<http://example.org/locx/sentence/39332541/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "mTORC1, a key nutrient sensor, modulates lysosomal activity by inhibiting TFEB/TFE3 translocation to the nucleus under nutrient-rich conditions, thereby suppressing autophagy." .

<http://example.org/locx/sentence/39391005/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39391005/S9/position>,
        <http://example.org/locx/sentence/39391005/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39391005> .

<http://example.org/locx/sentence/39391005/S9/position> a oa:TextPositionSelector ;
    oa:end 1216 ;
    oa:start 1061 .

<http://example.org/locx/sentence/39391005/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "This promotes FNIP1-mediated nuclear translocation of the transcription factor TFEB and the subsequent induction of lysosomal and mitochondrial biogenesis." .

<http://example.org/locx/sentence/39424220/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39424220/S14/position>,
        <http://example.org/locx/sentence/39424220/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39424220> .

<http://example.org/locx/sentence/39424220/S14/position> a oa:TextPositionSelector ;
    oa:end 1617 ;
    oa:start 1529 .

<http://example.org/locx/sentence/39424220/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "4-HNE increased TFEB nuclear translocation which was reversed by LAMTOR1 overexpression." .

<http://example.org/locx/sentence/39438678/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39438678/S1/position>,
        <http://example.org/locx/sentence/39438678/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39438678> .

<http://example.org/locx/sentence/39438678/S1/position> a oa:TextPositionSelector ;
    oa:end 154 ;
    oa:start 0 .

<http://example.org/locx/sentence/39438678/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "Lysosomal Ca2+ release-facilitated TFEB nuclear translocation alleviates ischemic brain injury by attenuating autophagic/lysosomal dysfunction in neurons." .

<http://example.org/locx/sentence/39438678/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39438678/S3/position>,
        <http://example.org/locx/sentence/39438678/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39438678> .

<http://example.org/locx/sentence/39438678/S3/position> a oa:TextPositionSelector ;
    oa:end 478 ;
    oa:start 321 .

<http://example.org/locx/sentence/39438678/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Autophagic/lysosomal signaling could be augmented after transcription factor EB (TFEB) nuclear translocation, which was facilitated by its dephosphorylation." .

<http://example.org/locx/sentence/39438678/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39438678/S5/position>,
        <http://example.org/locx/sentence/39438678/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39438678> .

<http://example.org/locx/sentence/39438678/S5/position> a oa:TextPositionSelector ;
    oa:end 942 ;
    oa:start 679 .

<http://example.org/locx/sentence/39438678/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Our research shows that ML-SA1, an agonist of the TRPML1 channel, significantly enhanced the lysosomal Ca2+ release and the CaN expression in penumbric neurons, subsequently promoted TFEB nuclear translocation, and greatly reversed autophagy/lysosome dysfunction." .

<http://example.org/locx/sentence/39438678/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39438678/S8/position>,
        <http://example.org/locx/sentence/39438678/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39438678> .

<http://example.org/locx/sentence/39438678/S8/position> a oa:TextPositionSelector ;
    oa:end 1440 ;
    oa:start 1240 .

<http://example.org/locx/sentence/39438678/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "These studies suggest that TRPML1 elevation alleviates ischemic brain injury by restoring autophagic/lysosomal dysfunction via Lysosomal Ca2+ release-facilitated TFEB nuclear translocation in neurons." .

<http://example.org/locx/sentence/39454991/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39454991/S8/position>,
        <http://example.org/locx/sentence/39454991/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39454991> .

<http://example.org/locx/sentence/39454991/S8/position> a oa:TextPositionSelector ;
    oa:end 1188 ;
    oa:start 998 .

<http://example.org/locx/sentence/39454991/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistic investigation revealed that PCRR water extract inhibited the activity of MTORC1, thereby dephosphorylating and hence inducing nuclear translocation of the lipophagy inducer TFEB." .

<http://example.org/locx/sentence/39486418/S3/position> a oa:TextPositionSelector ;
    oa:end 349 ;
    oa:start 173 .

<http://example.org/locx/sentence/39486418/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "A key determinant of mTORC1 activity is its shuttling between the lysosomal surface and the cytoplasm, with nutrients promoting its recruitment to lysosomes by the Rag GTPases." .

<http://example.org/locx/sentence/39486418/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39486418/S6/position>,
        <http://example.org/locx/sentence/39486418/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39486418> .

<http://example.org/locx/sentence/39486418/S6/position> a oa:TextPositionSelector ;
    oa:end 873 ;
    oa:start 653 .

<http://example.org/locx/sentence/39486418/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we show that, in human cells, mTORC1 inhibition prevents its release from lysosomes, even under starvation conditions, which is accompanied by elevated and sustained phosphorylation of its lysosomal substrate TFEB." .

<http://example.org/locx/sentence/39489201/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39489201/S1/position>,
        <http://example.org/locx/sentence/39489201/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39489201> .

<http://example.org/locx/sentence/39489201/S1/position> a oa:TextPositionSelector ;
    oa:end 103 ;
    oa:start 0 .

<http://example.org/locx/sentence/39489201/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "STIM1 promotes cervical cancer progression through autophagy activation via TFEB nuclear translocation." .

<http://example.org/locx/sentence/39489201/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39489201/S10/position>,
        <http://example.org/locx/sentence/39489201/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39489201> .

<http://example.org/locx/sentence/39489201/S10/position> a oa:TextPositionSelector ;
    oa:end 1581 ;
    oa:start 1432 .

<http://example.org/locx/sentence/39489201/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "CONCLUSION: STIM1 can promote autophagy and accelerate cervical cancer progression by increasing TFEB nuclear translocation of cervical cancer cells." .

<http://example.org/locx/sentence/39489201/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39489201/S9/position>,
        <http://example.org/locx/sentence/39489201/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39489201> .

<http://example.org/locx/sentence/39489201/S9/position> a oa:TextPositionSelector ;
    oa:end 1431 ;
    oa:start 1362 .

<http://example.org/locx/sentence/39489201/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Knockdown STIM1 can inhibit autophagy and TFEB nuclear translocation." .

<http://example.org/locx/sentence/39547882/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39547882/S3/position>,
        <http://example.org/locx/sentence/39547882/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39547882> .

<http://example.org/locx/sentence/39547882/S3/position> a oa:TextPositionSelector ;
    oa:end 406 ;
    oa:start 205 .

<http://example.org/locx/sentence/39547882/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "A recent study by Lv et al. reports that STING activation also simultaneously promotes lysosomal biogenesis by inducing nuclear translocation of the transcription factors TFEB/TFE3 independent of TBK1." .

<http://example.org/locx/sentence/39571950/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39571950/S7/position>,
        <http://example.org/locx/sentence/39571950/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39571950> .

<http://example.org/locx/sentence/39571950/S7/position> a oa:TextPositionSelector ;
    oa:end 935 ;
    oa:start 786 .

<http://example.org/locx/sentence/39571950/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Further analysis revealed that ITA's beneficial effects are mediated through the promotion of TFEB nuclear translocation, thereby augmenting the ALP." .

<http://example.org/locx/sentence/39647321/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39647321/S7/position>,
        <http://example.org/locx/sentence/39647321/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39647321> .

<http://example.org/locx/sentence/39647321/S7/position> a oa:TextPositionSelector ;
    oa:end 1191 ;
    oa:start 1059 .

<http://example.org/locx/sentence/39647321/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In addition, ML-SA5 promotes the nuclear translocation of transcription factor EB (TFEB) in renal PTECs in acute U intoxicated mice." .

<http://example.org/locx/sentence/39663580/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39663580/S5/position>,
        <http://example.org/locx/sentence/39663580/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39663580> .

<http://example.org/locx/sentence/39663580/S5/position> a oa:TextPositionSelector ;
    oa:end 531 ;
    oa:start 351 .

<http://example.org/locx/sentence/39663580/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Through cell-based drug screening, we identified two antidepressants, sertraline and indatraline, as potent inducers of the nuclear translocation of TFEB (transcription factor EB)." .

<http://example.org/locx/sentence/39689715/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39689715/S5/position>,
        <http://example.org/locx/sentence/39689715/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39689715> .

<http://example.org/locx/sentence/39689715/S5/position> a oa:TextPositionSelector ;
    oa:end 855 ;
    oa:start 619 .

<http://example.org/locx/sentence/39689715/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "STING activation enhanced lysosome biogenesis through inducing the nuclear translocation of transcription factor EB (TFEB) as well as its paralogs transcription factor E3 (TFE3) and microphthalmia-associated transcription factor (MITF)." .

<http://example.org/locx/sentence/39699959/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39699959/S5/position>,
        <http://example.org/locx/sentence/39699959/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39699959> .

<http://example.org/locx/sentence/39699959/S5/position> a oa:TextPositionSelector ;
    oa:end 695 ;
    oa:start 561 .

<http://example.org/locx/sentence/39699959/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "First, we found that nuclear TFEB localization in proximal tubular epithelial cells (PTECs) declined with age in both mice and humans." .

<http://example.org/locx/sentence/39699959/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39699959/S8/position>,
        <http://example.org/locx/sentence/39699959/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39699959> .

<http://example.org/locx/sentence/39699959/S8/position> a oa:TextPositionSelector ;
    oa:end 1078 ;
    oa:start 928 .

<http://example.org/locx/sentence/39699959/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Supporting this result, we identified markedly decreased nuclear TFEB localization in the proximal tubules of elderly patients with APOA4 amyloidosis." .

<http://example.org/locx/sentence/39710154/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39710154/S10/position>,
        <http://example.org/locx/sentence/39710154/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39710154> .

<http://example.org/locx/sentence/39710154/S10/position> a oa:TextPositionSelector ;
    oa:end 1068 ;
    oa:start 929 .

<http://example.org/locx/sentence/39710154/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "RCAN2 interference increased the activity of calcineurin (CaN), which enhanced the nuclear translocation of Transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/39729986/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39729986/S5/position>,
        <http://example.org/locx/sentence/39729986/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39729986> .

<http://example.org/locx/sentence/39729986/S5/position> a oa:TextPositionSelector ;
    oa:end 886 ;
    oa:start 648 .

<http://example.org/locx/sentence/39729986/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Repression in several TNBC models, including in patient-derived xenografts (PDXs), induces nuclear translocation of transcription factor EB (TFEB), which drives a transcriptional program that controls endolysosome function and exocytosis." .

<http://example.org/locx/sentence/39768174/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39768174/S9/position>,
        <http://example.org/locx/sentence/39768174/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39768174> .

<http://example.org/locx/sentence/39768174/S9/position> a oa:TextPositionSelector ;
    oa:end 1238 ;
    oa:start 1140 .

<http://example.org/locx/sentence/39768174/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "PKCzeta is crucial for the SGA-induced nuclear translocation of TFEB and acidic vesicle formation." .

<http://example.org/locx/sentence/39787618/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39787618/S10/position>,
        <http://example.org/locx/sentence/39787618/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39787618> .

<http://example.org/locx/sentence/39787618/S10/position> a oa:TextPositionSelector ;
    oa:end 1680 ;
    oa:start 1583 .

<http://example.org/locx/sentence/39787618/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "The increase in TFEB nuclear translocation was partly blocked by the calcineurin inhibitor FK506." .

<http://example.org/locx/sentence/39787618/S9/position> a oa:TextPositionSelector ;
    oa:end 1582 ;
    oa:start 1263 .

<http://example.org/locx/sentence/39787618/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "We demonstrated that HFD induced insulin resistance and decreased autophagy-lysosomal proteins and the exercise significantly increased transcription factor EB (TFEB) translocation from the cytoplasm to the nucleus, restored the impaired autophagy-lysosomal-related protein expressions, and improved glucose metabolism." .

<http://example.org/locx/sentence/39806423/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39806423/S13/position>,
        <http://example.org/locx/sentence/39806423/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39806423> .

<http://example.org/locx/sentence/39806423/S13/position> a oa:TextPositionSelector ;
    oa:end 2402 ;
    oa:start 2099 .

<http://example.org/locx/sentence/39806423/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "Specifically, deacetylation of TFEB at K310 site by HDAC7 prevented TFEB nuclear translocation with reduced lysosomal biogenesis and tau clearance in astrocytes, whereas inhibiting HDAC7 restored astrocytic TFEB acetylation level at K310 with improved tau pathology and cognitive functions in PS19 mice." .

<http://example.org/locx/sentence/39814550/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39814550/S7/position>,
        <http://example.org/locx/sentence/39814550/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39814550> .

<http://example.org/locx/sentence/39814550/S7/position> a oa:TextPositionSelector ;
    oa:end 820 ;
    oa:start 694 .

<http://example.org/locx/sentence/39814550/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Glycolysis inhibitor 2-deoxy-D-glucose (2-DG) induced TFEB nuclear translocation, indicative of TFEB transcriptional activity." .

<http://example.org/locx/sentence/39828690/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39828690/S7/position>,
        <http://example.org/locx/sentence/39828690/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39828690> .

<http://example.org/locx/sentence/39828690/S7/position> a oa:TextPositionSelector ;
    oa:end 1020 ;
    oa:start 793 .

<http://example.org/locx/sentence/39828690/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Additionally, we demonstrated that the nanocarrier inhibits autophagic flux in liver cancer cells by targeting the autophagy-lysosome pathway and regulating the nuclear translocation of TFEB, thereby promoting tumor cell death." .

<http://example.org/locx/sentence/39835593/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39835593/S5/position>,
        <http://example.org/locx/sentence/39835593/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39835593> .

<http://example.org/locx/sentence/39835593/S5/position> a oa:TextPositionSelector ;
    oa:end 759 ;
    oa:start 520 .

<http://example.org/locx/sentence/39835593/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Intriguingly, we found that STING1-induced GABARAP lipidation, rather than TBK1 activation, serves as the key mediator triggering the nuclear translocation of transcription factor TFEB and enhances the expression of lysosome-related genes." .

<http://example.org/locx/sentence/39835593/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39835593/S6/position>,
        <http://example.org/locx/sentence/39835593/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39835593> .

<http://example.org/locx/sentence/39835593/S6/position> a oa:TextPositionSelector ;
    oa:end 1085 ;
    oa:start 760 .

<http://example.org/locx/sentence/39835593/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, we demonstrated that lipidated GABARAP on single membranes, regulated by the V-ATPase-ATG16L1 axis, sequesters the FLCN-FNIP complex to abolish its function toward RRAGC-RRAGD, leading to a specific impairment of MTORC1-dependent phosphorylation of TFEB and resulting in its subsequent nuclear translocation." .

<http://example.org/locx/sentence/39891192/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39891192/S7/position>,
        <http://example.org/locx/sentence/39891192/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39891192> .

<http://example.org/locx/sentence/39891192/S7/position> a oa:TextPositionSelector ;
    oa:end 1234 ;
    oa:start 994 .

<http://example.org/locx/sentence/39891192/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, 25HC inhibited TFEB (transcription factor-EB) expression, blocked its translocation into the nucleus and reversed Mechanistic Target of Rapamycin Complex 1 (mTORC1) activity, which in turn hindered lipophagy and PDCoV replication." .

<http://example.org/locx/sentence/39940940/S5/position> a oa:TextPositionSelector ;
    oa:end 889 ;
    oa:start 547 .

<http://example.org/locx/sentence/39940940/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Both in vivo and in vitro studies demonstrated that acidosis increased cytoplasmic transcription factor EB (TFEB) levels, reduced nuclear TFEB levels, and suppressed autophagy, as evidenced by elevated p62 levels, a higher LC3-II/LC3-I ratio, decreased synapse-associated proteins (PSD-95 and synaptophysin), and increased neuronal apoptosis." .

<http://example.org/locx/sentence/39940940/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39940940/S6/position>,
        <http://example.org/locx/sentence/39940940/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39940940> .

<http://example.org/locx/sentence/39940940/S6/position> a oa:TextPositionSelector ;
    oa:end 1009 ;
    oa:start 890 .

<http://example.org/locx/sentence/39940940/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In contrast, melatonin promoted the nuclear translocation of TFEB, enhanced autophagy, and reversed neuronal apoptosis." .

<http://example.org/locx/sentence/39956805/S6/position> a oa:TextPositionSelector ;
    oa:end 792 ;
    oa:start 611 .

<http://example.org/locx/sentence/39956805/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In vitro and in vivo activation of hepatic MC3R upregulates autophagy through LC3II activation, TFEB cytoplasmic-to-nuclear translocation, and subsequent downstream gene activation." .

<http://example.org/locx/sentence/39965865/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39965865/S14/position>,
        <http://example.org/locx/sentence/39965865/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39965865> .

<http://example.org/locx/sentence/39965865/S14/position> a oa:TextPositionSelector ;
    oa:end 2539 ;
    oa:start 2237 .

<http://example.org/locx/sentence/39965865/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, Irisin treatment upregulated SIRT3 and phosphorylated AMP-activated protein kinase (AMPK), inhibited mammalian target of rapamycin (mTOR) activity, promoted TFEB nucleus translocation, increased cathepsin B expression, enhanced autophagic degradation, and alleviated hepatic steatosis." .

<http://example.org/locx/sentence/39982740/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39982740/S8/position>,
        <http://example.org/locx/sentence/39982740/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39982740> .

<http://example.org/locx/sentence/39982740/S8/position> a oa:TextPositionSelector ;
    oa:end 1253 ;
    oa:start 1003 .

<http://example.org/locx/sentence/39982740/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "The lipidated GABARAPs bound to the Folliculin-interacting proteins (FNIPs), thereby sequestering the FNIP-folliculin protein complexes from activating mTORC1, resulting in dephosphorylation and nuclear translocation of MiT/TFE transcription factors." .

<http://example.org/locx/sentence/39998815/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/39998815/S6/position>,
        <http://example.org/locx/sentence/39998815/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/39998815> .

<http://example.org/locx/sentence/39998815/S6/position> a oa:TextPositionSelector ;
    oa:end 948 ;
    oa:start 551 .

<http://example.org/locx/sentence/39998815/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, mutation of TFEB SUMOylation site did not abolish the ability of its nuclear translocation, but increased TFEB stability and binding capability with target genes' promoters, thereby promoting lysosomal biogenesis and bioactivity through liquid-liquid phase separation (LLPS), and thus inhibiting the production of inflammatory factors and alleviating allergic airway inflammation." .

<http://example.org/locx/sentence/40020878/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40020878/S8/position>,
        <http://example.org/locx/sentence/40020878/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40020878> .

<http://example.org/locx/sentence/40020878/S8/position> a oa:TextPositionSelector ;
    oa:end 1181 ;
    oa:start 1004 .

<http://example.org/locx/sentence/40020878/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "This facilitates the nuclear translocation of TFEB and enhances lysosomal function by upregulating the expression of lysosome-associated genes and promoting lysosome biogenesis." .

<http://example.org/locx/sentence/40057593/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40057593/S7/position>,
        <http://example.org/locx/sentence/40057593/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40057593> .

<http://example.org/locx/sentence/40057593/S7/position> a oa:TextPositionSelector ;
    oa:end 1156 ;
    oa:start 822 .

<http://example.org/locx/sentence/40057593/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "IL6 enhances AC internalization through the signal transducer and activator of transcription 3 (STAT3)-vav guanine nucleotide exchange factor 1 (VAV1)-ras-related C3 botulinum toxin substrate 1 (RAC1) signaling cascade but simultaneously inhibits transcription factor EB (TFEB) nuclear translocation, leading to lysosomal dysfunction." .

<http://example.org/locx/sentence/40059270/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40059270/S8/position>,
        <http://example.org/locx/sentence/40059270/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40059270> .

<http://example.org/locx/sentence/40059270/S8/position> a oa:TextPositionSelector ;
    oa:end 1228 ;
    oa:start 914 .

<http://example.org/locx/sentence/40059270/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Treatment with the ROS scavenger NAC or knockdown of p53 or SESN2 led to attenuation of the nuclear translocation of TFEB/TFE3, lysosomal biogenesis, and autophagic flux, suggesting that the TrxR1/2-p53-TFEB/TFE3 axis plays a role in maintaining lysosomal homeostasis under stress conditions other than starvation." .

<http://example.org/locx/sentence/40076784/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40076784/S6/position>,
        <http://example.org/locx/sentence/40076784/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40076784> .

<http://example.org/locx/sentence/40076784/S6/position> a oa:TextPositionSelector ;
    oa:end 972 ;
    oa:start 819 .

<http://example.org/locx/sentence/40076784/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Compared to Smpd1+/+ SMCs, Smpd1-/- SMCs exhibited less TFEB nuclear translocation and activation of autophagy signaling induced by adipoRon stimulation." .

<http://example.org/locx/sentence/40089585/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40089585/S5/position>,
        <http://example.org/locx/sentence/40089585/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40089585> .

<http://example.org/locx/sentence/40089585/S5/position> a oa:TextPositionSelector ;
    oa:end 964 ;
    oa:start 593 .

<http://example.org/locx/sentence/40089585/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We found that TFEB nuclear translocation upon nutrient deprivation happens in two phases: a fast one characterised by a transient boost in TFEB dephosphorylation dependent on transient calcium release mediated by mucolipin 1 (MCOLN1) followed by activation of the Calcineurin phosphatase, and a slower one driven by inhibition of mTORC1-dependent phosphorylation of TFEB." .

<http://example.org/locx/sentence/40089585/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40089585/S6/position>,
        <http://example.org/locx/sentence/40089585/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40089585> .

<http://example.org/locx/sentence/40089585/S6/position> a oa:TextPositionSelector ;
    oa:end 1058 ;
    oa:start 965 .

<http://example.org/locx/sentence/40089585/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Upon refeeding, TFEB cytoplasmic relocalisation kinetics are determined by Exportin 1 (XPO1)." .

<http://example.org/locx/sentence/40112248/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40112248/S10/position>,
        <http://example.org/locx/sentence/40112248/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40112248> .

<http://example.org/locx/sentence/40112248/S10/position> a oa:TextPositionSelector ;
    oa:end 1399 ;
    oa:start 1175 .

<http://example.org/locx/sentence/40112248/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Further analysis revealed that BTZ resulted in the increased phosphorylation of transcription factor EB (TFEB) and reduced nuclear translocation of TFEB in RSC96 cells, and these effects that were reversed upon GA treatment." .

<http://example.org/locx/sentence/40143966/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40143966/S3/position>,
        <http://example.org/locx/sentence/40143966/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40143966> .

<http://example.org/locx/sentence/40143966/S3/position> a oa:TextPositionSelector ;
    oa:end 682 ;
    oa:start 501 .

<http://example.org/locx/sentence/40143966/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "AMPK directly phosphorylates folliculin interacting protein 1 (FNIP1), leading to the nuclear translocation of transcription factor EB (TFEB) in response to mitochondrial functions." .

<http://example.org/locx/sentence/40215728/S6/position> a oa:TextPositionSelector ;
    oa:end 978 ;
    oa:start 689 .

<http://example.org/locx/sentence/40215728/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "While the precise cellular interactions of arimoclomol remain unclear, the increased translocation of the transcription factors EB and E3 (TFEB and TFE3) from the cytosol to the nucleus is a key initial step for triggering a cascade of downstream events that can rescue cellular functions." .

<http://example.org/locx/sentence/40243477/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40243477/S7/position>,
        <http://example.org/locx/sentence/40243477/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40243477> .

<http://example.org/locx/sentence/40243477/S7/position> a oa:TextPositionSelector ;
    oa:end 1025 ;
    oa:start 831 .

<http://example.org/locx/sentence/40243477/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In fibroblasts derived from patients carrying this mutation, we found a strong increase in lysosome number, with overexpression and higher nuclear translocation of the transcription factor TFEB." .

<http://example.org/locx/sentence/40265045/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40265045/S5/position>,
        <http://example.org/locx/sentence/40265045/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40265045> .

<http://example.org/locx/sentence/40265045/S5/position> a oa:TextPositionSelector ;
    oa:end 860 ;
    oa:start 731 .

<http://example.org/locx/sentence/40265045/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB nuclear translocation and activation depend on its phosphorylation status which is controlled by multiple cellular pathways." .

<http://example.org/locx/sentence/40354887/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40354887/S6/position>,
        <http://example.org/locx/sentence/40354887/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40354887> .

<http://example.org/locx/sentence/40354887/S6/position> a oa:TextPositionSelector ;
    oa:end 880 ;
    oa:start 699 .

<http://example.org/locx/sentence/40354887/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, AMPKalpha1 can induce lysosomal biogenesis and enhance lipolysis by promoting the transcription factor EB (TFEB) expression and facilitating TFEB nuclear translocation." .

<http://example.org/locx/sentence/40396039/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40396039/S3/position>,
        <http://example.org/locx/sentence/40396039/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40396039> .

<http://example.org/locx/sentence/40396039/S3/position> a oa:TextPositionSelector ;
    oa:end 357 ;
    oa:start 195 .

<http://example.org/locx/sentence/40396039/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Under nutrient-rich conditions, TFEB is inactivated by MTOR (mechanistic target of rapamycin kinase) complex 1 (MTORC1)-dependent phosphorylation on the lysosome." .

<http://example.org/locx/sentence/40396039/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40396039/S4/position>,
        <http://example.org/locx/sentence/40396039/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40396039> .

<http://example.org/locx/sentence/40396039/S4/position> a oa:TextPositionSelector ;
    oa:end 436 ;
    oa:start 358 .

<http://example.org/locx/sentence/40396039/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "This suppresses TFEB activity via preventing its translocation to the nucleus." .

<http://example.org/locx/sentence/40396039/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40396039/S5/position>,
        <http://example.org/locx/sentence/40396039/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40396039> .

<http://example.org/locx/sentence/40396039/S5/position> a oa:TextPositionSelector ;
    oa:end 630 ;
    oa:start 437 .

<http://example.org/locx/sentence/40396039/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Conversely, under starvation conditions and low MTORC1 activity, MTORC1 sites on TFEB are dephosphorylated, and TFEB translocates to the nucleus, where it activates its transcriptional program." .

<http://example.org/locx/sentence/40396039/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40396039/S6/position>,
        <http://example.org/locx/sentence/40396039/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40396039> .

<http://example.org/locx/sentence/40396039/S6/position> a oa:TextPositionSelector ;
    oa:end 915 ;
    oa:start 631 .

<http://example.org/locx/sentence/40396039/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "We recently found that the inhibition of PIKFYVE, which produces phosphatidylinositol-3,5-bisphosphate on lysosomes, leads to the dephosphorylation and translocation of TFEB to the nucleus in a manner dependent on PPP2/PP2A (protein phosphatase 2) even under nutrient-rich conditions." .

<http://example.org/locx/sentence/40415650/S4/position> a oa:TextPositionSelector ;
    oa:end 672 ;
    oa:start 527 .

<http://example.org/locx/sentence/40415650/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB is localized to the nucleus of human BeWo differentiated syncytiotrophoblasts and to the cytoplasm of the undifferentiated cytotrophoblasts." .

<http://example.org/locx/sentence/40415650/S5/position> a oa:TextPositionSelector ;
    oa:end 906 ;
    oa:start 673 .

<http://example.org/locx/sentence/40415650/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Within both the cytotrophoblasts and syncytiotrophoblasts, TFEB exists in subcellular compartments as both phosphorylated and unphosphorylated forms and translocates between cytoplasm and nucleus upon amino acid starvation/refeeding." .

<http://example.org/locx/sentence/40427492/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40427492/S5/position>,
        <http://example.org/locx/sentence/40427492/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40427492> .

<http://example.org/locx/sentence/40427492/S5/position> a oa:TextPositionSelector ;
    oa:end 671 ;
    oa:start 577 .

<http://example.org/locx/sentence/40427492/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We demonstrate that c-Abl phosphorylates TFEB at Tyr173, leading to its cytoplasmic retention." .

<http://example.org/locx/sentence/40427492/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40427492/S6/position>,
        <http://example.org/locx/sentence/40427492/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40427492> .

<http://example.org/locx/sentence/40427492/S6/position> a oa:TextPositionSelector ;
    oa:end 952 ;
    oa:start 672 .

<http://example.org/locx/sentence/40427492/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Using pharmacological models of Gaucher, NPA and NPC in SH-SY5Y neuronal cells and HeLa cells, we assess the effects of the c-Abl inhibitors Imatinib and Neurotinib, as well as the antioxidant alpha-Tocopherol (alpha-TOH), on TFEB nuclear translocation and p-c-Abl protein levels." .

<http://example.org/locx/sentence/40427492/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40427492/S8/position>,
        <http://example.org/locx/sentence/40427492/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40427492> .

<http://example.org/locx/sentence/40427492/S8/position> a oa:TextPositionSelector ;
    oa:end 1258 ;
    oa:start 1063 .

<http://example.org/locx/sentence/40427492/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Our results show that treatment with c-Abl inhibitors or alpha-TOH promotes TFEB nuclear translocation, enhances lysosomal clearance, and reduces cholesterol accumulation in all three LSD models." .

<http://example.org/locx/sentence/40474178/S15> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40474178/S15/position>,
        <http://example.org/locx/sentence/40474178/S15/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40474178> .

<http://example.org/locx/sentence/40474178/S15/position> a oa:TextPositionSelector ;
    oa:end 2208 ;
    oa:start 2061 .

<http://example.org/locx/sentence/40474178/S15/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, PS-NPs activated the mechanistic target of rapamycin (mTOR) and inhibited the nuclear translocation of Transcription Factor EB (TFEB)." .

<http://example.org/locx/sentence/40493099/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40493099/S7/position>,
        <http://example.org/locx/sentence/40493099/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40493099> .

<http://example.org/locx/sentence/40493099/S7/position> a oa:TextPositionSelector ;
    oa:end 1155 ;
    oa:start 977 .

<http://example.org/locx/sentence/40493099/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, compounds 4 and 18 exhibited a dose-dependent increase in lysosome numbers, promoted TFEB nuclear translocation, and enhanced lysosome-mediated lipid droplet clearance." .

<http://example.org/locx/sentence/40509568/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40509568/S8/position>,
        <http://example.org/locx/sentence/40509568/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40509568> .

<http://example.org/locx/sentence/40509568/S8/position> a oa:TextPositionSelector ;
    oa:end 1624 ;
    oa:start 1360 .

<http://example.org/locx/sentence/40509568/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, cholesterol biosynthesis inhibition impairs the activation of MTOR at lysosomes, thereby promoting the nuclear translocation of TFEB and downstream lysosome biosynthesis, facilitating the degradation of CD274/PD-L1 within lysosomes in tumor cells." .

<http://example.org/locx/sentence/40521770/S11/position> a oa:TextPositionSelector ;
    oa:end 1539 ;
    oa:start 1371 .

<http://example.org/locx/sentence/40521770/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Tetrandrine also induced dephosphorylation of transcription factor EB, a regulator of lysosomal biogenesis, promoting its translocation from the cytosol to the nucleus." .

<http://example.org/locx/sentence/40540722/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40540722/S8/position>,
        <http://example.org/locx/sentence/40540722/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40540722> .

<http://example.org/locx/sentence/40540722/S8/position> a oa:TextPositionSelector ;
    oa:end 1545 ;
    oa:start 1343 .

<http://example.org/locx/sentence/40540722/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Exercise-mediated ATP depletion activates AMPK while suppressing mTORC1, thereby synchronously inducing autophagy initiation (ULK1 phosphorylation) and lysosomal biogenesis (TFEB nuclear translocation)." .

<http://example.org/locx/sentence/40550802/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40550802/S6/position>,
        <http://example.org/locx/sentence/40550802/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40550802> .

<http://example.org/locx/sentence/40550802/S6/position> a oa:TextPositionSelector ;
    oa:end 1018 ;
    oa:start 886 .

<http://example.org/locx/sentence/40550802/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Subsequently, PERK activation triggered TFEB translocation to the nucleus, thus regulating mitochondrial dynamics transcriptionally." .

<http://example.org/locx/sentence/40550802/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40550802/S8/position>,
        <http://example.org/locx/sentence/40550802/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40550802> .

<http://example.org/locx/sentence/40550802/S8/position> a oa:TextPositionSelector ;
    oa:end 1364 ;
    oa:start 1186 .

<http://example.org/locx/sentence/40550802/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Initially, PERK activation facilitated TFEB nuclear localization, stimulating mitochondrial biogenesis through PGC1-a, thereby addressing energy demands during the initial phase." .

<http://example.org/locx/sentence/40612680/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40612680/S7/position>,
        <http://example.org/locx/sentence/40612680/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40612680> .

<http://example.org/locx/sentence/40612680/S7/position> a oa:TextPositionSelector ;
    oa:end 1105 ;
    oa:start 936 .

<http://example.org/locx/sentence/40612680/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "We also showed that SESN2 promotes the nuclear translocation of TFEB through the mTOR pathway, thus further alleviating lysosomal function and promoting MVB degradation." .

<http://example.org/locx/sentence/40662603/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40662603/S5/position>,
        <http://example.org/locx/sentence/40662603/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40662603> .

<http://example.org/locx/sentence/40662603/S5/position> a oa:TextPositionSelector ;
    oa:end 940 ;
    oa:start 565 .

<http://example.org/locx/sentence/40662603/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In this medicinal study, by exploring naphthalimide-Pt(IV) complexes, named NTCDI-Pt, we demonstrated that in opposite to cisplatin, glioma cells treated with NTCDI-Pt decreased lysosome abundance to restrain platinum ions uptake in lysosomes by regulating Transcription Factor EB (TFEB) nucleus translocation, which finally caused more platinum ions accumulation in nucleus." .

<http://example.org/locx/sentence/40664447/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40664447/S11/position>,
        <http://example.org/locx/sentence/40664447/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40664447> .

<http://example.org/locx/sentence/40664447/S11/position> a oa:TextPositionSelector ;
    oa:end 1897 ;
    oa:start 1671 .

<http://example.org/locx/sentence/40664447/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, HK3 physically interacted with mechanistic target of rapamycin (mTOR), promoting nuclear translocation of transcription factor EB (TFEB) and resulting in excessive lysosomal activation and antigen degradation." .

<http://example.org/locx/sentence/40683940/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40683940/S7/position>,
        <http://example.org/locx/sentence/40683940/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40683940> .

<http://example.org/locx/sentence/40683940/S7/position> a oa:TextPositionSelector ;
    oa:end 978 ;
    oa:start 803 .

<http://example.org/locx/sentence/40683940/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "We generated GRN knockout HEK-293 cells (GRN KO cells), which exhibited increased nuclear localization of TFEB and expression of lysosomal transcripts, but impaired autophagy." .

<http://example.org/locx/sentence/40796055/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40796055/S6/position>,
        <http://example.org/locx/sentence/40796055/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40796055> .

<http://example.org/locx/sentence/40796055/S6/position> a oa:TextPositionSelector ;
    oa:end 1145 ;
    oa:start 981 .

<http://example.org/locx/sentence/40796055/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "CPZ and CMI elicited a significant [Ca2+]i increase that rapidly induced nuclear translocation of TFEB (transcription factor EB), the master regulator of autophagy." .

<http://example.org/locx/sentence/40812540/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40812540/S7/position>,
        <http://example.org/locx/sentence/40812540/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40812540> .

<http://example.org/locx/sentence/40812540/S7/position> a oa:TextPositionSelector ;
    oa:end 1198 ;
    oa:start 1083 .

<http://example.org/locx/sentence/40812540/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "YM201636 induced an increase in nuclear translocation of TFEB, and an increase in lysosomal markers LAMP1 and HEXA." .

<http://example.org/locx/sentence/40812540/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40812540/S9/position>,
        <http://example.org/locx/sentence/40812540/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40812540> .

<http://example.org/locx/sentence/40812540/S9/position> a oa:TextPositionSelector ;
    oa:end 1443 ;
    oa:start 1329 .

<http://example.org/locx/sentence/40812540/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "In these cells, YM201636 substantially reduced alpha-synuclein inclusions and increased TFEB nuclear localisation." .

<http://example.org/locx/sentence/40833810/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40833810/S1/position>,
        <http://example.org/locx/sentence/40833810/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40833810> .

<http://example.org/locx/sentence/40833810/S1/position> a oa:TextPositionSelector ;
    oa:end 156 ;
    oa:start 0 .

<http://example.org/locx/sentence/40833810/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "The hereditary spastic paraplegia type 21 (SPG21) protein is a RAB7A effector that promotes mTORC1-catalyzed TFEB phosphorylation and cytoplasmic retention." .

<http://example.org/locx/sentence/40833810/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40833810/S7/position>,
        <http://example.org/locx/sentence/40833810/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40833810> .

<http://example.org/locx/sentence/40833810/S7/position> a oa:TextPositionSelector ;
    oa:end 1034 ;
    oa:start 943 .

<http://example.org/locx/sentence/40833810/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This enhances nuclear localization of TFEB and expression of a subset of TFEB-target genes." .

<http://example.org/locx/sentence/40833810/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40833810/S8/position>,
        <http://example.org/locx/sentence/40833810/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40833810> .

<http://example.org/locx/sentence/40833810/S8/position> a oa:TextPositionSelector ;
    oa:end 1227 ;
    oa:start 1035 .

<http://example.org/locx/sentence/40833810/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "We conclude that SPG21 acts as a RAB7A effector that promotes non-canonical mTORC1-catalyzed phosphorylation of TFEB, thereby suppressing its nuclear localization and transcriptional activity." .

<http://example.org/locx/sentence/40857264/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40857264/S6/position>,
        <http://example.org/locx/sentence/40857264/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40857264> .

<http://example.org/locx/sentence/40857264/S6/position> a oa:TextPositionSelector ;
    oa:end 1146 ;
    oa:start 869 .

<http://example.org/locx/sentence/40857264/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "RESULTS: Enhanced autophagy was observed when Piezo1 was activated using the agonist Yoda1, manifesting as increased release of autophagic vacuoles, enhanced LC3 II/LC3 I ratio, decreased p62 protein level, and elevated nuclear translocation and expression of the TFEB protein." .

<http://example.org/locx/sentence/40885185/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40885185/S11/position>,
        <http://example.org/locx/sentence/40885185/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40885185> .

<http://example.org/locx/sentence/40885185/S11/position> a oa:TextPositionSelector ;
    oa:end 1752 ;
    oa:start 1545 .

<http://example.org/locx/sentence/40885185/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Expression of p.Lys184Glu and c.863G>C (p.Gly288Ala) increased apoptosis in cell lines, and p.Lys184Glu increased nuclear localization of transcription factor EB, consistent with a cellular starvation state." .

<http://example.org/locx/sentence/40897858/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40897858/S9/position>,
        <http://example.org/locx/sentence/40897858/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40897858> .

<http://example.org/locx/sentence/40897858/S9/position> a oa:TextPositionSelector ;
    oa:end 1180 ;
    oa:start 1016 .

<http://example.org/locx/sentence/40897858/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "OPE mixture induced concentration-dependent increases in the degradation capacity of lysosomes and elevated nuclear translocation of TFEB when compared to controls." .

<http://example.org/locx/sentence/40907412/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40907412/S7/position>,
        <http://example.org/locx/sentence/40907412/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40907412> .

<http://example.org/locx/sentence/40907412/S7/position> a oa:TextPositionSelector ;
    oa:end 1416 ;
    oa:start 1240 .

<http://example.org/locx/sentence/40907412/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, BPF exposure significantly blocked the Transcription Factor EB (TFEB  ) nuclear translocation, and thereby impaired the lysosomal generation and acidification." .

<http://example.org/locx/sentence/40907412/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40907412/S8/position>,
        <http://example.org/locx/sentence/40907412/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40907412> .

<http://example.org/locx/sentence/40907412/S8/position> a oa:TextPositionSelector ;
    oa:end 1560 ;
    oa:start 1417 .

<http://example.org/locx/sentence/40907412/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Intriguingly, pharmacological activation of PPARalpha facilitated TFEB nuclear translocation and counteracted the BPF-induced lipid deposition." .

<http://example.org/locx/sentence/40939288/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40939288/S10/position>,
        <http://example.org/locx/sentence/40939288/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40939288> .

<http://example.org/locx/sentence/40939288/S10/position> a oa:TextPositionSelector ;
    oa:end 1328 ;
    oa:start 1168 .

<http://example.org/locx/sentence/40939288/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Additionally, we observed the nuclear translocation of transcriptional factor EB (TFEB), the master transcriptional regulator of autophagy-lysosomal biogenesis." .

<http://example.org/locx/sentence/40939288/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40939288/S13/position>,
        <http://example.org/locx/sentence/40939288/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40939288> .

<http://example.org/locx/sentence/40939288/S13/position> a oa:TextPositionSelector ;
    oa:end 1665 ;
    oa:start 1493 .

<http://example.org/locx/sentence/40939288/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "At 4h, a significant TFEB nuclear translocation was observed, leading to the increase of T1 values by 8.2 % and 20.3 % at 6 and 8 h, respectively, compared to the 4-h mark." .

<http://example.org/locx/sentence/40958774/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40958774/S7/position>,
        <http://example.org/locx/sentence/40958774/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40958774> .

<http://example.org/locx/sentence/40958774/S7/position> a oa:TextPositionSelector ;
    oa:end 911 ;
    oa:start 802 .

<http://example.org/locx/sentence/40958774/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This disruption of FLCN GAP function toward RagC/D impairs TFEB's lysosomal localization and phosphorylation." .

<http://example.org/locx/sentence/40999304/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/40999304/S8/position>,
        <http://example.org/locx/sentence/40999304/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/40999304> .

<http://example.org/locx/sentence/40999304/S8/position> a oa:TextPositionSelector ;
    oa:end 1204 ;
    oa:start 1110 .

<http://example.org/locx/sentence/40999304/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "(i) reducing translocation of TFEB into nuclei that leads to decreased lysosome biogenesis and" .

<http://example.org/locx/sentence/41076529/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41076529/S10/position>,
        <http://example.org/locx/sentence/41076529/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41076529> .

<http://example.org/locx/sentence/41076529/S10/position> a oa:TextPositionSelector ;
    oa:end 1337 ;
    oa:start 1150 .

<http://example.org/locx/sentence/41076529/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "The mechanistic analysis revealed the functional co-localization of RRAGD with lysosomal marker LAMP1 and lysosomal regeneration transcription factor TFEB, indicating lysosomal targeting." .

<http://example.org/locx/sentence/41101172/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41101172/S13/position>,
        <http://example.org/locx/sentence/41101172/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41101172> .

<http://example.org/locx/sentence/41101172/S13/position> a oa:TextPositionSelector ;
    oa:end 1729 ;
    oa:start 1573 .

<http://example.org/locx/sentence/41101172/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "Furthermore, SOCS1 can promote the nuclear translocation of TFEB, while the phosphorylation of AMPK can up-regulate SOCS1 to promote the expression of TFEB." .

<http://example.org/locx/sentence/41101172/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41101172/S14/position>,
        <http://example.org/locx/sentence/41101172/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41101172> .

<http://example.org/locx/sentence/41101172/S14/position> a oa:TextPositionSelector ;
    oa:end 1901 ;
    oa:start 1730 .

<http://example.org/locx/sentence/41101172/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "CONCLUSION: AMPK promotes nuclear transfer of TFEB by up-regulating SOCS1, thereby enhancing autophagy and inhibiting M1 polarization in macrophages, thus alleviating ALI." .

<http://example.org/locx/sentence/41115251/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41115251/S5/position>,
        <http://example.org/locx/sentence/41115251/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41115251> .

<http://example.org/locx/sentence/41115251/S5/position> a oa:TextPositionSelector ;
    oa:end 829 ;
    oa:start 595 .

<http://example.org/locx/sentence/41115251/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We show that p53 drives potent tumor regression by direct Tsc2 transactivation, leading to mTORC1 inhibition and TFEB nuclear accumulation, which in turn triggers lysosomal gene expression programs, autophagy, and cellular senescence." .

<http://example.org/locx/sentence/41122856/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41122856/S3/position>,
        <http://example.org/locx/sentence/41122856/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41122856> .

<http://example.org/locx/sentence/41122856/S3/position> a oa:TextPositionSelector ;
    oa:end 596 ;
    oa:start 352 .

<http://example.org/locx/sentence/41122856/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Both in vivo porcine jejunum and in vitro IPEC-J2 monolayer experiments revealed that DON exposure induced jejunal villus atrophy, tight junction disruption, mucin2 downregulation, cathepsin B/D leakage, and impaired TFEB nuclear translocation." .

<http://example.org/locx/sentence/41145093/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41145093/S11/position>,
        <http://example.org/locx/sentence/41145093/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41145093> .

<http://example.org/locx/sentence/41145093/S11/position> a oa:TextPositionSelector ;
    oa:end 1591 ;
    oa:start 1443 .

<http://example.org/locx/sentence/41145093/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "RGX-104 facilitated TFEB translocation into the nucleus, promoted the fusion of autophagosomes with lysosomes, and ameliorated foaming and fibrosis." .

<http://example.org/locx/sentence/41145093/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41145093/S9/position>,
        <http://example.org/locx/sentence/41145093/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41145093> .

<http://example.org/locx/sentence/41145093/S9/position> a oa:TextPositionSelector ;
    oa:end 1239 ;
    oa:start 1114 .

<http://example.org/locx/sentence/41145093/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Inhibition of TFEB nuclear translocation was identified as a key regulator of PHMG-induced autophagy-lysosome fusion defects." .

<http://example.org/locx/sentence/41214150/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41214150/S8/position>,
        <http://example.org/locx/sentence/41214150/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41214150> .

<http://example.org/locx/sentence/41214150/S8/position> a oa:TextPositionSelector ;
    oa:end 1375 ;
    oa:start 1095 .

<http://example.org/locx/sentence/41214150/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Interestingly, it facilitates the nuclear translocation of TFEB, a key regulator of lysosomal biogenesis, which leads to the transcriptional inactivation of lysosomal target genes (LAMP1, MCOLN1, ATP6V1H, CTSB, and CTSD), impairing lysosomal function and blocking autophagic flux." .

<http://example.org/locx/sentence/41224733/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41224733/S10/position>,
        <http://example.org/locx/sentence/41224733/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41224733> .

<http://example.org/locx/sentence/41224733/S10/position> a oa:TextPositionSelector ;
    oa:end 1426 ;
    oa:start 1216 .

<http://example.org/locx/sentence/41224733/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "There was also reduced nuclear localization of transcription factor EB (TFEB), impaired autophagy, and decreased levels of cathepsin D (CathD), a lysosomal protease involved in alpha-synuclein degradation [11]." .

<http://example.org/locx/sentence/41258150/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41258150/S8/position>,
        <http://example.org/locx/sentence/41258150/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41258150> .

<http://example.org/locx/sentence/41258150/S8/position> a oa:TextPositionSelector ;
    oa:end 1174 ;
    oa:start 1069 .

<http://example.org/locx/sentence/41258150/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, hirunipin 4 promoted nuclear translocation of TFEB and enhanced GCase protein stability." .

<http://example.org/locx/sentence/41288708/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41288708/S10/position>,
        <http://example.org/locx/sentence/41288708/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41288708> .

<http://example.org/locx/sentence/41288708/S10/position> a oa:TextPositionSelector ;
    oa:end 1569 ;
    oa:start 1239 .

<http://example.org/locx/sentence/41288708/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "It activated AMP-activated protein kinase (AMPK), suppressed mechanistic target of rapamycin (mTOR), enhanced transcription factor EB (TFEB) nuclear translocation (as evidenced by reduced microtubule-associated protein 1 A/1B-light chain 3-II/sequestosome 1), restored autophagy-lysosome function, and increased lipid degradation." .

<http://example.org/locx/sentence/41288941/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41288941/S8/position>,
        <http://example.org/locx/sentence/41288941/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41288941> .

<http://example.org/locx/sentence/41288941/S8/position> a oa:TextPositionSelector ;
    oa:end 1206 ;
    oa:start 1070 .

<http://example.org/locx/sentence/41288941/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB dephosphorylation triggers its nuclear translocation and the activation of macroautophagic/autophagic and mitochondrial biogenesis." .

<http://example.org/locx/sentence/41290101/S1> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41290101/S1/position>,
        <http://example.org/locx/sentence/41290101/S1/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41290101> .

<http://example.org/locx/sentence/41290101/S1/position> a oa:TextPositionSelector ;
    oa:end 131 ;
    oa:start 0 .

<http://example.org/locx/sentence/41290101/S1/quote> a oa:TextQuoteSelector ;
    oa:exact "TFEB-nuclear translocation promotes BNIP3-mediated mitophagy and alleviates oxidative stress and ferroptosis in acute pancreatitis." .

<http://example.org/locx/sentence/41290101/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41290101/S10/position>,
        <http://example.org/locx/sentence/41290101/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41290101> .

<http://example.org/locx/sentence/41290101/S10/position> a oa:TextPositionSelector ;
    oa:end 1684 ;
    oa:start 1413 .

<http://example.org/locx/sentence/41290101/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "When nuclear translocation was blocked by a C270S mutation-a mutation that disrupts TFEB dissociation from 14-3-3 proteins and subsequent nuclear localization-TFEB's regulatory roles in autophagy, mitophagy, ferroptosis, and oxidative stress were significantly inhibited." .

<http://example.org/locx/sentence/41290101/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41290101/S9/position>,
        <http://example.org/locx/sentence/41290101/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41290101> .

<http://example.org/locx/sentence/41290101/S9/position> a oa:TextPositionSelector ;
    oa:end 1412 ;
    oa:start 1309 .

<http://example.org/locx/sentence/41290101/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Functional experiments confirmed that TFEB exerts its protective effects through nuclear translocation." .

<http://example.org/locx/sentence/41338298/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41338298/S10/position>,
        <http://example.org/locx/sentence/41338298/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41338298> .

<http://example.org/locx/sentence/41338298/S10/position> a oa:TextPositionSelector ;
    oa:end 1585 ;
    oa:start 1371 .

<http://example.org/locx/sentence/41338298/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "In vitro, FK506 suppressed pro-inflammatory cytokines via enhanced autophagic flux, promoted TFEB nuclear translocation, restored lysosomal structural and functional integrity, while inhibited mTOR phosphorylation." .

<http://example.org/locx/sentence/41342385/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41342385/S9/position>,
        <http://example.org/locx/sentence/41342385/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41342385> .

<http://example.org/locx/sentence/41342385/S9/position> a oa:TextPositionSelector ;
    oa:end 1483 ;
    oa:start 1323 .

<http://example.org/locx/sentence/41342385/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Additionally, CEP could improve mitochondrial morphology and function, and stimulated lysosome biogenesis by promoting TFEB nuclear translocation in ASMD cells." .

<http://example.org/locx/sentence/41390431/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41390431/S9/position>,
        <http://example.org/locx/sentence/41390431/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41390431> .

<http://example.org/locx/sentence/41390431/S9/position> a oa:TextPositionSelector ;
    oa:end 1461 ;
    oa:start 1357 .

<http://example.org/locx/sentence/41390431/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Of note, hUC-MSCs have been found to promote nuclear translocation of TFEB in PA/OA-induced HepG2 cells." .

<http://example.org/locx/sentence/41391758/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41391758/S6/position>,
        <http://example.org/locx/sentence/41391758/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41391758> .

<http://example.org/locx/sentence/41391758/S6/position> a oa:TextPositionSelector ;
    oa:end 977 ;
    oa:start 667 .

<http://example.org/locx/sentence/41391758/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Elacridar alters gene expression networks controlling lysosomal sterol and lipid metabolism but, unlike other lysosomotropic drugs, it prominently upregulates genes that control lysosomal pH. Surprisingly, these effects occur independently of TFEB nuclear translocation, suggesting novel regulatory mechanisms." .

<http://example.org/locx/sentence/41400694/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41400694/S4/position>,
        <http://example.org/locx/sentence/41400694/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41400694> .

<http://example.org/locx/sentence/41400694/S4/position> a oa:TextPositionSelector ;
    oa:end 590 ;
    oa:start 375 .

<http://example.org/locx/sentence/41400694/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Intriguingly, we found that the phosphorylation level of the transcription factor EB (TFEB), a master regulator of the CLEAR gene network, is decreased in SPG21 knockout cells, leading to TFEB nuclear translocation." .

<http://example.org/locx/sentence/41450115/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41450115/S10/position>,
        <http://example.org/locx/sentence/41450115/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41450115> .

<http://example.org/locx/sentence/41450115/S10/position> a oa:TextPositionSelector ;
    oa:end 1547 ;
    oa:start 1339 .

<http://example.org/locx/sentence/41450115/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Deletion of ATG16L1 or ATG5, which blocks Atg8-familyh protein lipidation and sequesters the FLCN-FNIP2 complex, partially abolishes proteotoxic stress-induced TFEB dephosphorylation and nuclear accumulation." .

<http://example.org/locx/sentence/41450115/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41450115/S4/position>,
        <http://example.org/locx/sentence/41450115/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41450115> .

<http://example.org/locx/sentence/41450115/S4/position> a oa:TextPositionSelector ;
    oa:end 702 ;
    oa:start 454 .

<http://example.org/locx/sentence/41450115/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we show that proteotoxic stress induced by proteasome inhibition, puromycin treatment, or polyglutamine-expanded HTT (huntingtin) expression promotes nuclear accumulation of TFEB and TFE3, key regulators of lysosomal biogenesis and autophagy." .

<http://example.org/locx/sentence/41450115/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41450115/S7/position>,
        <http://example.org/locx/sentence/41450115/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41450115> .

<http://example.org/locx/sentence/41450115/S7/position> a oa:TextPositionSelector ;
    oa:end 1050 ;
    oa:start 915 .

<http://example.org/locx/sentence/41450115/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Proteotoxic stress disrupts the RRAGC-TFEB interaction, preventing TFEB recruitment to lysosomes and subsequent MTORC1 phosphorylation." .

<http://example.org/locx/sentence/41450115/S8/position> a oa:TextPositionSelector ;
    oa:end 1268 ;
    oa:start 1051 .

<http://example.org/locx/sentence/41450115/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "An activated RRAGC mutant rescues impaired lysosomal localization and nuclear accumulation of TFEB, while co-overexpression of FLCN and FNIP2, a GAP for RRAGC, partially restores stress-induced TFEB dephosphorylation." .

<http://example.org/locx/sentence/41450945/S4/position> a oa:TextPositionSelector ;
    oa:end 543 ;
    oa:start 374 .

<http://example.org/locx/sentence/41450945/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Two key regulators, transcription factors EB (TFEB) and E3 (TFE3), play essential regulatory roles in these processes by shuttling between the cytoplasm and the nucleus." .

<http://example.org/locx/sentence/41525484/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41525484/S6/position>,
        <http://example.org/locx/sentence/41525484/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41525484> .

<http://example.org/locx/sentence/41525484/S6/position> a oa:TextPositionSelector ;
    oa:end 974 ;
    oa:start 785 .

<http://example.org/locx/sentence/41525484/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Upon the uptake by TAMs, cholesterol triggered the nuclear translocation of transcription factor EB (TFEB), which directly bound to the PLD3 promoter region and activated its transcription." .

<http://example.org/locx/sentence/41553455/S15> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41553455/S15/position>,
        <http://example.org/locx/sentence/41553455/S15/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41553455> .

<http://example.org/locx/sentence/41553455/S15/position> a oa:TextPositionSelector ;
    oa:end 2379 ;
    oa:start 2143 .

<http://example.org/locx/sentence/41553455/S15/quote> a oa:TextQuoteSelector ;
    oa:exact "At the same time, immunofluorescence confirmed that simvastatin promoted the nuclear translocation of TFEB, and chromatin immunoprecipitation and dual-luciferase gene report confirmed that TFEB is the transcription factor of P62/SQSTM1." .

<http://example.org/locx/sentence/41556159/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41556159/S12/position>,
        <http://example.org/locx/sentence/41556159/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41556159> .

<http://example.org/locx/sentence/41556159/S12/position> a oa:TextPositionSelector ;
    oa:end 1403 ;
    oa:start 1261 .

<http://example.org/locx/sentence/41556159/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "miR-107-3p was identified as a 3,4-DC-responsive microRNA that modulates TFEB nuclear translocation through the miR-107-3p/Wnt3a/mTOR pathway." .

<http://example.org/locx/sentence/41596551/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41596551/S5/position>,
        <http://example.org/locx/sentence/41596551/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41596551> .

<http://example.org/locx/sentence/41596551/S5/position> a oa:TextPositionSelector ;
    oa:end 713 ;
    oa:start 561 .

<http://example.org/locx/sentence/41596551/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We demonstrated that KHS-101 promotes TFEB nuclear translocation, enhances lysosomal biogenesis and proteolytic activity, and increases autophagic flux." .

<http://example.org/locx/sentence/41597697/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41597697/S7/position>,
        <http://example.org/locx/sentence/41597697/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41597697> .

<http://example.org/locx/sentence/41597697/S7/position> a oa:TextPositionSelector ;
    oa:end 1334 ;
    oa:start 1089 .

<http://example.org/locx/sentence/41597697/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "The results of WB and RT-qPCR showed that ORF2 suppressed the PI3K/Akt/mTOR pathway while enhancing nuclear translocation of TFEB (p < 0.01) and AMPK phosphorylation (p < 0.01), suggesting paradoxical activation of upstream autophagy regulators." .

<http://example.org/locx/sentence/41632038/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41632038/S5/position>,
        <http://example.org/locx/sentence/41632038/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41632038> .

<http://example.org/locx/sentence/41632038/S5/position> a oa:TextPositionSelector ;
    oa:end 1095 ;
    oa:start 769 .

<http://example.org/locx/sentence/41632038/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "We further illustrate how dietary bioactive compounds modulate the autophagy network via multiple targets, such as the activation of AMPK or inhibition of mTOR to improve autophagy, the promotion of TFEB nuclear translocation to drive lysosomal production, and the enhancement of SIRT1 to coordinate metabolic stress response." .

<http://example.org/locx/sentence/41654644/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41654644/S11/position>,
        <http://example.org/locx/sentence/41654644/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41654644> .

<http://example.org/locx/sentence/41654644/S11/position> a oa:TextPositionSelector ;
    oa:end 1393 ;
    oa:start 1292 .

<http://example.org/locx/sentence/41654644/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "TBT also promoted nuclear translocation of transcription factor EB (TFEB) in a SopF-sensitive manner." .

<http://example.org/locx/sentence/41684281/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41684281/S9/position>,
        <http://example.org/locx/sentence/41684281/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41684281> .

<http://example.org/locx/sentence/41684281/S9/position> a oa:TextPositionSelector ;
    oa:end 1458 ;
    oa:start 1283 .

<http://example.org/locx/sentence/41684281/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, molecular docking experiments further confirmed that momordicine I could combine TFEB's upstream regulators, AMPK/mTOR, thereby enhancing TFEB nuclear translocation." .

<http://example.org/locx/sentence/41717449/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41717449/S7/position>,
        <http://example.org/locx/sentence/41717449/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41717449> .

<http://example.org/locx/sentence/41717449/S7/position> a oa:TextPositionSelector ;
    oa:end 915 ;
    oa:start 757 .

<http://example.org/locx/sentence/41717449/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Besides gemcitabine causing nucleolar stress, the anticancer agent CX-5461, primarily designed to induce nucleolar stress, promoted TFEB nuclear accumulation." .

<http://example.org/locx/sentence/41759594/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41759594/S4/position>,
        <http://example.org/locx/sentence/41759594/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41759594> .

<http://example.org/locx/sentence/41759594/S4/position> a oa:TextPositionSelector ;
    oa:end 663 ;
    oa:start 535 .

<http://example.org/locx/sentence/41759594/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, celastrol facilitates TFEB nuclear translocation, enhancing lysosomal biogenesis and triggering ferritinophagy." .

<http://example.org/locx/sentence/41794210/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41794210/S7/position>,
        <http://example.org/locx/sentence/41794210/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41794210> .

<http://example.org/locx/sentence/41794210/S7/position> a oa:TextPositionSelector ;
    oa:end 1127 ;
    oa:start 897 .

<http://example.org/locx/sentence/41794210/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Loss of PEX5 activated p38 mitogen-activated protein kinase (p38 MAPK) signaling, reduced nuclear translocation of the transcription factor EB (TFEB), and impaired autophagic flux, thereby promoting a pro-senescent cellular state." .

<http://example.org/locx/sentence/41843839/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41843839/S11/position>,
        <http://example.org/locx/sentence/41843839/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41843839> .

<http://example.org/locx/sentence/41843839/S11/position> a oa:TextPositionSelector ;
    oa:end 1458 ;
    oa:start 1257 .

<http://example.org/locx/sentence/41843839/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Notably, under normoxia, doxorubicin activates TFEB (Transcription Factor EB), a master regulator of lysosomal biogenesis, which likely accounts for the observed expansion of the lysosomal compartment." .

<http://example.org/locx/sentence/41906739/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41906739/S5/position>,
        <http://example.org/locx/sentence/41906739/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41906739> .

<http://example.org/locx/sentence/41906739/S5/position> a oa:TextPositionSelector ;
    oa:end 665 ;
    oa:start 504 .

<http://example.org/locx/sentence/41906739/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In the early ATG conjugation-independent mode (Mode I), APEX1 interacts with TFEB in the nucleus, maintaining its transcriptional activity and protein stability." .

<http://example.org/locx/sentence/41906739/S6/position> a oa:TextPositionSelector ;
    oa:end 841 ;
    oa:start 666 .

<http://example.org/locx/sentence/41906739/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In the later ATG conjugation-dependent mode (Mode II), CCT7 and TRIP6 translocate to lysosomes and interact with TFEB, modulating its phosphorylation and nuclear localization." .

<http://example.org/locx/sentence/41912102/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41912102/S4/position>,
        <http://example.org/locx/sentence/41912102/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41912102> .

<http://example.org/locx/sentence/41912102/S4/position> a oa:TextPositionSelector ;
    oa:end 776 ;
    oa:start 435 .

<http://example.org/locx/sentence/41912102/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, using a series of artificial intelligence-powered computational virtual screening workflows, we have identified isoginkgetin (ISO), a small-molecule compound, as a potent TFEB activator that promotes mechanistic target of rapamycin complex 1 (mTORC1)-independent TFEB nuclear translocation to enhance lysosomal biogenesis and function." .

<http://example.org/locx/sentence/41912102/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41912102/S5/position>,
        <http://example.org/locx/sentence/41912102/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41912102> .

<http://example.org/locx/sentence/41912102/S5/position> a oa:TextPositionSelector ;
    oa:end 1045 ;
    oa:start 777 .

<http://example.org/locx/sentence/41912102/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, ISO functions as an ATP-competitive inhibitor that binds to the key Lys85 residue within the ATP-binding pocket of glycogen synthase kinase 3beta (GSK-3beta), thereby regulating the GSK-3beta-TFEB signaling axis to activate TFEB nuclear translocation." .

<http://example.org/locx/sentence/41922353/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41922353/S7/position>,
        <http://example.org/locx/sentence/41922353/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41922353> .

<http://example.org/locx/sentence/41922353/S7/position> a oa:TextPositionSelector ;
    oa:end 1277 ;
    oa:start 1049 .

<http://example.org/locx/sentence/41922353/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mutation of either the phosphosites or the ubiquitination sites stabilizes TFEB without impairing its ability to translocate to the nucleus, activate target gene expression, or promote tau clearance in a cell model of tauopathy." .

<http://example.org/locx/sentence/41927824/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41927824/S4/position>,
        <http://example.org/locx/sentence/41927824/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41927824> .

<http://example.org/locx/sentence/41927824/S4/position> a oa:TextPositionSelector ;
    oa:end 571 ;
    oa:start 355 .

<http://example.org/locx/sentence/41927824/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Owing to its alkaline properties, Fan accumulates within lysosomes, elevates luminal pH, and induces TFEB nuclear translocation, thereby restoring lysosomal biogenesis and initiating a TFEB-driven antiviral response." .

<http://example.org/locx/sentence/41932639/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41932639/S5/position>,
        <http://example.org/locx/sentence/41932639/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41932639> .

<http://example.org/locx/sentence/41932639/S5/position> a oa:TextPositionSelector ;
    oa:end 878 ;
    oa:start 728 .

<http://example.org/locx/sentence/41932639/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "This triggers TFEB nuclear translocation and subsequent transcriptional upregulation of autophagy/lysosomal genes, driving autophagic hyperactivation." .

<http://example.org/locx/sentence/41951909/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41951909/S8/position>,
        <http://example.org/locx/sentence/41951909/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41951909> .

<http://example.org/locx/sentence/41951909/S8/position> a oa:TextPositionSelector ;
    oa:end 1168 ;
    oa:start 1058 .

<http://example.org/locx/sentence/41951909/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, Cabozantinib inhibited TFEB phosphorylation at Ser142 and enhanced its nuclear translocation." .

<http://example.org/locx/sentence/41957523/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41957523/S13/position>,
        <http://example.org/locx/sentence/41957523/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41957523> .

<http://example.org/locx/sentence/41957523/S13/position> a oa:TextPositionSelector ;
    oa:end 2016 ;
    oa:start 1902 .

<http://example.org/locx/sentence/41957523/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "This modulation influences TFEB, promoting its translocation into the nucleus and triggering autophagy activation." .

<http://example.org/locx/sentence/41957523/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41957523/S5/position>,
        <http://example.org/locx/sentence/41957523/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41957523> .

<http://example.org/locx/sentence/41957523/S5/position> a oa:TextPositionSelector ;
    oa:end 890 ;
    oa:start 551 .

<http://example.org/locx/sentence/41957523/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In this study, we mechanistically identified a novel pathway involving AMP-activated protein kinase (AMPK), mammalian target of rapamycin (mTOR), and transcription factor EB (TFEB): upregulation of SIRT6 enhances AMPK activity and suppresses mTOR activation, leading to TFEB nuclear translocation and the subsequent induction of autophagy." .

<http://example.org/locx/sentence/41957523/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41957523/S6/position>,
        <http://example.org/locx/sentence/41957523/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41957523> .

<http://example.org/locx/sentence/41957523/S6/position> a oa:TextPositionSelector ;
    oa:end 1028 ;
    oa:start 891 .

<http://example.org/locx/sentence/41957523/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Importantly, our study provides the first evidence that SIRT6 induces the translocation of TFEB into the nucleus, facilitating autophagy." .

<http://example.org/locx/sentence/41966312/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/41966312/S8/position>,
        <http://example.org/locx/sentence/41966312/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/41966312> .

<http://example.org/locx/sentence/41966312/S8/position> a oa:TextPositionSelector ;
    oa:end 1461 ;
    oa:start 1266 .

<http://example.org/locx/sentence/41966312/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "CuO-NPs inhibit mTORC1-mediated TFEB phosphorylation, thereby inducing TFEB nuclear translocation that increases PINK1/Parkin expression and activates the PINK1/Parkin-mediated mitophagy pathway." .

<http://example.org/locx/sentence/42013981/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42013981/S6/position>,
        <http://example.org/locx/sentence/42013981/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42013981> .

<http://example.org/locx/sentence/42013981/S6/position> a oa:TextPositionSelector ;
    oa:end 973 ;
    oa:start 740 .

<http://example.org/locx/sentence/42013981/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, 10-G induced the dephosphorylation of Transcription Factor EB (TFEB) and TFEB dissociation from the 14-3-3 protein, thereby promoting the nuclear translocation of TFEB and the activation of lysosomal gene expression." .

<http://example.org/locx/sentence/42020342/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42020342/S7/position>,
        <http://example.org/locx/sentence/42020342/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42020342> .

<http://example.org/locx/sentence/42020342/S7/position> a oa:TextPositionSelector ;
    oa:end 1269 ;
    oa:start 1026 .

<http://example.org/locx/sentence/42020342/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This selective degradation activates the AMPK-ULK1-MAP1LC3/LC3 signaling cascade, initiating autophagy while facilitating MTOR-lysosome colocalization, thereby suppressing TFEB nuclear translocation and transcription of lysosome-related genes." .

<http://example.org/locx/sentence/42046264/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42046264/S10/position>,
        <http://example.org/locx/sentence/42046264/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42046264> .

<http://example.org/locx/sentence/42046264/S10/position> a oa:TextPositionSelector ;
    oa:end 1612 ;
    oa:start 1383 .

<http://example.org/locx/sentence/42046264/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, this synergy is driven by a dual impact on the AKT-mTOR-TFEB pathway: APO-Cyt C treatment decreased mTOR phosphorylation, while the combination promoted the nuclear translocation of the autophagy regulator, TFEB." .

<http://example.org/locx/sentence/42054558/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42054558/S6/position>,
        <http://example.org/locx/sentence/42054558/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42054558> .

<http://example.org/locx/sentence/42054558/S6/position> a oa:TextPositionSelector ;
    oa:end 905 ;
    oa:start 759 .

<http://example.org/locx/sentence/42054558/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Lipophagy and lipophagy-fueled fatty acid oxidation were induced by increased nuclear translocation and activity of the transcription factor TFEB." .

<http://example.org/locx/sentence/42099230/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42099230/S7/position>,
        <http://example.org/locx/sentence/42099230/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42099230> .

<http://example.org/locx/sentence/42099230/S7/position> a oa:TextPositionSelector ;
    oa:end 1133 ;
    oa:start 984 .

<http://example.org/locx/sentence/42099230/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "This inhibition triggered the nuclear accumulation of transcription factor EB (TFEB), a factor that regulates the expression of Bcl-2 family members." .

<http://example.org/locx/sentence/42104568/S14> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42104568/S14/position>,
        <http://example.org/locx/sentence/42104568/S14/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42104568> .

<http://example.org/locx/sentence/42104568/S14/position> a oa:TextPositionSelector ;
    oa:end 2553 ;
    oa:start 2169 .

<http://example.org/locx/sentence/42104568/S14/quote> a oa:TextQuoteSelector ;
    oa:exact "Transcriptome sequencing and Western blotting analysis demonstrated that PACS2 overexpression specifically activated the ERK-MAPK signalling pathway (55% increase in p-ERK, p < 0.01) without affecting p-P38 or p-JNK levels (p>0.05), which suppressed FAM134B-mediated ER-phagy (p < 0.05) and ameliorated muscle atrophy (p < 0.05) by inhibiting nuclear translocation of TFEB (p < 0.01)." .

<http://example.org/locx/sentence/42104568/S15> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42104568/S15/position>,
        <http://example.org/locx/sentence/42104568/S15/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42104568> .

<http://example.org/locx/sentence/42104568/S15/position> a oa:TextPositionSelector ;
    oa:end 2743 ;
    oa:start 2554 .

<http://example.org/locx/sentence/42104568/S15/quote> a oa:TextQuoteSelector ;
    oa:exact "Pharmacological ERK inhibition with SCH772984 abolished the protective effects of PACS2 by promoting TFEB nuclear translocation (p < 0.001) and TFEB-mediated FAM134B expression (p < 0.001)." .

<http://example.org/locx/sentence/42107477/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42107477/S12/position>,
        <http://example.org/locx/sentence/42107477/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42107477> .

<http://example.org/locx/sentence/42107477/S12/position> a oa:TextPositionSelector ;
    oa:end 1968 ;
    oa:start 1829 .

<http://example.org/locx/sentence/42107477/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, such protective effects were achieved by blocking TFEB nuclear translocation and preventing the downregulation of FAM134B." .

<http://example.org/locx/sentence/42117429/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42117429/S8/position>,
        <http://example.org/locx/sentence/42117429/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42117429> .

<http://example.org/locx/sentence/42117429/S8/position> a oa:TextPositionSelector ;
    oa:end 1204 ;
    oa:start 994 .

<http://example.org/locx/sentence/42117429/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Notably, TIM-3 blocked the interaction of mTOR-TFEB to inhibit TFEB phosphorylation and facilitate its nuclear translocation, followed by increased expression of lysosomal genes critical for myelin degradation." .

<http://example.org/locx/sentence/42117833/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42117833/S8/position>,
        <http://example.org/locx/sentence/42117833/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42117833> .

<http://example.org/locx/sentence/42117833/S8/position> a oa:TextPositionSelector ;
    oa:end 1161 ;
    oa:start 981 .

<http://example.org/locx/sentence/42117833/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "This restoration was also accompanied by the preservation of lysosomal membrane integrity and a consequent reduction in the nuclear translocation of transcription factor EB (TFEB)." .

<http://example.org/locx/sentence/42165414/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42165414/S6/position>,
        <http://example.org/locx/sentence/42165414/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42165414> .

<http://example.org/locx/sentence/42165414/S6/position> a oa:TextPositionSelector ;
    oa:end 1236 ;
    oa:start 917 .

<http://example.org/locx/sentence/42165414/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "This led to a dual suppression of TFEB: on the one hand, activated STAT3 directly bound to the TFEB promoter to inhibit its transcription; on the other hand, it facilitated the lysosomal recruitment of MTOR and activated MTORC1, which promoted TFEB phosphorylation (p-TFEB[S211]) and hindered its nuclear translocation." .

<http://example.org/locx/sentence/42172896/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42172896/S5/position>,
        <http://example.org/locx/sentence/42172896/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42172896> .

<http://example.org/locx/sentence/42172896/S5/position> a oa:TextPositionSelector ;
    oa:end 685 ;
    oa:start 477 .

<http://example.org/locx/sentence/42172896/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "PQLC2-deficient cells exhibited enhanced nuclear translocation of transcription factor EB (TFEB), a key regulator of lysosome, accompanied by increased expression of TFEB-lysosomal and autophagy target genes." .

<http://example.org/locx/sentence/42172896/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42172896/S6/position>,
        <http://example.org/locx/sentence/42172896/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42172896> .

<http://example.org/locx/sentence/42172896/S6/position> a oa:TextPositionSelector ;
    oa:end 888 ;
    oa:start 686 .

<http://example.org/locx/sentence/42172896/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In addition, genes related to mechanistic target of rapamycin complex 1 (mTORC1), a negative regulator of TFEB, were destabilized, leading to reduced lysosomal recruitment and impaired mTORC1 signaling." .

<http://example.org/locx/sentence/42188099/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42188099/S9/position>,
        <http://example.org/locx/sentence/42188099/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42188099> .

<http://example.org/locx/sentence/42188099/S9/position> a oa:TextPositionSelector ;
    oa:end 1613 ;
    oa:start 1394 .

<http://example.org/locx/sentence/42188099/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Elucidation of the mechanism showed that LSS downregulated the shear-responsive transcription factor KLF4, resulting in aberrant phosphorylation of transcription factor EB (TFEB) and impaired TFEB nuclear translocation." .

<http://example.org/locx/sentence/42218124/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42218124/S6/position>,
        <http://example.org/locx/sentence/42218124/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42218124> .

<http://example.org/locx/sentence/42218124/S6/position> a oa:TextPositionSelector ;
    oa:end 831 ;
    oa:start 667 .

<http://example.org/locx/sentence/42218124/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, CLN7 inhibition promoted nuclear translocation of TFEB by downregulating mTOR signaling, thereby enhancing lysosomal biogenesis and macroautophagy." .

<http://example.org/locx/sentence/42229171/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42229171/S3/position>,
        <http://example.org/locx/sentence/42229171/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42229171> .

<http://example.org/locx/sentence/42229171/S3/position> a oa:TextPositionSelector ;
    oa:end 318 ;
    oa:start 192 .

<http://example.org/locx/sentence/42229171/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "It becomes active upon nuclear translocation and induces the expression of genes involved in autophagy and lysosomal function." .

<http://example.org/locx/sentence/42229171/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42229171/S6/position>,
        <http://example.org/locx/sentence/42229171/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42229171> .

<http://example.org/locx/sentence/42229171/S6/position> a oa:TextPositionSelector ;
    oa:end 919 ;
    oa:start 758 .

<http://example.org/locx/sentence/42229171/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "In this study, we developed a high-content screening assay to quantify TFEB nuclear translocation in HeLa cells and screened a library of 560 approved compounds." .

<http://example.org/locx/sentence/42229171/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42229171/S7/position>,
        <http://example.org/locx/sentence/42229171/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42229171> .

<http://example.org/locx/sentence/42229171/S7/position> a oa:TextPositionSelector ;
    oa:end 1097 ;
    oa:start 920 .

<http://example.org/locx/sentence/42229171/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "We identified two compounds, NSC-319726 and ML-SA1, that promoted TFEB nuclear translocation without reducing p70S6K phosphorylation, supporting an mTORC1-independent mechanism." .

<http://example.org/locx/sentence/42274789/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42274789/S6/position>,
        <http://example.org/locx/sentence/42274789/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42274789> .

<http://example.org/locx/sentence/42274789/S6/position> a oa:TextPositionSelector ;
    oa:end 1704 ;
    oa:start 934 .

<http://example.org/locx/sentence/42274789/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "KEY FINDINGS: Niclosamide acts through six interconnected mechanisms: (1) mild reversible mitochondrial uncoupling, limiting ROS and cGAS-STING activation; (2) mTORC1 inhibition via lysosomal deacidification, with indirect IGF-1/IGF-1R modulation through AMPK activation; (3) restoration of autophagic flux and lysosomal biogenesis via TFEB nuclear translocation; (4) selective senolytic and senomorphic effects, suppressing NF-kappaB and STAT3 to neutralize the senescence-associated secretory phenotype (SASP) and reduce IL-6, IL-1beta, and TNF-alpha; (5) blockade of canonical Wnt/beta-catenin signaling to prevent tissue fibrosis; and (6) rebalancing of aged immune function by downregulating PD-1/PD-L1 and upregulating Vasorin to inhibit TGFbeta-mediated fibrosis." .

<http://example.org/locx/sentence/42285189/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42285189/S9/position>,
        <http://example.org/locx/sentence/42285189/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42285189> .

<http://example.org/locx/sentence/42285189/S9/position> a oa:TextPositionSelector ;
    oa:end 1510 ;
    oa:start 1313 .

<http://example.org/locx/sentence/42285189/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, BBR restored defective autophagic flux by promoting transcription factor EB (TFEB) nuclear translocation, thereby improving neutrophil homeostasis and reducing inflammatory damage." .

<http://example.org/locx/sentence/42423804/S11/position> a oa:TextPositionSelector ;
    oa:end 1480 ;
    oa:start 1298 .

<http://example.org/locx/sentence/42423804/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "The nuclear translocation of TFEB is demonstrated to rely on TNKS-mediated PARsylation, a post-translational modification that enhances its entry into the nucleus from the cytoplasm." .

<http://example.org/locx/sentence/42423804/S12> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42423804/S12/position>,
        <http://example.org/locx/sentence/42423804/S12/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42423804> .

<http://example.org/locx/sentence/42423804/S12/position> a oa:TextPositionSelector ;
    oa:end 1593 ;
    oa:start 1481 .

<http://example.org/locx/sentence/42423804/S12/quote> a oa:TextQuoteSelector ;
    oa:exact "Upon entering the nucleus, TFEB interacts with beta-catenin to initiate the transcriptional activation of ABCG2." .

<http://example.org/locx/sentence/42423804/S13> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42423804/S13/position>,
        <http://example.org/locx/sentence/42423804/S13/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42423804> .

<http://example.org/locx/sentence/42423804/S13/position> a oa:TextPositionSelector ;
    oa:end 1974 ;
    oa:start 1594 .

<http://example.org/locx/sentence/42423804/S13/quote> a oa:TextQuoteSelector ;
    oa:exact "The pharmacological inhibition of TNKS via the utilisation of XAV-939 interferes with the trafficking of TFEB that is dependent on PARsylation, leading to a reduction in ABCG2 expression and thus compromised cisplatin efflux capability of CR cells.The in vivo studies validated the reduction in tumour growth following TNKS blockade, either alone or in conjunction with cisplatin." .

<http://example.org/locx/sentence/42452976/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42452976/S8/position>,
        <http://example.org/locx/sentence/42452976/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42452976> .

<http://example.org/locx/sentence/42452976/S8/position> a oa:TextPositionSelector ;
    oa:end 1117 ;
    oa:start 984 .

<http://example.org/locx/sentence/42452976/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, ERK inhibition promotes the nuclear translocation of TFEB, which drives the upregulation of FAO and lipophagy genes." .

<http://example.org/locx/sentence/42467639/S6/position> a oa:TextPositionSelector ;
    oa:end 969 ;
    oa:start 836 .

<http://example.org/locx/sentence/42467639/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Levacetylleucine rapidly alters TFEB translocation between the cytoplasm and the nucleus in a biphasic, homeostasis-restoring manner." .

<http://example.org/locx/sentence/42467639/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42467639/S7/position>,
        <http://example.org/locx/sentence/42467639/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42467639> .

<http://example.org/locx/sentence/42467639/S7/position> a oa:TextPositionSelector ;
    oa:end 1062 ;
    oa:start 970 .

<http://example.org/locx/sentence/42467639/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "In wild-type HeLa cells, levacetylleucine promotes TFEB activation and nuclear localisation." .

<http://example.org/locx/sentence/42467639/S8/position> a oa:TextPositionSelector ;
    oa:end 1287 ;
    oa:start 1063 .

<http://example.org/locx/sentence/42467639/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "However, in NPC1 disease models, where we show that TFEB is over-activated and enriched in the nucleus due to lysosomal stress, levacetylleucine reduces nuclear TFEB and restores a more normal cytoplasmic-to-nuclear balance." .

<http://example.org/locx/sentence/42480904/S11> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42480904/S11/position>,
        <http://example.org/locx/sentence/42480904/S11/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42480904> .

<http://example.org/locx/sentence/42480904/S11/position> a oa:TextPositionSelector ;
    oa:end 1451 ;
    oa:start 1298 .

<http://example.org/locx/sentence/42480904/S11/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, NEN suppressed mTOR phosphorylation, promoted nuclear translocation of transcription factor EB (TFEB), and induced lysosomal biogenesis." .

<http://example.org/locx/sentence/42485708/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42485708/S7/position>,
        <http://example.org/locx/sentence/42485708/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42485708> .

<http://example.org/locx/sentence/42485708/S7/position> a oa:TextPositionSelector ;
    oa:end 967 ;
    oa:start 778 .

<http://example.org/locx/sentence/42485708/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "FSH suppressed the nuclear translocation of transcription factor EB (TFEB) through activation of the mTOR pathway, thereby reducing lysosomal biogenesis and autophagic degradation capacity." .

<http://example.org/locx/sentence/42488415/S2> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42488415/S2/position>,
        <http://example.org/locx/sentence/42488415/S2/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42488415> .

<http://example.org/locx/sentence/42488415/S2/position> a oa:TextPositionSelector ;
    oa:end 383 ;
    oa:start 74 .

<http://example.org/locx/sentence/42488415/S2/quote> a oa:TextQuoteSelector ;
    oa:exact "Recent evidence indicates that Coxsackievirus B3 (CVB3) infection, a common cause of viral myocarditis, triggers the nuclear translocation of transcription factor EB (TFEB) through a mechanism dependent on the serine/threonine phosphatase Protein Phosphatase 3 (PPP3)/calcineurin, independent of its cleavage." .

<http://example.org/locx/sentence/42488415/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42488415/S5/position>,
        <http://example.org/locx/sentence/42488415/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42488415> .

<http://example.org/locx/sentence/42488415/S5/position> a oa:TextPositionSelector ;
    oa:end 818 ;
    oa:start 693 .

<http://example.org/locx/sentence/42488415/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Our results demonstrate that TAC significantly suppresses both the nuclear accumulation and transcriptional activity of TFEB." .

<http://example.org/locx/sentence/42488415/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42488415/S6/position>,
        <http://example.org/locx/sentence/42488415/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42488415> .

<http://example.org/locx/sentence/42488415/S6/position> a oa:TextPositionSelector ;
    oa:end 1042 ;
    oa:start 819 .

<http://example.org/locx/sentence/42488415/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Conversely, knockdown of Protein Phosphatase 3 Catalytic Subunit (PPP3C) enhances TFEB protein expression and its nuclear localization, indicating that TAC calcineurin-dependent mechanism beyond simple enzymatic inhibition." .

<http://example.org/locx/sentence/42488415/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42488415/S7/position>,
        <http://example.org/locx/sentence/42488415/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42488415> .

<http://example.org/locx/sentence/42488415/S7/position> a oa:TextPositionSelector ;
    oa:end 1247 ;
    oa:start 1043 .

<http://example.org/locx/sentence/42488415/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, TAC similarly inhibits the nuclear expression and transcriptional activity of both Delta60-TFEB (a cleavage fragment lacking the first 60 amino acids) and TFEBQS60LP (cleavage-resistant mutant)." .

<http://example.org/locx/sentence/42488415/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42488415/S8/position>,
        <http://example.org/locx/sentence/42488415/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42488415> .

<http://example.org/locx/sentence/42488415/S8/position> a oa:TextPositionSelector ;
    oa:end 1416 ;
    oa:start 1248 .

<http://example.org/locx/sentence/42488415/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Knockdown of PPP3C leads to increased nuclear distribution of these TFEB variants, confirming that TAC targets PPP3/calcineurin to regulate TFEB and its modified forms." .

<http://example.org/locx/sentence/42504995/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42504995/S6/position>,
        <http://example.org/locx/sentence/42504995/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42504995> .

<http://example.org/locx/sentence/42504995/S6/position> a oa:TextPositionSelector ;
    oa:end 1039 ;
    oa:start 814 .

<http://example.org/locx/sentence/42504995/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, ANGPTL4 overexpression reduces TFEB nuclear localization, increases lysosomal pH, and decreases cathepsin B and lysosomal acid lipase activities, consistent with impaired terminal lysosomal lipid degradation." .

<http://example.org/locx/sentence/42524887/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42524887/S10/position>,
        <http://example.org/locx/sentence/42524887/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42524887> .

<http://example.org/locx/sentence/42524887/S10/position> a oa:TextPositionSelector ;
    oa:end 1476 ;
    oa:start 1276 .

<http://example.org/locx/sentence/42524887/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Interestingly, treatment of HGPS fibroblasts with Selinexor, an autophagy activator, elicited nuclear accumulation of TFEB and enhanced lysosomal biogenesis and function, thereby activating autophagy." .

<http://example.org/locx/sentence/42539927/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42539927/S8/position>,
        <http://example.org/locx/sentence/42539927/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42539927> .

<http://example.org/locx/sentence/42539927/S8/position> a oa:TextPositionSelector ;
    oa:end 1213 ;
    oa:start 964 .

<http://example.org/locx/sentence/42539927/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Recent work has shown that lysosome biogenesis begins with every acute bout of exercise, driven by the nuclear translocation of regulatory transcription factors such as TFEB and TFE3, which mediate the transcription of autophagy and lysosomal genes." .

<http://example.org/locx/sentence/42560776/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42560776/S7/position>,
        <http://example.org/locx/sentence/42560776/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42560776> .

<http://example.org/locx/sentence/42560776/S7/position> a oa:TextPositionSelector ;
    oa:end 925 ;
    oa:start 782 .

<http://example.org/locx/sentence/42560776/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Loss of hepatic Tsc1 led to increased phosphorylation of S6 and 4EBP1, with paradoxical increases in TFEB nuclear translocation and activation." .

<http://example.org/locx/sentence/42568500/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42568500/S6/position>,
        <http://example.org/locx/sentence/42568500/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42568500> .

<http://example.org/locx/sentence/42568500/S6/position> a oa:TextPositionSelector ;
    oa:end 1663 ;
    oa:start 992 .

<http://example.org/locx/sentence/42568500/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, flavonoids restore hepatic lipid homeostasis by concurrently inhibiting SREBP-1c-mediated de novo lipogenesis and promoting PPARalpha-driven fatty acid beta-oxidation via AMPK activation; ameliorate insulin resistance through IRS-1/PI3K/Akt signaling; attenuate hepatic inflammation by suppressing NF-kappaB/NLRP3 inflammasome cascades; reinforce antioxidant defenses via Nrf2/ARE-mediated induction of HO-1, SOD, and GPX4 with concomitant ferroptosis inhibition; enhance autophagic-lysosomal lipid clearance through TFEB nuclear translocation and Sirt1-dependent lipophagy; and remodel gut microbiota composition to fortify intestinal barrier integrity." .

<http://example.org/locx/sentence/42569319/S3> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42569319/S3/position>,
        <http://example.org/locx/sentence/42569319/S3/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42569319> .

<http://example.org/locx/sentence/42569319/S3/position> a oa:TextPositionSelector ;
    oa:end 479 ;
    oa:start 298 .

<http://example.org/locx/sentence/42569319/S3/quote> a oa:TextQuoteSelector ;
    oa:exact "Previous studies have shown constitutive nuclear localization of the transcription factor TFEB and simultaneous hyperactivation of canonical MTORC1 signaling in the absence of FLCN." .

<http://example.org/locx/sentence/42569319/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42569319/S5/position>,
        <http://example.org/locx/sentence/42569319/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42569319> .

<http://example.org/locx/sentence/42569319/S5/position> a oa:TextPositionSelector ;
    oa:end 851 ;
    oa:start 586 .

<http://example.org/locx/sentence/42569319/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Using an established BHD patient-derived kidney cancer cell line, we confirmed that TFEB was permanently localized in the nucleus combined with an increase in canonical MTORC1 signaling, whereas bulk autophagy flux and LC3 lipidation were unaffected by FLCN status." .

<http://example.org/locx/sentence/42605754/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42605754/S9/position>,
        <http://example.org/locx/sentence/42605754/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42605754> .

<http://example.org/locx/sentence/42605754/S9/position> a oa:TextPositionSelector ;
    oa:end 1549 ;
    oa:start 1396 .

<http://example.org/locx/sentence/42605754/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "CMA suppression was associated with increased autophagic flux, TFEB nuclear localization, and ULK1 phosphorylation changes consistent with MA activation." .

<http://example.org/locx/sentence/42640987/S10> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42640987/S10/position>,
        <http://example.org/locx/sentence/42640987/S10/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42640987> .

<http://example.org/locx/sentence/42640987/S10/position> a oa:TextPositionSelector ;
    oa:end 1297 ;
    oa:start 1141 .

<http://example.org/locx/sentence/42640987/S10/quote> a oa:TextQuoteSelector ;
    oa:exact "Concurrently, IP3R2 loss enhances ER-lysosome contacts, increases lysosomal Ca2+ levels via TMEM165, and activates TRPML1 and nuclear translocation of TFEB." .

<http://example.org/locx/sentence/42650306/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42650306/S9/position>,
        <http://example.org/locx/sentence/42650306/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42650306> .

<http://example.org/locx/sentence/42650306/S9/position> a oa:TextPositionSelector ;
    oa:end 1672 ;
    oa:start 1479 .

<http://example.org/locx/sentence/42650306/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "Lutein attenuated lipid droplet accumulation in FFA-treated cells, increased nuclear TFEB immunoreactivity, upregulated LC3 mRNA expression, and enhanced LC3 colocalization with lipid droplets." .

<http://example.org/locx/sentence/42757653/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42757653/S7/position>,
        <http://example.org/locx/sentence/42757653/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42757653> .

<http://example.org/locx/sentence/42757653/S7/position> a oa:TextPositionSelector ;
    oa:end 1152 ;
    oa:start 969 .

<http://example.org/locx/sentence/42757653/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Mechanistically, crystal-induced lysosomal stress triggers Ca2+ efflux, which activates the calcineurin pathway to drive TFEB nuclear translocation and subsequent FABP1 transcription." .

<http://example.org/locx/sentence/42759760/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42759760/S4/position>,
        <http://example.org/locx/sentence/42759760/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42759760> .

<http://example.org/locx/sentence/42759760/S4/position> a oa:TextPositionSelector ;
    oa:end 853 ;
    oa:start 533 .

<http://example.org/locx/sentence/42759760/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Transcription factor EB (TFEB), a master transcriptional regulator of the ALP, undergoes stress-responsive nuclear translocation under chemotherapeutic conditions through mechanistic target of rapamycin complex 1 (mTORC1) inhibition, lysosomal Ca2+-calcineurin-mediated dephosphorylation, and related signaling cascades." .

<http://example.org/locx/sentence/42759760/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42759760/S5/position>,
        <http://example.org/locx/sentence/42759760/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42759760> .

<http://example.org/locx/sentence/42759760/S5/position> a oa:TextPositionSelector ;
    oa:end 1026 ;
    oa:start 854 .

<http://example.org/locx/sentence/42759760/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Nuclear TFEB activates the canonical coordinated lysosomal expression and regulation (CLEAR) network while also engaging broader context-dependent transcriptional programs." .

<http://example.org/locx/sentence/42772563/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42772563/S6/position>,
        <http://example.org/locx/sentence/42772563/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42772563> .

<http://example.org/locx/sentence/42772563/S6/position> a oa:TextPositionSelector ;
    oa:end 1078 ;
    oa:start 878 .

<http://example.org/locx/sentence/42772563/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "ML1-KD reduced lysosomal acidification and impaired autophagic flux and was accompanied by reduced TFEB nuclear localization, impaired mitophagy, and alterations in mitochondrial maintenance proteins." .

<http://example.org/locx/sentence/42816627/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42816627/S6/position>,
        <http://example.org/locx/sentence/42816627/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42816627> .

<http://example.org/locx/sentence/42816627/S6/position> a oa:TextPositionSelector ;
    oa:end 934 ;
    oa:start 805 .

<http://example.org/locx/sentence/42816627/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "This enables TBK1/ULK1-mediated FNIP1 phosphorylation at S296, resulting in inhibition of FLCN and nuclear translocation of TFEB." .

<http://example.org/locx/sentence/42822936/S9> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42822936/S9/position>,
        <http://example.org/locx/sentence/42822936/S9/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42822936> .

<http://example.org/locx/sentence/42822936/S9/position> a oa:TextPositionSelector ;
    oa:end 1474 ;
    oa:start 1218 .

<http://example.org/locx/sentence/42822936/S9/quote> a oa:TextQuoteSelector ;
    oa:exact "APTF treatment uniquely and simultaneously normalized both pathways: it inhibited mTORC1 to promote TFEB nuclear translocation and lysosomal restoration, and suppressed mTORC2 to enhance FOXO1 activity and RAB7 expression, thereby rescuing autophagic flux." .

<http://example.org/locx/sentence/42854287/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42854287/S4/position>,
        <http://example.org/locx/sentence/42854287/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42854287> .

<http://example.org/locx/sentence/42854287/S4/position> a oa:TextPositionSelector ;
    oa:end 656 ;
    oa:start 409 .

<http://example.org/locx/sentence/42854287/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Through transcriptomic analysis, molecular docking, molecular dynamics (MD) simulations, and an SH-SY5Y cell hypoxia model, we observed that TFEB expression was upregulated and nuclear translocation was induced during the initial phase of hypoxia." .

<http://example.org/locx/sentence/42899420/S4/position> a oa:TextPositionSelector ;
    oa:end 551 ;
    oa:start 366 .

<http://example.org/locx/sentence/42899420/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Transcription factor EB (TFEB), a master regulator of lysosomal biogenesis, is regulated by stimulus-dependent nuclear-cytoplasmic shuttling through a variety of phosphorylation events." .

<http://example.org/locx/sentence/42899420/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42899420/S5/position>,
        <http://example.org/locx/sentence/42899420/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42899420> .

<http://example.org/locx/sentence/42899420/S5/position> a oa:TextPositionSelector ;
    oa:end 757 ;
    oa:start 552 .

<http://example.org/locx/sentence/42899420/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Here, we find that elevating intracellular cAMP with forskolin and IBMX induces rapid nuclear import of TFEB-GFP within 30 minutes and coincides with a transient upregulation of TFEB target lysosome genes." .

<http://example.org/locx/sentence/42899420/S6> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42899420/S6/position>,
        <http://example.org/locx/sentence/42899420/S6/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42899420> .

<http://example.org/locx/sentence/42899420/S6/position> a oa:TextPositionSelector ;
    oa:end 847 ;
    oa:start 758 .

<http://example.org/locx/sentence/42899420/S6/quote> a oa:TextQuoteSelector ;
    oa:exact "By 8 hours, TFEB returns to the cytoplasm, accompanied by transcriptional downregulation." .

<http://example.org/locx/sentence/42899420/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42899420/S7/position>,
        <http://example.org/locx/sentence/42899420/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42899420> .

<http://example.org/locx/sentence/42899420/S7/position> a oa:TextPositionSelector ;
    oa:end 1044 ;
    oa:start 848 .

<http://example.org/locx/sentence/42899420/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Inhibition of cAMP-dependent protein kinase A (PKA) using H89 did not block nuclear import but unexpectedly caused sustained nuclear accumulation, indicating that PKA promotes TFEB nuclear export." .

<http://example.org/locx/sentence/42907440/S8> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/42907440/S8/position>,
        <http://example.org/locx/sentence/42907440/S8/quote> ;
    oa:hasSource <http://example.org/locx/abstract/42907440> .

<http://example.org/locx/sentence/42907440/S8/position> a oa:TextPositionSelector ;
    oa:end 1407 ;
    oa:start 1243 .

<http://example.org/locx/sentence/42907440/S8/quote> a oa:TextQuoteSelector ;
    oa:exact "Inhibition of mTORC1 promoted the nuclear translocation of transcription factor EB (TFEB), restoring lysosomal function and autophagic flux impaired by D-galactose." .

<http://example.org/locx/sentence/43001585/S4> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/43001585/S4/position>,
        <http://example.org/locx/sentence/43001585/S4/quote> ;
    oa:hasSource <http://example.org/locx/abstract/43001585> .

<http://example.org/locx/sentence/43001585/S4/position> a oa:TextPositionSelector ;
    oa:end 602 ;
    oa:start 452 .

<http://example.org/locx/sentence/43001585/S4/quote> a oa:TextQuoteSelector ;
    oa:exact "Using various senescence inducers, we show that senescence induction triggers robust TFEB nuclear translocation and upregulation of TFEB target genes." .

<http://example.org/locx/sentence/43001585/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/43001585/S5/position>,
        <http://example.org/locx/sentence/43001585/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/43001585> .

<http://example.org/locx/sentence/43001585/S5/position> a oa:TextPositionSelector ;
    oa:end 779 ;
    oa:start 603 .

<http://example.org/locx/sentence/43001585/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "In contrast, inhibition of the core CASM machinery by CRISPR-mediated deletion of either ATG16L1, ATG12, or ATG5 markedly reduced senescence-induced TFEB nuclear translocation." .

<http://example.org/locx/sentence/43001585/S7> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/43001585/S7/position>,
        <http://example.org/locx/sentence/43001585/S7/quote> ;
    oa:hasSource <http://example.org/locx/abstract/43001585> .

<http://example.org/locx/sentence/43001585/S7/position> a oa:TextPositionSelector ;
    oa:end 1121 ;
    oa:start 955 .

<http://example.org/locx/sentence/43001585/S7/quote> a oa:TextQuoteSelector ;
    oa:exact "Moreover, expression of the Salmonella effector protein SopF, a previously described specific CASM inhibitor, similarly blocked senescence-induced TFEB translocation." .

<http://example.org/locx/sentence/43003867/S5> a oa:SpecificResource ;
    oa:hasSelector <http://example.org/locx/sentence/43003867/S5/position>,
        <http://example.org/locx/sentence/43003867/S5/quote> ;
    oa:hasSource <http://example.org/locx/abstract/43003867> .

<http://example.org/locx/sentence/43003867/S5/position> a oa:TextPositionSelector ;
    oa:end 973 ;
    oa:start 650 .

<http://example.org/locx/sentence/43003867/S5/quote> a oa:TextQuoteSelector ;
    oa:exact "Hesperetin enhanced TFEB nuclear translocation and transcriptional activity, thereby restoring autophagic clearance of APAP-protein adducts and mitochondrial biogenesis, as well as SQSTM1/p62-dependent noncanonical NFE2-like bZIP transcription factor 2 (NFE2L2/NRF2) activation to protect against APAP-induced liver injury." .

