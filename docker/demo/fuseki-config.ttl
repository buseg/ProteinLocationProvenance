# Fuseki 6.2.0 config for the Docker demo: the same dataset as on the server, but read-only.
# Endpoints: /locx/sparql, /locx/query (SPARQL), /locx/get (Graph Store Protocol read). No update or upload.
PREFIX :        <#>
PREFIX fuseki:  <http://jena.apache.org/fuseki#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tdb2:    <http://jena.apache.org/2016/tdb#>

[] rdf:type fuseki:Server ;
    fuseki:services ( :service_locx ) .

:service_locx rdf:type fuseki:Service ;
    rdfs:label                    "locx (TDB2, read-only demo)" ;
    fuseki:name                   "locx" ;
    fuseki:serviceQuery           "sparql" ;
    fuseki:serviceQuery           "query" ;
    fuseki:serviceReadGraphStore  "get" ;
    fuseki:dataset                :tdb_locx .

:tdb_locx rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/locx" .
