# syntax=docker/dockerfile:1.7
# Apache Jena Fuseki 6.2.0 on Java 21 (same version as on the server), read-only locx dataset.
FROM eclipse-temurin:21-jre

ARG FUSEKI_VERSION=6.2.0
# sha256 of the official release tarball (the server's copy was verified against Apache's sha512)
ADD --checksum=sha256:e3b8b033872cd2f24091603bec1e7eb21cc3e1def5b9572658c48143e86b977f \
    https://archive.apache.org/dist/jena/binaries/apache-jena-fuseki-${FUSEKI_VERSION}.tar.gz /tmp/fuseki.tar.gz

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
 && tar xzf /tmp/fuseki.tar.gz -C /opt && mv /opt/apache-jena-fuseki-${FUSEKI_VERSION} /opt/fuseki && rm /tmp/fuseki.tar.gz \
 && useradd --system --create-home --home-dir /fuseki fuseki \
 && mkdir -p /fuseki/databases /fuseki/run && chown -R fuseki:fuseki /fuseki

COPY --chmod=755 docker/demo/fuseki-entrypoint.sh /fuseki/entrypoint.sh
COPY docker/demo/shiro.ini.template /fuseki/shiro.ini.template
COPY docker/demo/fuseki-config.ttl /fuseki/config.ttl

USER fuseki
ENV JVM_ARGS=-Xmx4g
EXPOSE 3030
ENTRYPOINT ["/fuseki/entrypoint.sh"]
